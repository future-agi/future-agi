#!/usr/bin/env bash
# ============================================================================
# Future AGI — self-hosted installer
#
#   ./bin/install                      # Standalone (default), interactive:
#                                      # app + postgres + clickhouse on one
#                                      # machine (docker-compose.yml)
#   ./bin/install --distributed        # Distributed: one container per
#                                      # service, scaled independently
#                                      # (docker-compose.distributed.yml)
#   ./bin/install --from-source        # build the images from this checkout
#                                      # instead of pulling them. Needed for
#                                      # a dev branch: published images are
#                                      # built from main
#   ./bin/install --force              # continue past failed preflight checks
#   ./bin/install --skip-user-creation # don't prompt for first user
#   ./bin/install --no-up              # bootstrap .env only; don't start
#   ./bin/install --wipe-volumes       # wipe stale project volumes and
#                                      # re-init with fresh secrets
#   ./bin/install --new-instance       # if existing volumes are detected,
#                                      # spin up an isolated copy as
#                                      # `futureagi-2`, `futureagi-3`, …
#                                      # without touching the originals
#   ./bin/install -y                   # non-interactive (CI / unattended).
#                                      # Reads FAGI_ADMIN_EMAIL,
#                                      # FAGI_ADMIN_NAME, FAGI_ADMIN_PASSWORD
#                                      # from env if you want a user created.
#   ./bin/install --no-telemetry       # turn deployment telemetry off
#                                      # (FUTURE_AGI_TELEMETRY_DISABLED=true
#                                      # in .env; docs/telemetry.md)
#
# Idempotent: a fresh install gets generated secrets in .env; re-running
# never changes an existing value and merges any new vars from .env.example.
# --distributed is recorded in .env (COMPOSE_FILE), so later runs and a plain
# `docker compose` stay on the distributed stack. An existing install keeps its
# stack: moving one between standalone and distributed is refused, because its data
# does not carry over. A timestamped log is written to install-*.log.
# ============================================================================

set -eEuo pipefail

# ---------------- output helpers ----------------
if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GREEN=$'\033[32m'
  YELLOW=$'\033[33m'; BLUE=$'\033[34m'; RESET=$'\033[0m'
else
  BOLD=""; DIM=""; RED=""; GREEN=""; YELLOW=""; BLUE=""; RESET=""
fi
# Helpers write to terminal AND to fd 3 (install log, opened below). Avoids
# globally tee'ing stdout — that breaks TTY detection for `docker compose`.
say()   { printf "%s\n" "$*"; printf "%s\n" "$*" >&3; }
step()  { printf "\n${BOLD}${BLUE}==>${RESET} ${BOLD}%s${RESET}\n" "$*"; printf "\n==> %s\n" "$*" >&3; }
ok()    { printf "  ${GREEN}✓${RESET} %s\n" "$*"; printf "  [ok]   %s\n" "$*" >&3; }
warn()  { printf "  ${YELLOW}!${RESET} %s\n" "$*" >&2; printf "  [warn] %s\n" "$*" >&3; }
die()   { printf "\n${RED}✗ %s${RESET}\n" "$*" >&2; printf "\n[fail] %s\n" "$*" >&3; exit 1; }
log_only() { printf "%s\n" "$*" >&3; }

on_err() {
  local code=$? line=${1:-?}
  printf "\n${RED}✗ install failed (exit %d, line %s)${RESET}\n" "$code" "$line" >&2
  printf "${DIM}  Re-run with: ./bin/install. Logs: docker compose logs${RESET}\n" >&2
  exit "$code"
}
trap 'on_err $LINENO' ERR

# ---------------- log file (gitignored as /install-*.log) ----------------
# Opened before arg parsing so helpers (esp. die) can append from any point.
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_FILE="$ROOT/install-$(date +%Y%m%d-%H%M%S).log"
exec 3>>"$LOG_FILE"
printf "# Future AGI install log — %s\n# host: %s, uname: %s\n\n" \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname 2>/dev/null || echo ?)" "$(uname -a)" >&3

# ---------------- args ----------------
DISTRIBUTED=0
FROM_SOURCE=0
FORCE=0
SKIP_USER=${SKIP_USER_CREATION:-0}
NO_UP=0
NON_INTERACTIVE=0
WIPE_VOLUMES_FLAG=0
NEW_INSTANCE_FLAG=0
NO_TELEMETRY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --distributed|--full) DISTRIBUTED=1 ;;
    --from-source) FROM_SOURCE=1 ;;
    --force) FORCE=1 ;;
    --skip-user-creation) SKIP_USER=1 ;;
    --no-up) NO_UP=1 ;;
    --wipe-volumes) WIPE_VOLUMES_FLAG=1 ;;
    --new-instance) NEW_INSTANCE_FLAG=1 ;;
    --no-telemetry) NO_TELEMETRY=1 ;;
    -y|--non-interactive) NON_INTERACTIVE=1 ;;
    -h|--help)
      sed -n '2,/^# =\{20,\}$/p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) die "unknown flag: $1 (try --help)" ;;
  esac
  shift
done

if (( WIPE_VOLUMES_FLAG == 1 && NEW_INSTANCE_FLAG == 1 )); then
  die "--wipe-volumes and --new-instance are mutually exclusive"
fi

# CI / non-TTY runs always behave as non-interactive.
[[ -n "${CI:-}" || ! -t 0 ]] && NON_INTERACTIVE=1

cd "$ROOT"

# ---------------- welcome banner ----------------
if [[ -t 1 ]]; then
  printf "\n"
  printf "${BOLD}${BLUE}  ╭───────────────────────────────────────────╮${RESET}\n"
  printf "${BOLD}${BLUE}  │${RESET}   ${BOLD}Future AGI${RESET} ${DIM}·${RESET} ${DIM}self-hosted installer${RESET}      ${BOLD}${BLUE}│${RESET}\n"
  printf "${BOLD}${BLUE}  ╰───────────────────────────────────────────╯${RESET}\n"
  if [[ "$DISTRIBUTED" -eq 1 ]] || grep -Eqs '^COMPOSE_FILE=.*docker-compose\.distributed\.yml' .env; then
    printf "  ${DIM}mode: Distributed · one container per service${RESET}\n"
  else
    printf "  ${DIM}mode: Standalone · pass --distributed for one container per service${RESET}\n"
  fi
  printf "\n"
fi

# ---------------- preflight ----------------
step "Preflight"

if command -v docker >/dev/null 2>&1; then
  if ! docker info >/dev/null 2>&1; then
    die "Docker is installed but the daemon isn't running. Start Docker Desktop / dockerd and re-run."
  fi
  ok "Docker daemon reachable"
else
  die "docker not found in PATH. Install Docker first: https://docs.docker.com/get-docker/"
fi

# Pick docker compose flavor (plugin v2 preferred; fall back to standalone v1).
if docker compose version >/dev/null 2>&1; then
  DC="docker compose"
elif command -v docker-compose >/dev/null 2>&1; then
  DC="docker-compose"
  warn "Using legacy docker-compose v1. Consider upgrading to Compose v2 (built into Docker Desktop)."
else
  die "Neither 'docker compose' nor 'docker-compose' is available."
fi
ok "Compose: $($DC version --short 2>/dev/null || echo unknown)"

# A failed preflight check stops the install unless --force was given.
preflight_fail() {
  if (( FORCE == 1 )); then
    warn "$* (continuing: --force)"
  else
    die "$* (re-run with --force to continue anyway)"
  fi
}

# ---------------- .env ----------------
step "Configuring .env"

if [[ ! -f .env.example ]]; then
  die ".env.example missing — are you running this from the repo root?"
fi

if [[ ! -f .env ]]; then
  (umask 077; cp .env.example .env)
  ok "Created .env from .env.example"
else
  # Merge any new keys added to .env.example since the user's last install,
  # without overwriting existing values. awk pattern from Coolify install.sh.
  before=$(wc -l <.env | tr -d ' ')
  # Keep secrets private during merging and after atomic replacement. mktemp
  # also avoids following a pre-existing .env.tmp symlink.
  env_tmp=$(mktemp .env.tmp.XXXXXX)
  if ! awk -F= 'NR==FNR{seen[$1]=1; print; next} !($1 in seen) && /^[A-Z]/ {print}' \
    .env .env.example > "$env_tmp"; then
    rm -f -- "$env_tmp"
    die "Could not merge .env.example; existing .env preserved"
  fi
  mv -- "$env_tmp" .env
  after=$(wc -l <.env | tr -d ' ')
  if [[ "$after" -gt "$before" ]]; then
    ok ".env exists — added $((after - before)) new key(s) from .env.example"
  else
    ok ".env already exists (existing values preserved)"
  fi
fi

# Portable in-place sed (BSD on mac, GNU on linux).
sed_inplace() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    sed -i '' "$@"
  else
    sed -i "$@"
  fi
}

# Value of var in .env, or the default when unset/empty.
env_value() {
  local var="$1" default="$2"
  local v
  v=$(grep -E "^${var}=" .env | tail -1 | cut -d= -f2- || true)
  printf '%s' "${v:-$default}"
}

# Set var=value in .env (replace if present, append otherwise).
set_env_var() {
  local var="$1" val="$2"
  if grep -Eq "^${var}=" .env; then
    sed_inplace -E "s|^${var}=.*|${var}=${val}|" .env
  else
    printf "%s=%s\n" "$var" "$val" >> .env
  fi
}

gen_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import secrets; print(secrets.token_hex(32))'
  else
    LC_ALL=C tr -dc 'a-f0-9' </dev/urandom | head -c 64
    echo
  fi
}

# Fernet key (32 random bytes, URL-safe base64) for INTEGRATION_ENCRYPTION_KEY.
gen_fernet_key() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 32 | tr '+/' '-_'
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
  else
    head -c 32 /dev/urandom | base64 | tr '+/' '-_'
  fi
}

# ---------------- telemetry and unsafe settings ----------------
# Written before anything starts, so the first account's registration is
# already the minimal opt-out one.
if (( NO_TELEMETRY == 1 )); then
  set_env_var FUTURE_AGI_TELEMETRY_DISABLED true
  ok "FUTURE_AGI_TELEMETRY_DISABLED=true written to .env: telemetry is off"
fi
# .env files made from an older .env.example turned this on.
if [[ "$(env_value OSS_RETURN_PASSWORD_RESET_LINK "" | tr '[:upper:]' '[:lower:]')" == true ]]; then
  warn "OSS_RETURN_PASSWORD_RESET_LINK=true hands password-reset links to anyone who can reach the API, so anyone can take over any account. Delete it from .env unless every user of this host is trusted (INSTALLATION.md › Reset a password)."
fi

telemetry_is_off() {
  local value="${FUTURE_AGI_TELEMETRY_DISABLED:-$(env_value FUTURE_AGI_TELEMETRY_DISABLED "")}"
  [[ "$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')" =~ ^(1|true|yes|on)$ ]]
}

# What deployment telemetry sends, before any account (and so any admin
# email) exists. Worded as docs/telemetry.md.
telemetry_notice() {
  local url host hours
  url=$(env_value FUTURE_AGI_TELEMETRY_URL https://api.futureagi.com)
  host="${url#*://}"
  host="${host%%/*}"
  hours=$(env_value FUTURE_AGI_TELEMETRY_INTERVAL_HOURS 6)
  step "Telemetry"
  if telemetry_is_off; then
    ok "Off (FUTURE_AGI_TELEMETRY_DISABLED=true). One minimal registration still goes to ${host}: instance id, version, deployment type, timestamp."
  else
    say "  When the first account is created, this install registers with ${host}:"
    say "  instance id, version, deployment type, and the emails and domains of owners,"
    say "  admins and staff/superuser accounts. Then it"
    say "  sends usage counts every ${hours} h; never traces, prompts or other content."
    say "  Opt out: --no-telemetry, or FUTURE_AGI_TELEMETRY_DISABLED=true in .env. One minimal"
    say "  registration remains: instance id, version, deployment type, timestamp."
  fi
  say "  ${DIM}Details: docs/telemetry.md${RESET}"
}

# Find the next free project name in the futureagi-N family by checking
# for existing volumes. Used when --new-instance is requested.
next_free_project_name() {
  local base="futureagi" n=2
  while docker volume ls --format '{{.Name}}' 2>/dev/null \
         | grep -q "^${base}-${n}_"; do
    n=$((n + 1))
  done
  echo "${base}-${n}"
}

# Set / replace COMPOSE_PROJECT_NAME in .env. Compose reads this and it
# overrides the `name:` in the compose file, so volumes / containers /
# networks become ${name}_*, ${name}-N, ${name}_default.
set_project_name_in_env() {
  local name="$1"
  if grep -Eq '^COMPOSE_PROJECT_NAME=' .env; then
    sed_inplace -E "s|^COMPOSE_PROJECT_NAME=.*|COMPOSE_PROJECT_NAME=${name}|" .env
  else
    printf "\nCOMPOSE_PROJECT_NAME=%s\n" "$name" >> .env
  fi
}

# ---------------- this project's existing state ----------------
# Compose names volumes <project>_<volume> and labels containers with their
# project and service, so both show whether this project already holds an
# install, and of which stack.
project_name=$(grep -E '^COMPOSE_PROJECT_NAME=' .env | tail -1 | cut -d= -f2- || true)
project_name="${project_name:-futureagi}"
declare -a PERSISTENT_VOLUME_SUFFIXES=(
  app-data
  postgres-data
  clickhouse-data
  minio-data
  redis-data
  rabbitmq-data
  peerdb-catalog-data
  peerdb-minio-data
  property-catalog-kafka-data
  fi-collector-data
)
# Volumes and services only the distributed stack has. rabbitmq-data and a rabbitmq
# container come from releases before Redis carried live updates.
declare -a DISTRIBUTED_ONLY_VOLUME_SUFFIXES=(
  minio-data
  redis-data
  rabbitmq-data
  peerdb-catalog-data
  peerdb-minio-data
  property-catalog-kafka-data
  fi-collector-data
)
declare -a DISTRIBUTED_ONLY_SERVICES=(
  backend worker frontend minio redis rabbitmq temporal fi-collector
  agentcc-gateway peerdb-server
)
declare -a STALE_VOLS=()
for vol in "${PERSISTENT_VOLUME_SUFFIXES[@]}"; do
  if docker volume inspect "${project_name}_${vol}" >/dev/null 2>&1; then
    STALE_VOLS+=("${project_name}_${vol}")
  fi
done

# Stale-volume guard. Postgres and object storage keep the password they
# were first started with in their volumes. CHANGEME-* placeholders in .env
# next to existing volumes mean .env no longer holds those passwords, and the
# stack will fail to come up with cryptic auth errors. Detect and ask.
WIPE_VOLS=0
if (( WIPE_VOLUMES_FLAG == 1 && ${#STALE_VOLS[@]} > 0 )); then
  WIPE_VOLS=1
elif (( ${#STALE_VOLS[@]} > 0 )) && grep -Eq "^(PG_PASSWORD|MINIO_ROOT_PASSWORD)=CHANGEME-" .env; then
  warn "Detected ${#STALE_VOLS[@]} existing project volume(s) — likely from a prior install:"
  for v in "${STALE_VOLS[@]}"; do say "    • $v"; done
  say ""
  say "  These volumes hold data initialized with other passwords than the"
  say "  CHANGEME-* placeholders in .env, so the stack cannot authenticate"
  say "  against them until .env holds the original passwords."
  say ""
  if (( NEW_INSTANCE_FLAG == 1 )); then
    project_name="$(next_free_project_name)"
    set_project_name_in_env "$project_name"
    STALE_VOLS=()
    ok "Spinning up an isolated instance: ${BOLD}${project_name}${RESET}"
    say "  ${DIM}volumes / containers / network will all be prefixed with ${project_name}.${RESET}"
  elif [[ "$NON_INTERACTIVE" -eq 1 ]]; then
    warn "  Non-interactive mode: leaving .env as it is."
    warn "  Re-run with --wipe-volumes (deletes data) or --new-instance"
    warn "  (creates an isolated copy) — or set passwords in .env to match"
    warn "  what the existing volumes were initialized with."
  else
    say "  Choose:"
    say "    [n] ${BOLD}new instance${RESET} — spin up an isolated copy alongside this one"
    say "        ${DIM}(volumes will be ${project_name}-2_*, ${project_name}-3_*, …)${RESET}"
    say "    [w] ${BOLD}wipe${RESET} the volumes and start fresh ${RED}(deletes all data)${RESET}"
    say "    [k] ${BOLD}keep${RESET} the volumes — .env stays as it is, and you set its"
    say "        ${DIM}passwords to match the existing data manually${RESET}"
    say "    [a] ${BOLD}abort${RESET}"
    while true; do
      printf "  ${BOLD}> ${RESET}"
      read -r choice || choice="a"
      case "$choice" in
        n|N)
          project_name="$(next_free_project_name)"
          set_project_name_in_env "$project_name"
          STALE_VOLS=()
          ok "Spinning up an isolated instance: ${BOLD}${project_name}${RESET}"
          say "  ${DIM}volumes / containers / network will all be prefixed with ${project_name}.${RESET}"
          break ;;
        w|W) WIPE_VOLS=1; break ;;
        k|K) break ;;
        a|A|"") die "Aborted by user." ;;
        *) warn "Choose n / w / k / a" ;;
      esac
    done
  fi
fi

# ---------------- mode ----------------
# The standalone install is docker-compose.yml. The distributed stack is recorded as
# COMPOSE_FILE=docker-compose.distributed.yml in .env, which Compose reads by itself,
# so re-runs and a plain `docker compose up -d` stay on it. An existing
# install never changes stack: the two keep workflows, stored files and the
# Postgres → ClickHouse sync in different places, so its data would not carry
# over. A refused switch leaves .env unchanged.
DISTRIBUTED_REQUESTED=$DISTRIBUTED
DISTRIBUTED_DETECTED=0
compose_file_setting=$(env_value COMPOSE_FILE "")

# COMPOSE_FILE with its docker-compose.yml entry swapped for
# docker-compose.distributed.yml, other entries (overrides) kept. Prints nothing
# when the setting lists no docker-compose.yml.
swap_to_full_compose() {
  local entry out="" found=0 IFS=':'
  for entry in $1; do
    if [[ "${entry##*/}" == docker-compose.yml ]]; then
      entry="${entry%docker-compose.yml}docker-compose.distributed.yml"
      found=1
    fi
    out+="${out:+:}${entry}"
  done
  if (( found == 1 )); then printf '%s' "$out"; fi
}

# Services of this project's containers, running or not.
PROJECT_SERVICES=$(docker ps -a --filter "label=com.docker.compose.project=${project_name}" \
  --format '{{.Label "com.docker.compose.service"}}' 2>/dev/null | sort -u || true)
project_has_service() { grep -qx -- "$1" <<<"$PROJECT_SERVICES"; }

# What marks this project as a distributed install, if anything does.
full_signal=""
for vol in "${DISTRIBUTED_ONLY_VOLUME_SUFFIXES[@]}"; do
  if docker volume inspect "${project_name}_${vol}" >/dev/null 2>&1; then
    full_signal="volume ${project_name}_${vol}"
    break
  fi
done
if [[ -z "$full_signal" ]]; then
  for svc in "${DISTRIBUTED_ONLY_SERVICES[@]}"; do
    if project_has_service "$svc"; then
      full_signal="its ${svc} container"
      break
    fi
  done
fi
default_app_container=0
if project_has_service app; then default_app_container=1; fi
default_app_volume=0
if docker volume inspect "${project_name}_app-data" >/dev/null 2>&1; then default_app_volume=1; fi

if (( DISTRIBUTED == 0 )) && [[ "$compose_file_setting" == *docker-compose.distributed.yml* ]]; then
  DISTRIBUTED=1
elif (( DISTRIBUTED == 0 )) && [[ -n "$full_signal" ]]; then
  # Installs made before the default became the single-app stack ran the
  # distributed stack from docker-compose.yml. Keep them there.
  DISTRIBUTED=1
  DISTRIBUTED_DETECTED=1
fi

refuse_default_to_full() {
  local hint=""
  if (( DISTRIBUTED_REQUESTED == 0 )); then
    hint=" If you did not ask for the distributed stack, delete the COMPOSE_FILE line from .env and re-run ./bin/install."
  fi
  die "Project ${project_name} already holds a standalone install. Moving an existing install to the distributed stack is not supported: its data would not carry over. Back up first (INSTALLATION.md › Backups), then run ./bin/uninstall --wipe-data and ./bin/install --distributed. To run the distributed stack next to this install, use a second checkout with another COMPOSE_PROJECT_NAME.${hint}"
}

# COMPOSE_FILE for the distributed stack is written by record_mode: at once for an
# existing distributed install, otherwise only once the preflight checks pass, so
# a refused --distributed leaves .env as it was.
new_compose_setting=""
record_mode() {
  if [[ -n "$new_compose_setting" ]]; then
    set_env_var COMPOSE_FILE "$new_compose_setting"
    new_compose_setting=""
  fi
}
full_setting=""
if (( DISTRIBUTED == 1 )); then
  full_setting="$compose_file_setting"
  if [[ -z "$compose_file_setting" ]]; then
    full_setting=docker-compose.distributed.yml
    # An explicit COMPOSE_FILE switches off Compose's automatic loading of
    # docker-compose.override.yml, so carry an existing override along.
    if [[ -f docker-compose.override.yml ]]; then full_setting+=":docker-compose.override.yml"; fi
    new_compose_setting="$full_setting"
  elif [[ "$compose_file_setting" != *docker-compose.distributed.yml* ]]; then
    full_setting=$(swap_to_full_compose "$compose_file_setting")
    if [[ -z "$full_setting" ]]; then
      die "COMPOSE_FILE=${compose_file_setting} in .env lists no docker-compose.yml, so the installer cannot point it at the distributed stack. Add docker-compose.distributed.yml to it yourself, then re-run ./bin/install."
    fi
    new_compose_setting="$full_setting"
  fi
fi

# A wipe removes this project's containers and volumes first, so there is
# nothing left to strand.
if (( DISTRIBUTED == 1 && WIPE_VOLS == 0 )); then
  if (( default_app_container == 1 )) && [[ -n "$full_signal" ]]; then
    # The data is a distributed install's: keep plain `docker compose` on it.
    record_mode
    die "Project ${project_name} holds a distributed install (${full_signal}) and also a Standalone app container. That happens when a plain \`docker compose up -d\` starts the new docker-compose.yml against an older distributed install. Your data is in the distributed stack's volumes, and .env now records COMPOSE_FILE=${full_setting}. Remove the stray container, then re-run ./bin/install: docker compose -f docker-compose.yml -p ${project_name} rm -sf app"
  elif (( default_app_container == 1 || default_app_volume == 1 )) && [[ -z "$full_signal" ]]; then
    refuse_default_to_full
  fi
fi

if (( DISTRIBUTED == 1 )); then
  COMPOSE_PATH=docker-compose.distributed.yml
  APP_SVC=backend
  # An existing distributed install is recorded at once, so that a plain
  # `docker compose up -d` can no longer start the default file against it.
  if [[ -n "$full_signal" ]]; then record_mode; fi
  if (( DISTRIBUTED_DETECTED == 1 )); then
    warn "Existing distributed install detected (${full_signal}); staying on the distributed stack."
    warn "  Recorded COMPOSE_FILE=${full_setting} in .env, so plain \`docker compose\` commands use it too."
    warn "  Moving an existing install to the standalone stack is not supported: see INSTALLATION.md › Switching between Standalone and Distributed."
    if (( WIPE_VOLS == 1 )); then
      warn "  --wipe-volumes resets it as a distributed stack. For the standalone install instead, stop here, run ./bin/uninstall --wipe-data, delete the COMPOSE_FILE line from .env and run ./bin/install."
    fi
  fi
  if (( default_app_volume == 1 && WIPE_VOLS == 0 )); then
    warn "Volume ${project_name}_app-data belongs to a standalone install; the distributed stack does not use it."
  fi
  ok "Mode: Distributed (COMPOSE_FILE=${full_setting})"
else
  COMPOSE_PATH=docker-compose.yml
  APP_SVC=app
  if [[ -n "$compose_file_setting" ]]; then
    ok "Mode: Standalone, with COMPOSE_FILE=${compose_file_setting} from .env"
  else
    ok "Mode: Standalone (docker-compose.yml) — pass --distributed for one container per service"
  fi
fi
[[ -f "$COMPOSE_PATH" ]] || die "$COMPOSE_PATH missing — are you running this from a complete checkout?"

if (( WIPE_VOLS == 1 )); then
  step "Wiping existing volumes"
  # The flag or interactive confirmation is the deletion boundary. Stop only
  # this Compose project (--remove-orphans also takes the other stack's
  # containers), then remove the exact inventoried volumes rather than using
  # a broad `down -v` target.
  if ! $DC down --remove-orphans; then
    die "Could not stop the existing Compose project before the requested volume wipe."
  fi
  docker volume rm "${STALE_VOLS[@]}" 2>&1 | sed 's|^|  |'
  ok "Volumes removed. Fresh secrets will work on first boot."
elif (( WIPE_VOLUMES_FLAG == 1 )); then
  ok "No existing project volumes found; nothing to wipe"
fi

# ---------------- secrets ----------------
# A fresh install (no volumes of this project) gets its own secrets instead
# of the defaults published in the compose files. An existing install keeps
# every value it has: Postgres stores its password in its volume, and a new
# SECRET_KEY or gateway key would sign everyone out. Only empty or CHANGEME-*
# keys are filled, and only on a fresh install. Two keys hold no state and
# are filled on any install: without INTEGRATION_ENCRYPTION_KEY every process
# starts with a random key of its own, so nothing encrypted before survives a
# restart anyway, and the standalone install's Redis keeps nothing across
# restarts (the distributed stack's Redis takes no password).
FRESH_INSTALL=1
if (( ${#STALE_VOLS[@]} > 0 && WIPE_VOLS == 0 )); then FRESH_INSTALL=0; fi

secret_is_unset() {
  local value
  value=$(env_value "$1" "")
  [[ -z "$value" || "$value" == CHANGEME-* ]]
}
fill_secret() { # var, generator
  if secret_is_unset "$1"; then
    set_env_var "$1" "$($2)"
    ok "Generated $1"
  fi
}

declare -a INSTALL_SECRETS=(
  SECRET_KEY
  PG_PASSWORD
  MINIO_ROOT_PASSWORD
  AGENTCC_INTERNAL_API_KEY
  AGENTCC_ADMIN_TOKEN
)
if (( FRESH_INSTALL == 1 )); then
  for var in "${INSTALL_SECRETS[@]}"; do
    fill_secret "$var" gen_secret
  done
  # S3_SECRET_KEY must match MINIO_ROOT_PASSWORD (S3 client speaks to MinIO).
  if grep -Eq "^S3_SECRET_KEY=CHANGEME-" .env; then
    minio_pwd=$(env_value MINIO_ROOT_PASSWORD "")
    sed_inplace -E "s|^S3_SECRET_KEY=CHANGEME-.*|S3_SECRET_KEY=${minio_pwd}|" .env
    ok "Aligned S3_SECRET_KEY with MINIO_ROOT_PASSWORD"
  fi
else
  declare -a PUBLISHED_DEFAULTS=()
  for var in "${INSTALL_SECRETS[@]}"; do
    if secret_is_unset "$var"; then PUBLISHED_DEFAULTS+=("$var"); fi
  done
  if (( ${#PUBLISHED_DEFAULTS[@]} > 0 )); then
    warn "Existing install: ${PUBLISHED_DEFAULTS[*]} still use the defaults published in this repository."
    warn "  The installer never changes an existing install's secrets. See INSTALLATION.md › Secrets that must be changed."
  fi
fi
fill_secret INTEGRATION_ENCRYPTION_KEY gen_fernet_key
if (( DISTRIBUTED == 0 )); then fill_secret REDIS_PASSWORD gen_secret; fi

# ---------------- sandbox profile ----------------
# With COMPOSE_PROFILES=sandbox the app sends code evals to the nsjail
# executor. It reads the setting from .env inside the container, so a value
# given only in the shell starts the executor but leaves evals in the app.
if (( DISTRIBUTED == 0 )); then
  shell_profiles=",${COMPOSE_PROFILES:-},"
  env_profiles=",$(env_value COMPOSE_PROFILES ""),"
  if [[ "${shell_profiles// /}" == *,sandbox,* && "${env_profiles// /}" != *,sandbox,* ]]; then
    warn "COMPOSE_PROFILES=sandbox is set in your shell but not in .env. Add it to .env: the app reads it there to send code evals to the nsjail executor."
  fi
fi

# ---------------- port preflight ----------------
# Catch host-port collisions BEFORE the slow docker compose up. Without
# this, compose retries 3× on what's actually a structural conflict.
# Runs before the --no-up exit so port overrides land in .env even when
# you're only bootstrapping.
step "Checking host ports"

port_holder() {
  # lsof / ss exit non-zero when nothing's bound. Disable both errexit and
  # ERR-trap inheritance just for this function so a clean "nothing's
  # listening" doesn't get reported as an install failure.
  set +eE
  local port="$1" out=""
  if command -v lsof >/dev/null 2>&1; then
    out=$(lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null)
    [[ -n "$out" ]] && awk 'NR>1 {printf "%s (pid %s)\n", $1, $2; exit}' <<<"$out"
  elif command -v ss >/dev/null 2>&1; then
    out=$(ss -ltn 2>/dev/null)
    [[ -n "$out" ]] && awk -v p=":$port\$" '$4 ~ p {print $0; exit}' <<<"$out"
  fi
  set -eE
  return 0
}

# Find the first free TCP port starting from $1, skipping any we've already
# suggested in this same run (so two conflicting services can't both be
# offered the same alternative). Result is written to FREE_PORT (a global
# variable) so updates to SUGGESTED_PORTS persist — `$(find_free_port ...)`
# would run in a subshell, hiding the array mutation from the next call.
declare -a SUGGESTED_PORTS=()
FREE_PORT=""
find_free_port() {
  local p="$1"
  FREE_PORT=""
  while (( p < 65535 )); do
    if [[ -z "$(port_holder "$p" 2>/dev/null)" ]]; then
      local seen=0 s
      # ${arr[@]+"${arr[@]}"} survives `set -u` on an empty array.
      for s in ${SUGGESTED_PORTS[@]+"${SUGGESTED_PORTS[@]}"}; do
        [[ "$s" == "$p" ]] && seen=1 && break
      done
      if (( seen == 0 )); then
        SUGGESTED_PORTS+=("$p")
        FREE_PORT="$p"
        return 0
      fi
    fi
    p=$((p + 1))
  done
  return 1
}

# All host-bound ports of the chosen stack. Data-store ports bind 127.0.0.1
# in compose, but they still collide with anything else on that interface
# (other docker stacks, SSH tunnels, host services). The standalone install
# publishes no Postgres, ClickHouse, Redis or Temporal port.
if (( DISTRIBUTED == 1 )); then
  declare -a PORTS_TO_CHECK=(
    "FRONTEND_PORT:3000"
    "BACKEND_PORT:8000"
    "AGENTCC_GATEWAY_PORT:8090"
    "SERVING_PORT:8080"
    "CODE_EXECUTOR_PORT:8060"
    "PG_PORT:5432"
    "CH_HTTP_PORT:8123"
    "CH_PORT:9000"
    "REDIS_PORT:6379"
    "MINIO_API_PORT:9005"
    "MINIO_CONSOLE_PORT:9006"
    "TEMPORAL_PORT:7233"
    "PROPERTY_CATALOG_KAFKA_PORT:29092"
    "FI_COLLECTOR_OTLP_PORT:4317"
    "FI_COLLECTOR_OTLP_HTTP_PORT:4318"
    "FI_COLLECTOR_ADMIN_PORT:9464"
    "PEERDB_PORT:9900"
  )
  # UIs that only run under a COMPOSE_PROFILES entry.
  profiles=",$(env_value COMPOSE_PROFILES ""),"
  [[ "$profiles" == *,all,* || "$profiles" == *,full,* || "$profiles" == *,peerdb,* ]] && PORTS_TO_CHECK+=("PEERDB_UI_PORT:3001")
  [[ "$profiles" == *,all,* || "$profiles" == *,full,* || "$profiles" == *,observability,* ]] && PORTS_TO_CHECK+=("TEMPORAL_UI_PORT:8085")
else
  declare -a PORTS_TO_CHECK=(
    "FRONTEND_PORT:3000"
    "BACKEND_PORT:8000"
    "FI_COLLECTOR_OTLP_PORT:4317"
    "FI_COLLECTOR_OTLP_HTTP_PORT:4318"
    "AGENTCC_GATEWAY_PORT:8090"
    "MINIO_API_PORT:9005"
  )
fi

declare -a UNRESOLVED=()
for entry in "${PORTS_TO_CHECK[@]}"; do
  var="${entry%%:*}"
  default="${entry##*:}"
  port=$(env_value "$var" "$default")
  holder=$(port_holder "$port" 2>/dev/null) || holder=""

  if [[ -z "$holder" ]]; then
    ok "  $var=$port  free"
    continue
  fi

  # Allow our own already-running container to "hold" the port — re-runs
  # of bin/install on the same project are fine. Anything else collides.
  # Ask Docker rather than trusting the holder's process name: Colima
  # forwards published ports through `ssh`, not docker-proxy.
  if docker ps --format '{{.Names}}\t{{.Ports}}' 2>/dev/null \
       | awk -v p=":$port->" -v proj="^${project_name}-" \
            '$0 ~ p && $1 ~ proj' \
       | grep -q .; then
    ok "  $var=$port  (held by this project's container — fine)"
    continue
  fi

  # Find a suggested replacement.
  suggestion=""
  find_free_port $((port + 1)) && suggestion="$FREE_PORT" || true
  if [[ -z "$suggestion" ]]; then
    warn "  $var=$port  is taken by $holder  (no free port found above)"
    UNRESOLVED+=("$var=$port  ←  $holder")
    continue
  fi

  warn "  $var=$port  is taken by $holder"

  # Offer to switch. Auto-accept in non-interactive mode (CI / -y) so the
  # script can keep going unattended.
  apply=0
  if [[ "$NON_INTERACTIVE" -eq 1 ]]; then
    apply=1
    say "      ${DIM}→ auto-switching to $var=$suggestion${RESET}"
  else
    printf "      ${DIM}→ use ${BOLD}$var=$suggestion${RESET}${DIM} instead? [Y/n] ${RESET}"
    read -r answer || answer=""
    case "$answer" in
      ""|y|Y|yes|YES) apply=1 ;;
      *) apply=0 ;;
    esac
  fi

  if (( apply == 1 )); then
    set_env_var "$var" "$suggestion"
    ok "  $var=$suggestion  written to .env"
    # Keep VITE_HOST_API in sync when BACKEND_PORT moves: the UI calls the
    # API there, http://localhost:8000 when it is unset. A URL naming another
    # host is the user's own and stays.
    if [[ "$var" == "BACKEND_PORT" ]]; then
      host_api=$(env_value VITE_HOST_API "")
      if [[ -z "$host_api" || "$host_api" =~ ^https?://localhost:[0-9]+/?$ ]]; then
        set_env_var VITE_HOST_API "http://localhost:${suggestion}"
        ok "  VITE_HOST_API=http://localhost:${suggestion}  (kept in sync)"
      fi
    fi
  else
    UNRESOLVED+=("$var=$port  ←  $holder")
  fi
done

if (( ${#UNRESOLVED[@]} > 0 )); then
  say ""
  say "  ${BOLD}${YELLOW}Unresolved port conflicts:${RESET}"
  for c in "${UNRESOLVED[@]}"; do say "    • $c"; done
  say ""
  say "  Free the port (stop the process / container) or set the var in .env"
  say "  to a free port, then re-run ${BOLD}./bin/install${RESET}."
  exit 1
fi

if [[ "$NO_UP" -eq 1 ]]; then
  record_mode
  telemetry_notice
  step "Done (--no-up)"
  (( FROM_SOURCE == 1 )) && warn "--from-source builds nothing with --no-up; re-run without --no-up to build."
  say "  .env is ready. Bring up the stack with:"
  say "    ${BOLD}$DC up -d${RESET}"
  exit 0
fi

# ---------------- Docker VM preflight ----------------
# Measured from inside a throwaway container: on macOS and Windows, Docker
# runs in a VM (Docker Desktop, Colima, OrbStack) and the stack gets the VM's
# memory, not the host's. Colima's default VM has 2 GB.
step "Checking the Docker VM"

PROBE_IMAGE=busybox:1.37
if (( DISTRIBUTED == 1 )); then
  need_mb=5600; want_mb=11500; want_cpu=4; need_gb=6; want_gb=12; mode_label="The distributed stack"
else
  need_mb=2800; want_mb=3584; want_cpu=2; need_gb=3; want_gb=4; mode_label="The standalone install"
fi
# A VM reports a little less than its configured size (kernel reserve), so
# the thresholds sit just under a 3 / 4 GB (default) and 6 / 12 GB (distributed) VM.

vm_resize_hint() { # cpus gb
  local runtime
  runtime="$(docker context show 2>/dev/null || true) $(docker info --format '{{.OperatingSystem}}' 2>/dev/null || true)"
  case "$runtime" in
    *colima*) printf 'colima stop && colima start --cpu %s --memory %s' "$1" "$2" ;;
    *"Docker Desktop"*) printf 'Docker Desktop → Settings → Resources: %s CPUs, %s GB memory' "$1" "$2" ;;
    *OrbStack*) printf 'orb config set memory_mib %s' "$(( $2 * 1024 ))" ;;
    *) printf 'give Docker at least %s CPUs and %s GB of memory' "$1" "$2" ;;
  esac
}

VM_MEM_MB=""; VM_CPUS=""; VM_ARCH=""
vm_probe=$(docker run --rm "$PROBE_IMAGE" sh -c 'free -m; echo nproc $(nproc); echo arch $(uname -m)' 2>/dev/null || true)
if [[ -n "$vm_probe" ]]; then
  VM_MEM_MB=$(awk '/^Mem:/ {print $2; exit}' <<<"$vm_probe")
  VM_CPUS=$(awk '/^nproc / {print $2; exit}' <<<"$vm_probe")
  VM_ARCH=$(awk '/^arch / {print $2; exit}' <<<"$vm_probe")
  vm_probe_ran=1
else
  vm_probe_ran=0
  warn "Could not run a $PROBE_IMAGE probe container (offline?); skipping the memory, CPU and path checks"
fi

case "$VM_ARCH" in
  x86_64|amd64) VM_ARCH=amd64 ;;
  aarch64|arm64) VM_ARCH=arm64 ;;
  "") ;;
  *) preflight_fail "Docker runs on ${VM_ARCH}; Future AGI runs on amd64 and arm64 only" ;;
esac

if (( vm_probe_ran == 1 )); then
  if [[ ! "$VM_MEM_MB" =~ ^[0-9]+$ ]]; then
    warn "Could not read the Docker VM's memory; skipping the memory check"
  elif (( VM_MEM_MB < need_mb )); then
    too_small="Docker has ${VM_MEM_MB} MB of memory. ${mode_label} needs at least ${need_gb} GB (${want_gb} GB recommended). Fix: $(vm_resize_hint "$want_cpu" "$want_gb")"
    if (( DISTRIBUTED == 1 && FRESH_INSTALL == 0 )); then
      # Never block an upgrade of an install that already runs here.
      warn "${too_small}. Continuing, since this project already holds a distributed install; expect containers to be killed for lack of memory."
    else
      alt=""
      if (( DISTRIBUTED_REQUESTED == 1 )); then
        alt=", or run the standalone install (./bin/install without --distributed), which needs 3 GB"
      elif (( DISTRIBUTED == 1 )); then
        alt=", or install the standalone stack instead: delete the COMPOSE_FILE line from .env and re-run ./bin/install"
      fi
      preflight_fail "${too_small}${alt}"
    fi
  elif (( VM_MEM_MB < want_mb )); then
    warn "Docker has ${VM_MEM_MB} MB of memory; ${want_gb} GB is recommended. $(vm_resize_hint "$want_cpu" "$want_gb")"
  else
    ok "Docker VM: ${VM_MEM_MB} MB memory, ${VM_CPUS:-?} CPU(s), ${VM_ARCH:-unknown arch}"
  fi
  if [[ "$VM_CPUS" =~ ^[0-9]+$ ]] && (( VM_CPUS < want_cpu )); then
    warn "Docker has ${VM_CPUS} CPU(s); ${want_cpu}+ recommended. $(vm_resize_hint "$want_cpu" "$want_gb")"
  fi
  # The frontend build alone can take up to 8 GB of Node heap.
  if (( FROM_SOURCE == 1 )) && [[ "$VM_MEM_MB" =~ ^[0-9]+$ ]] && (( VM_MEM_MB < 7600 )); then
    warn "Building from source wants an 8 GB Docker VM (the frontend build is memory-hungry); ${VM_MEM_MB} MB may run out."
  fi

  # Bind mounts come from this checkout. VM runtimes share only some host
  # paths (Colima: \$HOME; Docker Desktop: its file-sharing list); anything
  # else mounts as an EMPTY directory, without an error.
  if docker run --rm -v "$ROOT:/probe:ro" "$PROBE_IMAGE" test -f /probe/.env.example >/dev/null 2>&1; then
    ok "Checkout is visible to Docker"
  else
    preflight_fail "Docker cannot see $ROOT, so the stack's bind mounts would be empty. Move the checkout under \$HOME, or share the path with the Docker VM (Colima: colima start --mount $ROOT; Docker Desktop: Settings → Resources → File sharing)"
  fi
fi

# Every preflight check passed, so --distributed can be recorded now.
record_mode

# ---------------- collect first-user creds ----------------
# Done up-front so the rest of the install can run unattended. Captured
# values are used after the backend reports healthy. Press Enter on the
# email prompt to skip; --skip-user-creation / CI=1 skip without asking.
# The telemetry notice comes first: the first account's email is part of
# the registration.
telemetry_notice

readonly ACCOUNT_SKIPPED="skipped"
readonly ACCOUNT_CREATED="created"
readonly ACCOUNT_EXISTS="exists"
readonly ACCOUNT_FAILED="failed"
readonly GATE_CONTAINERS="containers to start"

USER_EMAIL=""
USER_NAME=""
USER_PASS=""
ACCOUNT_STATE="$ACCOUNT_SKIPPED"

# Terminal input carries raw bytes, so a stray escape sequence (Shift+Tab emits
# ESC [ Z) travels into create_user and the sign-in banner.
EMAIL_PATTERN="^[A-Za-z0-9.!#\$%&'*+/=?^_\`{|}~-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+\$"

strip_control_chars() { printf '%s' "${1//[[:cntrl:]]/}"; }

prompt_user() {
  step "Create your first account"
  say "  ${DIM}You can press Enter on email to skip and create the user later via${RESET}"
  say "  ${DIM}'$DC exec ${APP_SVC} python manage.py create_user'.${RESET}"
  say ""

  while true; do
    printf "  ${BOLD}Email${RESET}    : "; read -r USER_EMAIL || USER_EMAIL=""
    USER_EMAIL=$(strip_control_chars "$USER_EMAIL")
    if [[ -z "$USER_EMAIL" ]]; then
      say "  ${DIM}skipped — no user will be created${RESET}"
      return
    fi
    if [[ "$USER_EMAIL" =~ $EMAIL_PATTERN ]]; then
      break
    fi
    warn "  '$USER_EMAIL' doesn't look like an email address — try again"
  done

  while [[ -z "$USER_NAME" ]]; do
    printf "  ${BOLD}Name${RESET}     : "; read -r USER_NAME
    USER_NAME=$(strip_control_chars "$USER_NAME")
    [[ -z "$USER_NAME" ]] && warn "  name can't be empty"
  done

  while true; do
    printf "  ${BOLD}Password${RESET} : "; read -rs USER_PASS; echo
    if [[ ${#USER_PASS} -lt 8 ]]; then
      warn "  password must be at least 8 characters"
      USER_PASS=""
      continue
    fi
    printf "  ${BOLD}Confirm${RESET}  : "; read -rs confirm; echo
    if [[ "$USER_PASS" != "$confirm" ]]; then
      warn "  passwords don't match — try again"
      USER_PASS=""
      continue
    fi
    break
  done
  ok "Captured. Account will be created once the backend is healthy."
}

if [[ "$SKIP_USER" -eq 1 ]]; then
  : # no prompt
elif [[ "$NON_INTERACTIVE" -eq 1 ]]; then
  # Use FAGI_ADMIN_* if all three are set; otherwise skip silently.
  if [[ -n "${FAGI_ADMIN_EMAIL:-}" && -n "${FAGI_ADMIN_NAME:-}" && -n "${FAGI_ADMIN_PASSWORD:-}" ]]; then
    USER_EMAIL=$(strip_control_chars "$FAGI_ADMIN_EMAIL")
    USER_NAME=$(strip_control_chars "$FAGI_ADMIN_NAME")
    USER_PASS="$FAGI_ADMIN_PASSWORD"
    step "Using FAGI_ADMIN_* from environment for first-user creation"
  else
    step "Non-interactive: skipping first-user creation"
    say "  ${DIM}Set FAGI_ADMIN_EMAIL, FAGI_ADMIN_NAME, FAGI_ADMIN_PASSWORD to auto-create.${RESET}"
  fi
else
  prompt_user
fi

# ---------------- build from source (--from-source) ----------------
# Published images are built from main, so a checkout of another branch
# needs its own: build each Future AGI image from this checkout, tag it
# `local`, and point the stack at that tag. The standalone install's app image
# is assembled from the other four.
build_image() { # tag, then `docker build` arguments
  local tag="$1"
  shift
  say "  ${DIM}building ${tag}${RESET}"
  log_only "running: docker build -t $tag $*"
  docker build -t "$tag" "$@" || die "Building $tag failed; the build output above has the reason."
  ok "Built $tag"
}
if (( FROM_SOURCE == 1 )); then
  step "Building images from this checkout"
  # Standalone's app image is assembled on the slim backend variant, as the
  # published futureagi/platform is; Distributed runs the default one.
  backend_variant=()
  if (( DISTRIBUTED == 0 )); then
    backend_variant=(--build-arg IMAGE_VARIANT=slim)
  fi
  build_image futureagi/future-agi:local -f futureagi/Dockerfile.oss \
    ${backend_variant[@]+"${backend_variant[@]}"} futureagi
  build_image futureagi/frontend:local frontend
  build_image futureagi/fi-collector:local fi-collector
  build_image futureagi/agentcc-gateway:local agentcc-gateway
  if (( DISTRIBUTED == 0 )); then
    build_image futureagi/platform:local -f deploy/platform/Dockerfile \
      --build-arg BACKEND_IMAGE=futureagi/future-agi:local \
      --build-arg FRONTEND_IMAGE=futureagi/frontend:local \
      --build-arg FI_COLLECTOR_IMAGE=futureagi/fi-collector:local \
      --build-arg AGENTCC_GATEWAY_IMAGE=futureagi/agentcc-gateway:local \
      deploy/platform
  fi
  set_env_var FUTURE_AGI_VERSION local
  if (( DISTRIBUTED == 1 )); then
    # The distributed stack tags these images separately.
    set_env_var FRONTEND_VERSION local
    set_env_var AGENTCC_GATEWAY_VERSION local
    set_env_var FI_COLLECTOR_VERSION local
  fi
  ok "FUTURE_AGI_VERSION=local written to .env"
fi

# ---------------- pull images ----------------
step "Pulling images"

# service<TAB>image for every service in the resolved compose file.
compose_service_images() {
  $DC config 2>/dev/null | awk '
    /^services:/ { in_services = 1; next }
    /^[^ ]/ { in_services = 0 }
    in_services && /^  [^ ]/ { service = $1; sub(/:$/, "", service) }
    in_services && /^    image: / { image = $2; gsub(/"/, "", image); print service "\t" image }
  '
}
SERVICE_IMAGES=$(compose_service_images || true)
app_image=$(awk -F'\t' -v s="$APP_SVC" '$1 == s {print $2; exit}' <<<"$SERVICE_IMAGES")

# Images tagged `local` are built from this checkout (--from-source, or the
# distributed stack's fi-collector) and are never pulled. The distributed stack also skips
# anything it builds itself; the standalone install pulls every other image, so
# a failed pull can never turn into a surprise source build.
declare -a pull_command=(pull)
if (( DISTRIBUTED == 1 )) && $DC pull --help 2>&1 | grep -q -- '--ignore-buildable'; then
  pull_command+=(--ignore-buildable)
fi
declare -a pull_services=()
while IFS=$'\t' read -r service image; do
  [[ -z "$service" ]] && continue
  if [[ "$image" != *:local ]]; then
    pull_services+=("$service")
  elif [[ "$image" != futureagi/fi-collector:local ]] && ! docker image inspect "$image" >/dev/null 2>&1; then
    # fi-collector:local has a build: section in the distributed stack; anything
    # else tagged `local` exists only after --from-source.
    preflight_fail "$image is not built yet. Re-run with --from-source to build it from this checkout, or set its tag in .env (FUTURE_AGI_VERSION) back to a published release"
  fi
done <<<"$SERVICE_IMAGES"

if [[ "$(env_value FUTURE_AGI_VERSION "")" == local ]] && (( FROM_SOURCE == 0 )); then
  say "  ${DIM}FUTURE_AGI_VERSION=local: using the images last built by --from-source${RESET}"
fi
if (( ${#pull_services[@]} == 0 )); then
  warn "Could not list the stack's images; docker compose up will pull any that are missing"
else
  log_only "running: $DC ${pull_command[*]} ${pull_services[*]}"
  if $DC "${pull_command[@]}" "${pull_services[@]}"; then
    :
  else
    log_only "[fail] pull returned $?"
    # A release that predates an image (futureagi/platform, say) has no tag
    # for it on Docker Hub. Building from the checkout still works.
    if [[ -n "$app_image" && "$app_image" != *:local ]] && \
       ! docker manifest inspect "$app_image" >/dev/null 2>&1; then
      from_source_cmd="./bin/install --from-source"
      if (( DISTRIBUTED_REQUESTED == 1 )); then from_source_cmd+=" --distributed"; fi
      die "docker compose pull failed: Docker Hub has no $app_image (not published for this release, or Docker Hub is unreachable). Build the images from this checkout instead: $from_source_cmd"
    fi
    die "docker compose pull failed; the output above names the image. Check the network, Docker Hub's pull rate limit and disk space (docker system df), then try again."
  fi
  log_only "[ok]   pull complete"
  ok "Images pulled"
fi

# Published images may not match the Docker VM's CPU; Docker then emulates
# them, which is much slower (first boot can take 20+ minutes).
if [[ -n "$app_image" && -n "$VM_ARCH" ]]; then
  image_arch=$(docker image inspect --format '{{.Architecture}}' "$app_image" 2>/dev/null || true)
  if [[ -n "$image_arch" && "$image_arch" != "$VM_ARCH" ]]; then
    warn "$app_image is built for $image_arch but Docker runs on $VM_ARCH, so it runs under emulation."
    warn "  Expect a slower stack and a first boot of 20+ minutes. ./bin/install --from-source builds native images."
  fi
fi

# ---------------- bring up ----------------
step "Starting the stack"

if (( DISTRIBUTED == 1 )); then
  # --build forces a rebuild of any service with `build:` set, so a stale
  # image tag from a previous worktree (or an outdated layer) doesn't carry
  # old source into a new install. Docker's layer cache makes this fast
  # when nothing has actually changed.
  # One attempt, as in bin/e2e: replaying compose up can rerun an exited schema
  # or mirror job after an uncertain write. Inspect retained state before resuming.
  # Preserve services omitted by an upgrade; legacy retirement is an explicit step.
  if ! $DC up -d --build --wait --wait-timeout 1200; then
    die "docker compose startup failed or timed out; partial state retained, no automatic retry. Inspect 'docker compose ps -a' and 'docker compose logs' before explicitly resuming."
  fi
else
  # No --wait: the app's first boot runs the migrations, and the readiness
  # loop below reports their progress and fails fast on a crash loop.
  if ! $DC up -d; then
    die "docker compose up failed; partial state retained. Inspect 'docker compose ps -a' and 'docker compose logs app'."
  fi
fi
ok "Containers started"

# Services an upgrade dropped keep running until removed (`up` runs without
# --remove-orphans on purpose). RabbitMQ left the distributed stack when Redis took
# over live updates.
if (( DISTRIBUTED == 1 )) && project_has_service rabbitmq; then
  warn "RabbitMQ is no longer part of the distributed stack (Redis carries live updates), but its container is still here."
  warn "  Once the stack is healthy, remove it with: $DC up -d --remove-orphans"
  warn "  Its data volume stays until you delete it: docker volume rm ${project_name}_rabbitmq-data"
fi

# ---------------- readiness wait ----------------
if (( DISTRIBUTED == 1 )); then
  step "Waiting for the application and property catalog to become ready"
else
  step "Waiting for the application to become ready"
fi

bounded_env_int() {
  local var="$1" default="$2" min="$3" max="$4" value
  value=$(grep -E "^${var}=" .env | tail -1 | cut -d= -f2- || true)
  value="${value:-$default}"
  if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < min || value > max )); then
    die "$var must be an integer in [$min,$max] (got '$value')"
  fi
  BOUNDED_ENV_INT="$value"
}

compose_service_snapshot() {
  local service="$1" container_id snapshot
  container_id=$($DC ps -a -q "$service" 2>/dev/null | head -1 || true)
  if [[ -z "$container_id" ]]; then
    printf 'missing|missing|-1|0|none|never'
    return 0
  fi
  snapshot=$(docker inspect --format \
    '{{.State.Status}}|{{.State.ExitCode}}|{{.RestartCount}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|{{.State.StartedAt}}' \
    "$container_id" 2>/dev/null || true)
  if [[ -z "$snapshot" ]]; then
    printf '%s|missing|-1|0|none|never' "$container_id"
  else
    printf '%s|%s' "$container_id" "$snapshot"
  fi
}

count_applied_migrations() {
  $DC logs --tail 2000 "$APP_SVC" 2>/dev/null | grep -ac 'Applying ' || true
}

save_readiness_diagnostics() {
  $DC ps -a >&3 2>&1 || true
  if (( DISTRIBUTED == 1 )); then
    $DC logs --tail 80 property-catalog-kafka property-catalog-kafka-volume-init \
      property-catalog-runtime-volume-init property-catalog-topic-init \
      property-catalog-clickhouse-bootstrap \
      fi-collector fi-property-catalog-consumer \
      backend \
      >&3 2>&1 || true
  else
    $DC logs --tail 200 app postgres clickhouse >&3 2>&1 || true
  fi
}

bounded_env_int INSTALL_READY_TIMEOUT_SECONDS 600 60 1800
ready_timeout="$BOUNDED_ENV_INT"
bounded_env_int INSTALL_STABILITY_SECONDS 15 5 120
stability_seconds="$BOUNDED_ENV_INT"
bounded_env_int INSTALL_READY_MAX_SECONDS 2400 300 7200
ready_max="$BOUNDED_ENV_INT"

# Source .env for BACKEND_PORT / FRONTEND_PORT so we hit the right host ports.
backend_port=$(env_value BACKEND_PORT 8000)
frontend_port=$(env_value FRONTEND_PORT 3000)
deadline=$(( $(date +%s) + ready_timeout ))
hard_deadline=$(( $(date +%s) + ready_max ))
ready_since=0
last_ready_signature=""
last_migrations_applied=$(count_applied_migrations)
pending_gate="$GATE_CONTAINERS"
first_app_restarts=""
declare -a catalog_jobs=(
  property-catalog-kafka-volume-init
  property-catalog-runtime-volume-init
  property-catalog-topic-init
  property-catalog-clickhouse-bootstrap
)
declare -a catalog_services=(
  fi-collector
  fi-property-catalog-consumer
)

while true; do
  now=$(date +%s)
  all_ready=1
  fatal_reason=""
  ready_signature=""
  pending_gate=""

  if (( DISTRIBUTED == 1 )); then
    for service in "${catalog_jobs[@]}"; do
      snapshot=$(compose_service_snapshot "$service")
      IFS='|' read -r container_id status exit_code restart_count health started_at <<<"$snapshot"
      if [[ "$status" == "exited" && "$exit_code" == "0" ]]; then
        continue
      fi
      all_ready=0
      pending_gate="${pending_gate:-bootstrap job $service}"
      if [[ "$status" == "dead" || ( "$status" == "exited" && "$exit_code" != "0" ) ]]; then
        fatal_reason="$service failed with status=$status exit_code=$exit_code"
        break
      fi
    done

    if [[ -z "$fatal_reason" ]]; then
      snapshot=$(compose_service_snapshot property-catalog-kafka)
      IFS='|' read -r container_id status exit_code restart_count health started_at <<<"$snapshot"
      ready_signature+="kafka:${container_id}:${restart_count}:${started_at};"
      if [[ "$status" != "running" || "$health" != "healthy" ]]; then
        all_ready=0
        pending_gate="${pending_gate:-property-catalog-kafka to report healthy}"
        [[ "$status" == "dead" ]] && fatal_reason="property-catalog-kafka entered dead state"
      fi
    fi

    if [[ -z "$fatal_reason" ]]; then
      for service in "${catalog_services[@]}"; do
        snapshot=$(compose_service_snapshot "$service")
        IFS='|' read -r container_id status exit_code restart_count health started_at <<<"$snapshot"
        ready_signature+="${service}:${container_id}:${restart_count}:${started_at};"
        if [[ "$status" != "running" ]]; then
          all_ready=0
          pending_gate="${pending_gate:-$service to report healthy}"
          [[ "$status" == "dead" ]] && fatal_reason="$service entered dead state"
        fi
      done
    fi
  else
    # One app container runs every process under a supervisor. It exiting,
    # or restarting over and over (restart: unless-stopped), is fatal.
    snapshot=$(compose_service_snapshot app)
    IFS='|' read -r container_id status exit_code restart_count health started_at <<<"$snapshot"
    ready_signature+="app:${container_id}:${restart_count}:${started_at};"
    [[ -z "$first_app_restarts" && "$restart_count" =~ ^[0-9]+$ ]] && first_app_restarts="$restart_count"
    if [[ "$status" != "running" ]]; then
      all_ready=0
      pending_gate="${pending_gate:-the app container to run}"
    fi
    if [[ "$status" == "dead" || "$status" == "exited" ]]; then
      fatal_reason="The app container stopped (status=$status exit_code=$exit_code)"
    elif [[ "$restart_count" =~ ^[0-9]+$ && -n "$first_app_restarts" ]] \
         && (( restart_count - first_app_restarts >= 2 )); then
      fatal_reason="The app container keeps restarting ($((restart_count - first_app_restarts)) restarts during this install)"
    fi
  fi

  backend_healthy=1
  if ! curl -fsS --max-time 3 "http://localhost:${backend_port}/health/" >/dev/null 2>&1; then
    backend_healthy=0
    all_ready=0
    pending_gate="${pending_gate:-backend /health/ on port ${backend_port}}"
  fi

  # The distributed stack gates on the frontend container above; the default
  # install's UI comes from the app container, so ask it directly.
  if (( DISTRIBUTED == 0 )) && \
     ! curl -fsS --max-time 3 -o /dev/null "http://localhost:${frontend_port}/" >/dev/null 2>&1; then
    all_ready=0
    pending_gate="${pending_gate:-the UI on port ${frontend_port}}"
  fi

  # A first install spends most of its readiness budget applying migrations.
  # Extend only while the backend is itself the unmet gate and its migration
  # count is still climbing, so a stuck peer service can never hide behind it.
  if (( backend_healthy == 0 )); then
    migrations_applied=$(count_applied_migrations)
    if (( migrations_applied > last_migrations_applied )); then
      last_migrations_applied="$migrations_applied"
      say "  ${DIM}migrations in progress (${migrations_applied} applied), extending the readiness window${RESET}"
      deadline=$(( now + ready_timeout ))
      (( deadline > hard_deadline )) && deadline=$hard_deadline
    fi
  fi

  if [[ -n "$fatal_reason" ]]; then
    save_readiness_diagnostics
    die "$fatal_reason. Relevant service logs were appended to $LOG_FILE"
  fi

  if (( all_ready == 1 )); then
    if [[ "$ready_signature" != "$last_ready_signature" ]]; then
      last_ready_signature="$ready_signature"
      ready_since="$now"
    elif (( now - ready_since >= stability_seconds )); then
      if (( DISTRIBUTED == 1 )); then
        ok "Kafka healthy; observation topic and isolated catalog bootstrap completed"
        ok "Collector and observation consumer stable for ${stability_seconds}s"
      else
        ok "App container stable for ${stability_seconds}s; UI answering on port ${frontend_port}"
      fi
      ok "Backend healthy at http://localhost:${backend_port}"
      break
    fi
  else
    ready_since=0
    last_ready_signature=""
  fi

  if (( now >= deadline )); then
    save_readiness_diagnostics
    die "Stack did not become fully ready, still waiting on ${pending_gate:-$GATE_CONTAINERS}. Relevant service logs were appended to $LOG_FILE"
  fi
  sleep 5
done

# ---------------- create captured user ----------------
if [[ -n "$USER_EMAIL" ]]; then
  step "Creating your account"
  # Capture stderr to show the real error if the command fails. Disable
  # errexit + errtrace inside the subshell so a non-zero exit doesn't
  # fire the script-level ERR trap (which would print a misleading
  # "install failed" line before our own error handling runs).
  set +eE
  trap - ERR
  # create_user exits only once the telemetry registration it starts is done
  # (up to three requests). Unless a timeout is configured, cap each request
  # at 2 s, so blocked egress costs seconds instead of half a minute; the
  # scheduled telemetry job retries a registration that failed here.
  telemetry_timeout="${FUTURE_AGI_TELEMETRY_TIMEOUT_SECONDS:-$(env_value FUTURE_AGI_TELEMETRY_TIMEOUT_SECONDS 2)}"
  if cu_out=$($DC exec -T -e "FUTURE_AGI_TELEMETRY_TIMEOUT_SECONDS=${telemetry_timeout}" \
                "$APP_SVC" python manage.py create_user \
                --email "$USER_EMAIL" --name "$USER_NAME" --password "$USER_PASS" 2>&1); then
    cu_rc=0
  else
    cu_rc=$?
  fi
  trap 'on_err $LINENO' ERR
  set -eE

  if (( cu_rc == 0 )); then
    ACCOUNT_STATE="$ACCOUNT_CREATED"
    ok "Account created for $USER_EMAIL"
  elif printf '%s' "$cu_out" | grep -qiE "already exists|UNIQUE constraint"; then
    ACCOUNT_STATE="$ACCOUNT_EXISTS"
    ok "Account already exists for $USER_EMAIL — sign in normally"
  else
    ACCOUNT_STATE="$ACCOUNT_FAILED"
    warn "create_user failed (exit $cu_rc). Last 6 lines of output:"
    printf '%s\n' "$cu_out" | tail -6 | sed 's|^|      |'
  fi
fi

# ---------------- done ----------------
# Detect alt URLs so VPS / WSL / Docker-in-VM users can pick what works for
# their network. Each detection is best-effort with a hard timeout — never
# blocks the success banner on a slow network.
detect_lan_ip() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    # First non-loopback IPv4 from `ifconfig`. en0 is wifi, en1 is ethernet,
    # but order varies — just pick the first non-127.x.
    ifconfig 2>/dev/null | awk '/inet / && $2 != "127.0.0.1" {print $2; exit}'
  elif command -v ip >/dev/null 2>&1; then
    ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}'
  else
    hostname -I 2>/dev/null | awk '{print $1}'
  fi
}
detect_public_ip() {
  # -4: an IPv6 answer would print as an invalid http://2601:…:3000 URL.
  curl -4 -fsS --max-time 3 https://ifconfig.io 2>/dev/null \
    || curl -4 -fsS --max-time 3 https://api.ipify.org 2>/dev/null \
    || true
}
LAN_IP=$(detect_lan_ip)

collector_http_port=$(env_value FI_COLLECTOR_OTLP_HTTP_PORT 4318)
# The URL SDKs send traces to, as the compose files give it to the app.
collector_url="${FI_COLLECTOR_PUBLIC_URL:-$(env_value FI_COLLECTOR_PUBLIC_URL "http://localhost:${collector_http_port}")}"
gateway_port=$(env_value AGENTCC_GATEWAY_PORT 8090)
ui_url="http://localhost:${frontend_port}"
upgrade_cmd="git pull && ./bin/install"
if (( FROM_SOURCE == 1 )) || [[ "$(env_value FUTURE_AGI_VERSION "")" == local ]]; then
  upgrade_cmd+=" --from-source"
fi
if (( DISTRIBUTED == 1 )); then
  setup_line="Distributed setup: one container per service"
else
  setup_line="Standalone setup: one app container, next to Postgres and ClickHouse"
fi

printf "\n"
if [[ -t 1 ]]; then
  printf "  ${BOLD}${GREEN}╭───────────────────────────────────────────╮${RESET}\n"
  printf "  ${BOLD}${GREEN}│${RESET}   ${BOLD}🎉  Future AGI is up${RESET}                    ${BOLD}${GREEN}│${RESET}\n"
  printf "  ${BOLD}${GREEN}╰───────────────────────────────────────────╯${RESET}\n"
else
  say "Future AGI is up"
fi
say "  ${DIM}${setup_line}${RESET}"

say ""
if [[ "$ACCOUNT_STATE" == "$ACCOUNT_CREATED" || "$ACCOUNT_STATE" == "$ACCOUNT_EXISTS" ]]; then
  say "  ${BOLD}1. Sign in${RESET}"
  say "     ${ui_url}/auth/jwt/login   as ${USER_EMAIL}"
elif [[ "$ACCOUNT_STATE" == "$ACCOUNT_FAILED" ]]; then
  say "  ${BOLD}${YELLOW}1. Create your account (ACTION REQUIRED)${RESET}"
  say "     The stack is running, but no account was created. Create one with:"
  say "     ${BOLD}$DC exec ${APP_SVC} python manage.py create_user${RESET}"
  say "     or sign up at ${ui_url}"
else
  say "  ${BOLD}1. Create your account${RESET}"
  say "     ${ui_url}   ${DIM}(a short setup check, then sign-up)${RESET}"
fi
# The UI calls the API at VITE_HOST_API, http://localhost:8000 when unset:
# other devices reach a working UI only once it names this machine.
host_api=$(env_value VITE_HOST_API "")
if [[ -z "$host_api" || "$host_api" == *://localhost* || "$host_api" == *://127.0.0.1* ]]; then
  [[ -n "$LAN_IP" && "$LAN_IP" != "127.0.0.1" ]] && \
    say "     ${DIM}Other devices: set VITE_HOST_API=http://${LAN_IP}:${backend_port} in .env, then $DC up -d${RESET}"
else
  [[ -n "$LAN_IP" && "$LAN_IP" != "127.0.0.1" ]] && \
    say "     ${DIM}Other devices on your network: http://${LAN_IP}:${frontend_port}${RESET}"
  # Asks a third party for this host's address: only when it is printed.
  PUB_IP=$(detect_public_ip)
  [[ -n "$PUB_IP" && "$PUB_IP" != "$LAN_IP" ]] && \
    say "     ${DIM}Public (only if your firewall allows it): http://${PUB_IP}:${frontend_port}${RESET}"
fi

say ""
say "  ${BOLD}2. Get your API keys${RESET}"
say "     In the app: Keys, in the left sidebar  →  ${ui_url}/dashboard/keys"
say "     Copy the API key and the secret key."

say ""
say "  ${BOLD}3. Send your first trace${RESET} ${DIM}(on this machine; paste with your keys from step 2)${RESET}"
say ""
# Flush left, so the heredoc and the Python indentation survive a copy-paste.
say "pip install fi-instrumentation-otel"
say "export FI_API_KEY=\"<your API key>\" FI_SECRET_KEY=\"<your secret key>\" FI_BASE_URL=\"${collector_url}\""
say "python3 - <<'PY'"
say "from fi_instrumentation import register"
say "from fi_instrumentation.fi_types import ProjectType"
say "tracer_provider = register(project_name=\"my-first-project\", project_type=ProjectType.OBSERVE)"
say "with tracer_provider.get_tracer(\"quickstart\").start_as_current_span(\"hello-future-agi\") as span:"
say "    span.set_attribute(\"input.value\", \"Hello, Future AGI\")"
say "tracer_provider.force_flush()"
say "PY"
say ""
say "     Then open Tracing in the sidebar: ${BOLD}my-first-project${RESET} holds your first span."

say ""
say "  ${BOLD}Endpoints${RESET}"
say "     UI           ${ui_url}"
say "     API          http://localhost:${backend_port}"
if [[ "$collector_url" == "http://localhost:${collector_http_port}" ]]; then
  say "     Traces       ${collector_url}  ${DIM}(OTLP/HTTP; this machine only)${RESET}"
else
  say "     Traces       ${collector_url}  ${DIM}(OTLP/HTTP)${RESET}"
fi
say "     LLM gateway  http://localhost:${gateway_port}"
if (( DISTRIBUTED == 1 )); then
  profiles=",$(env_value COMPOSE_PROFILES ""),"
  [[ "$profiles" == *,all,* || "$profiles" == *,full,* || "$profiles" == *,peerdb,* ]] && \
    say "     PeerDB UI    http://localhost:$(env_value PEERDB_UI_PORT 3001)  ${DIM}(peerdb / peerdb)${RESET}"
fi

say ""
say "  ${BOLD}Manage${RESET}"
say "     Logs         $DC logs -f ${APP_SVC}"
say "     Stop         $DC down  ${DIM}(keeps your data)${RESET}"
say "     Start        $DC up -d"
say "     Upgrade      ${upgrade_cmd}"
say "     Uninstall    ./bin/uninstall  ${DIM}(keeps your data; --wipe-data deletes it)${RESET}"
say "     Settings     .env  ${DIM}(every variable: docs/configuration.md)${RESET}"
say "     Install log  $LOG_FILE"
if (( DISTRIBUTED == 1 )); then
  say ""
  say "  ${DIM}Existing-data catalog backfill: restarts do not scan historical data."
  say "  After an upgrade, see fi-collector/PROPERTY_CATALOG_OSS.md.${RESET}"
fi
say ""
say "  ${DIM}★ Star us: https://github.com/future-agi/future-agi${RESET}"
say ""

[[ "$ACCOUNT_STATE" == "$ACCOUNT_FAILED" ]] && exit 1
exit 0
