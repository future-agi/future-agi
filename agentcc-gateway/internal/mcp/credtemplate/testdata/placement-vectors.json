{
  "description": "Placement vectors for a pushed MCP credential secret (CN7; AM-C20 item 2; AM-C22 for a server with a catalog_ref): one rule on both sides. The gateway's credtemplate.Check (credtemplate.ForCatalogSecret with the catalog below, for a vector with a catalog_ref) and Django's push-time check must give each the same answer: ok, or a refusal naming field (relative to the pushed secret, or url or catalog_ref). reference_header is the server credential's header. Values are test placeholders, never secrets. A vector with no_catalog true is placed with no catalog loaded (the gateway's nil catalog, Django's None): the pushed parts are checked first, then the catalog_ref is refused (AM-C23 (a)).",
  "catalog": {
    "description": "The catalog the vectors with a catalog_ref are placed by: provider records in the shape of connector-catalog-bundle/v1's providers (app, id, version and auth.credentialParts), which the gateway reads as credtemplate.Catalog (catalogparts.FromManifest) and Django with connector_catalog_parts.from_providers. Test fixtures, not vendor facts.",
    "providers": [
      {
        "app": "close",
        "id": "api-key",
        "version": "1.3.0",
        "auth": {
          "credentialParts": [
            {
              "in": "header",
              "name": "Close-API-Key",
              "secret": true
            },
            {
              "in": "header",
              "name": "Close-Scope",
              "secret": false,
              "value": "mcp.read"
            }
          ]
        }
      },
      {
        "app": "linear",
        "id": "api-key",
        "version": "1.0.0",
        "auth": {
          "credentialParts": [
            {
              "in": "header",
              "name": "Authorization",
              "secret": true,
              "prefix": "Bearer "
            }
          ]
        }
      },
      {
        "app": "acme",
        "id": "token",
        "version": "2.0.0",
        "auth": {
          "credentialParts": [
            {
              "in": "header",
              "name": "Authorization",
              "secret": true,
              "prefix": "Token "
            }
          ]
        }
      },
      {
        "app": "datadog",
        "id": "api-key",
        "version": "1.0.0",
        "auth": {
          "credentialParts": [
            {
              "in": "header",
              "name": "DD-API-KEY",
              "secret": true
            },
            {
              "in": "header",
              "name": "DD-APPLICATION-KEY",
              "secret": true
            }
          ]
        }
      },
      {
        "app": "acme",
        "id": "query-key",
        "version": "1.0.0",
        "auth": {
          "credentialParts": [
            {
              "in": "query",
              "name": "api_key",
              "secret": true
            },
            {
              "in": "query",
              "name": "format",
              "secret": false,
              "value": "json"
            }
          ]
        }
      },
      {
        "app": "hooks",
        "id": "url-key",
        "version": "1.0.0",
        "auth": {
          "credentialParts": [
            {
              "in": "url_variable",
              "name": "token",
              "secret": true
            }
          ]
        }
      },
      {
        "app": "acme",
        "id": "region",
        "version": "1.0.0",
        "auth": {
          "credentialParts": [
            {
              "in": "header",
              "name": "X-Api-Key",
              "secret": true
            },
            {
              "in": "url_variable",
              "name": "region",
              "secret": false,
              "value": "us"
            }
          ]
        }
      },
      {
        "app": "acme",
        "id": "oauth",
        "version": "1.0.0",
        "auth": {
          "credentialParts": []
        }
      },
      {
        "app": "acme",
        "id": "bad-constant",
        "version": "1.0.0",
        "auth": {
          "credentialParts": [
            {
              "in": "header",
              "name": "X-Api-Key",
              "secret": true
            },
            {
              "in": "header",
              "name": "Host",
              "secret": false,
              "value": "constant-host"
            }
          ]
        }
      },
      {
        "app": "acme",
        "id": "no-value",
        "version": "1.0.0",
        "auth": {
          "credentialParts": [
            {
              "in": "header",
              "name": "X-Api-Key",
              "secret": true
            },
            {
              "in": "header",
              "name": "X-Mode",
              "secret": false
            }
          ]
        }
      },
      {
        "app": "acme",
        "id": "dot-constant",
        "version": "1.0.0",
        "auth": {
          "credentialParts": [
            {
              "in": "header",
              "name": "X-Api-Key",
              "secret": true
            },
            {
              "in": "url_variable",
              "name": "seg",
              "secret": false,
              "value": ".."
            }
          ]
        }
      },
      {
        "app": "acme",
        "id": "prefixed-query",
        "version": "1.0.0",
        "auth": {
          "credentialParts": [
            {
              "in": "header",
              "name": "X-Api-Key",
              "secret": true
            },
            {
              "in": "query",
              "name": "q",
              "secret": false,
              "value": "1",
              "prefix": "x"
            }
          ]
        }
      }
    ]
  },
