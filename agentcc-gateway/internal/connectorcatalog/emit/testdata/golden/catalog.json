              "additionalProperties": false,
              "properties": {
                "body": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "threadId": {
                  "description": "Reply in this thread.",
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": ["to", "subject", "body"],
              "type": "object"
            },
            "name": "send_email",
            "operation": {
              "method": "POST",
              "path": "/gmail/v1/users/me/messages/send"
            },
            "posture": "ask",
            "scopes": ["https://www.googleapis.com/auth/gmail.compose"],
