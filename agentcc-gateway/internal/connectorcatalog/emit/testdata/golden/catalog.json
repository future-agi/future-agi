              "openWorldHint": true,
              "readOnlyHint": true
            },
            "description": "Search the user's mail threads with a Gmail query, such as from:alice is:unread. Returns thread ids and snippets.",
            "inputSchema": {
              "additionalProperties": false,
              "properties": {
                "maxResults": {
                  "default": 20,
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                },
                "q": {
                  "description": "A Gmail search query, such as from:alice is:unread.",
                  "type": "string"
                }
              },
              "required": ["q"],
              "type": "object"
            },
            "name": "search_threads",
            "operation": {
              "method": "GET",
              "path": "/gmail/v1/users/me/threads"
            },
            "outputSchema": {
              "properties": {
                "threads": {
                  "items": {
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "snippet": {
                        "type": ["string", "null"]
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "posture": "auto",
            "response": {
              "fields": ["id", "snippet"],
              "maxBytes": 25000,
              "unwrap": "threads"
            },
            "scopes": ["https://www.googleapis.com/auth/gmail.readonly"],
            "title": "Search threads"
          },
          {
            "annotations": {
              "destructiveHint": false,
              "idempotentHint": false,
              "openWorldHint": true,
              "readOnlyHint": false
            },
            "description": "Send an email from the user's mailbox. to is a comma-separated list of addresses, such as alice@example.com.",
