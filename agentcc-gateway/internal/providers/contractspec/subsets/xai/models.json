{
  "schema": 1,
  "provider": "xai",
  "root": "models",
  "format": "openapi",
  "select": "GET /v1/models -> 200 application/json",
  "description": "list-models response, decoded by ListModels and by contractwatch's listers (new-model detection); OpenAI-compatible preset served by the openai adapter",
  "paths": {
    "$": {"kinds":["object"]},
    "$.data": {"kinds":["array"]},
    "$.data[]": {"kinds":["object"]},
    "$.data[].aliases": {"kinds":["array"]},
    "$.data[].aliases[]": {"kinds":["string"]},
    "$.data[].cached_prompt_text_token_price": {"kinds":["integer"],"nullable":true},
    "$.data[].cached_prompt_text_token_price_long_context": {"kinds":["integer"],"nullable":true},
    "$.data[].capabilities": {"kinds":["object"],"nullable":true},
    "$.data[].capabilities.default_reasoning_effort": {"kinds":["string"],"nullable":true},
    "$.data[].capabilities.reasoning_effort": {"kinds":["array"]},
    "$.data[].capabilities.reasoning_effort[]": {"kinds":["string"]},
    "$.data[].completion_text_token_price": {"kinds":["integer"],"nullable":true},
    "$.data[].completion_text_token_price_long_context": {"kinds":["integer"],"nullable":true},
    "$.data[].context_length": {"kinds":["integer"],"nullable":true},
    "$.data[].created": {"kinds":["integer"]},
    "$.data[].id": {"kinds":["string"]},
    "$.data[].image_price": {"kinds":["integer"],"nullable":true},
    "$.data[].long_context_threshold": {"kinds":["integer"],"nullable":true},
    "$.data[].object": {"kinds":["string"]},
    "$.data[].owned_by": {"kinds":["string"]},
    "$.data[].pricing": {"kinds":["array"]},
    "$.data[].pricing[]": {"kinds":["object"]},
    "$.data[].pricing[].price_per_image": {"kinds":["integer"]},
    "$.data[].pricing[].quality": {"kinds":["string"]},
    "$.data[].pricing[].resolution": {"kinds":["string"]},
    "$.data[].prompt_image_token_price": {"kinds":["integer"],"nullable":true},
    "$.data[].prompt_text_token_price": {"kinds":["integer"],"nullable":true},
    "$.data[].prompt_text_token_price_long_context": {"kinds":["integer"],"nullable":true},
    "$.object": {"kinds":["string"]}
  }
}
