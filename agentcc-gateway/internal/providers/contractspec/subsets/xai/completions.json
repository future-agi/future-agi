{
  "schema": 1,
  "provider": "xai",
  "root": "completions",
  "format": "openapi",
  "select": "POST /v1/completions -> 200 application/json",
  "description": "legacy completions response, decoded by TextCompletion into models.CompletionResponse; OpenAI-compatible preset served by the openai adapter",
  "paths": {
    "$": {"kinds":["object"]},
    "$.choices": {"kinds":["array"]},
    "$.choices[]": {"kinds":["object"]},
    "$.choices[].finish_reason": {"kinds":["string"]},
    "$.choices[].index": {"kinds":["integer"]},
    "$.choices[].text": {"kinds":["string"]},
    "$.created": {"kinds":["integer"]},
    "$.id": {"kinds":["string"]},
    "$.model": {"kinds":["string"]},
    "$.object": {"kinds":["string"]},
    "$.system_fingerprint": {"kinds":["string"],"nullable":true},
    "$.usage": {"kinds":["object"],"nullable":true},
    "$.usage.completion_tokens": {"kinds":["integer"]},
    "$.usage.completion_tokens_details": {"kinds":["object"]},
    "$.usage.completion_tokens_details.accepted_prediction_tokens": {"kinds":["integer"]},
    "$.usage.completion_tokens_details.audio_tokens": {"kinds":["integer"]},
    "$.usage.completion_tokens_details.reasoning_tokens": {"kinds":["integer"]},
    "$.usage.completion_tokens_details.rejected_prediction_tokens": {"kinds":["integer"]},
    "$.usage.cost_in_usd_ticks": {"kinds":["integer"]},
    "$.usage.num_sources_used": {"kinds":["integer"]},
    "$.usage.prompt_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details": {"kinds":["object"]},
    "$.usage.prompt_tokens_details.audio_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.cached_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.image_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.text_tokens": {"kinds":["integer"]},
    "$.usage.server_side_tool_usage_details": {"kinds":["object"],"nullable":true},
    "$.usage.server_side_tool_usage_details.code_interpreter_calls": {"kinds":["integer"]},
    "$.usage.server_side_tool_usage_details.document_search_calls": {"kinds":["integer"]},
    "$.usage.server_side_tool_usage_details.file_search_calls": {"kinds":["integer"]},
    "$.usage.server_side_tool_usage_details.image_generation_calls": {"kinds":["integer"]},
    "$.usage.server_side_tool_usage_details.mcp_calls": {"kinds":["integer"]},
    "$.usage.server_side_tool_usage_details.web_search_calls": {"kinds":["integer"]},
    "$.usage.server_side_tool_usage_details.x_posts_fetched": {"kinds":["integer"]},
    "$.usage.server_side_tool_usage_details.x_search_calls": {"kinds":["integer"]},
    "$.usage.server_side_tool_usage_details.x_users_fetched": {"kinds":["integer"]},
    "$.usage.total_tokens": {"kinds":["integer"]}
  }
}
