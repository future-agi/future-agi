{
  "schema": 1,
  "provider": "openrouter",
  "root": "embeddings",
  "format": "openapi",
  "select": "POST /embeddings -> 200 application/json",
  "description": "embeddings response, decoded by CreateEmbedding; OpenAI-compatible preset served by the openai adapter",
  "paths": {
    "$": {"kinds":["object"]},
    "$.data": {"kinds":["array"]},
    "$.data[]": {"kinds":["object"]},
    "$.data[].embedding": {"kinds":["array","string"]},
    "$.data[].embedding[]": {"kinds":["number"]},
    "$.data[].index": {"kinds":["integer"]},
    "$.data[].object": {"kinds":["string"],"enum":["embedding"]},
    "$.id": {"kinds":["string"]},
    "$.model": {"kinds":["string"]},
    "$.object": {"kinds":["string"],"enum":["list"]},
    "$.usage": {"kinds":["object"]},
    "$.usage.cost": {"kinds":["number"]},
    "$.usage.cost_details": {"kinds":["object"],"nullable":true},
    "$.usage.cost_details.server_tool_cost": {"kinds":["number"],"nullable":true},
    "$.usage.cost_details.upstream_inference_completions_cost": {"kinds":["number"]},
    "$.usage.cost_details.upstream_inference_cost": {"kinds":["number"],"nullable":true},
    "$.usage.cost_details.upstream_inference_prompt_cost": {"kinds":["number"]},
    "$.usage.is_byok": {"kinds":["boolean"]},
    "$.usage.prompt_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details": {"kinds":["object"]},
    "$.usage.prompt_tokens_details.audio_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.file_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.image_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.text_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.video_tokens": {"kinds":["integer"]},
    "$.usage.total_tokens": {"kinds":["integer"]}
  }
}
