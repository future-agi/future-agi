{
  "schema": 1,
  "provider": "openai",
  "root": "completions",
  "format": "openapi",
  "select": "POST /completions -> 200 application/json",
  "description": "legacy completions response, decoded by TextCompletion into models.CompletionResponse",
  "paths": {
    "$": {"kinds":["object"]},
    "$.choices": {"kinds":["array"]},
    "$.choices[]": {"kinds":["object"]},
    "$.choices[].finish_reason": {"kinds":["string"],"enum":["content_filter","length","stop"],"nullable":true},
    "$.choices[].index": {"kinds":["integer"]},
    "$.choices[].logprobs": {"kinds":["object"],"nullable":true},
    "$.choices[].logprobs.text_offset": {"kinds":["array"]},
    "$.choices[].logprobs.text_offset[]": {"kinds":["integer"]},
    "$.choices[].logprobs.token_logprobs": {"kinds":["array"]},
    "$.choices[].logprobs.token_logprobs[]": {"kinds":["number"]},
    "$.choices[].logprobs.tokens": {"kinds":["array"]},
    "$.choices[].logprobs.tokens[]": {"kinds":["string"]},
    "$.choices[].logprobs.top_logprobs": {"kinds":["array"]},
    "$.choices[].logprobs.top_logprobs[]": {"kinds":["map","object"]},
    "$.choices[].logprobs.top_logprobs[].*": {"kinds":["number"]},
    "$.choices[].text": {"kinds":["string"]},
    "$.created": {"kinds":["integer"]},
    "$.id": {"kinds":["string"]},
    "$.model": {"kinds":["string"]},
    "$.object": {"kinds":["string"],"enum":["text_completion"]},
    "$.system_fingerprint": {"kinds":["string"]},
    "$.usage": {"kinds":["object"]},
    "$.usage.completion_tokens": {"kinds":["integer"]},
    "$.usage.completion_tokens_details": {"kinds":["object"]},
    "$.usage.completion_tokens_details.accepted_prediction_tokens": {"kinds":["integer"]},
    "$.usage.completion_tokens_details.audio_tokens": {"kinds":["integer"]},
    "$.usage.completion_tokens_details.reasoning_tokens": {"kinds":["integer"]},
    "$.usage.completion_tokens_details.rejected_prediction_tokens": {"kinds":["integer"]},
    "$.usage.completion_tokens_details.text_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details": {"kinds":["object"]},
    "$.usage.prompt_tokens_details.audio_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.cache_write_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.cached_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.image_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens_details.text_tokens": {"kinds":["integer"]},
    "$.usage.total_tokens": {"kinds":["integer"]}
  }
}
