    "$.models[].supportedGenerationMethods[]": {"kinds":["string"]},
    "$.models[].temperature": {"kinds":["number"]},
    "$.models[].thinking": {"kinds":["boolean"]},
    "$.models[].topK": {"kinds":["integer"]},
