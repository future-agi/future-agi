    "$.embeddings[].shape[]": {"kinds":["integer"]},
    "$.embeddings[].values": {"kinds":["array"]},
    "$.embeddings[].values[]": {"kinds":["number"]},
    "$.usageMetadata": {"kinds":["object"]},
    "$.usageMetadata.promptTokenCount": {"kinds":["integer"]},
    "$.usageMetadata.promptTokenDetails": {"kinds":["array"]},
    "$.usageMetadata.promptTokenDetails[]": {"kinds":["object"]},
    "$.usageMetadata.promptTokenDetails[].modality": {"kinds":["string"],"enum":["AUDIO","DOCUMENT","IMAGE","MODALITY_UNSPECIFIED","TEXT","VIDEO"]},
    "$.usageMetadata.promptTokenDetails[].tokenCount": {"kinds":["integer"]}
  }
