{
  "schema": 1,
  "provider": "gemini",
  "root": "batch_embed_contents",
  "format": "discovery",
  "select": "method models.batchEmbedContents -> BatchEmbedContentsResponse",
  "description": "batchEmbedContents response, decoded by translateBatchEmbedResponse",
  "paths": {
