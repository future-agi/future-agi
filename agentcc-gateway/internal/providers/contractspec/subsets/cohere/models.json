    "$.models[].sampling_defaults.k": {"kinds":["integer"]},
    "$.models[].sampling_defaults.max_tokens_per_doc": {"kinds":["integer"]},
    "$.models[].sampling_defaults.p": {"kinds":["number"]},
    "$.models[].sampling_defaults.presence_penalty": {"kinds":["number"]},
