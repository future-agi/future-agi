{
  "schema": 1,
  "provider": "cohere",
  "root": "chat",
  "format": "openapi",
  "select": "#/components/schemas/ChatResponseV2",
  "description": "v2 chat response, decoded by ChatCompletion",
  "paths": {
    "$": {"kinds":["object"]},
    "$.finish_reason": {"kinds":["string"],"enum":["COMPLETE","ERROR","MAX_TOKENS","STOP_SEQUENCE","TIMEOUT","TOOL_CALL"]},
    "$.id": {"kinds":["string"]},
    "$.logprobs": {"kinds":["array"]},
    "$.logprobs[]": {"kinds":["object"]},
    "$.logprobs[].logprobs": {"kinds":["array"]},
    "$.logprobs[].logprobs[]": {"kinds":["number"]},
    "$.logprobs[].text": {"kinds":["string"]},
    "$.logprobs[].token_ids": {"kinds":["array"]},
    "$.logprobs[].token_ids[]": {"kinds":["integer"]},
    "$.message": {"kinds":["object"]},
    "$.message.citations": {"kinds":["array"]},
    "$.message.citations[]": {"kinds":["object"]},
    "$.message.citations[].content_index": {"kinds":["integer"]},
    "$.message.citations[].end": {"kinds":["integer"]},
    "$.message.citations[].sources": {"kinds":["array"]},
    "$.message.citations[].sources[]": {"kinds":["object"]},
    "$.message.citations[].sources[].document": {"kinds":["map","object"],"opaque":true,"variants":["type=document"]},
    "$.message.citations[].sources[].id": {"kinds":["string"],"variants":["type=document","type=tool"]},
    "$.message.citations[].sources[].tool_output": {"kinds":["map","object"],"opaque":true,"variants":["type=tool"]},
    "$.message.citations[].sources[].type": {"enum":["document","tool"]},
    "$.message.citations[].start": {"kinds":["integer"]},
    "$.message.citations[].text": {"kinds":["string"]},
    "$.message.citations[].type": {"kinds":["string"],"enum":["PLAN","TEXT_CONTENT","THINKING_CONTENT"]},
    "$.message.content": {"kinds":["array"]},
    "$.message.content[]": {"kinds":["object"]},
    "$.message.content[].text": {"kinds":["string"],"variants":["type=text"]},
    "$.message.content[].thinking": {"kinds":["string"],"variants":["type=thinking"]},
    "$.message.content[].type": {"kinds":["string"],"enum":["text","thinking"],"variants":["type=text","type=thinking"]},
    "$.message.role": {"kinds":["string"],"enum":["assistant"]},
    "$.message.tool_calls": {"kinds":["array"]},
    "$.message.tool_calls[]": {"kinds":["object"]},
    "$.message.tool_calls[].function": {"kinds":["object"]},
    "$.message.tool_calls[].function.arguments": {"kinds":["string"]},
    "$.message.tool_calls[].function.name": {"kinds":["string"]},
    "$.message.tool_calls[].id": {"kinds":["string"]},
    "$.message.tool_calls[].type": {"kinds":["string"],"enum":["function"]},
    "$.message.tool_plan": {"kinds":["string"]},
    "$.usage": {"kinds":["object"]},
    "$.usage.billed_units": {"kinds":["object"]},
    "$.usage.billed_units.classifications": {"kinds":["number"]},
    "$.usage.billed_units.input_tokens": {"kinds":["number"]},
    "$.usage.billed_units.output_tokens": {"kinds":["number"]},
    "$.usage.billed_units.search_units": {"kinds":["number"]},
    "$.usage.cached_tokens": {"kinds":["number"]},
    "$.usage.tokens": {"kinds":["object"]},
    "$.usage.tokens.input_tokens": {"kinds":["number"]},
    "$.usage.tokens.output_tokens": {"kinds":["number"]}
  }
}
