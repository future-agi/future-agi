{
  "schema": 1,
  "provider": "vertex",
  "root": "predict",
  "format": "discovery",
  "select": "method projects.locations.publishers.models.predict -> GoogleCloudAiplatformV1beta1PredictResponse",
  "description": "Vertex predict response (Imagen)",
  "paths": {
    "$": {"kinds":["object"]},
    "$.deployedModelId": {"kinds":["string"]},
