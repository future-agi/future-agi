{
  "schema": 1,
  "provider": "together",
  "root": "chat_stream",
  "format": "openapi",
  "select": "POST /v1/chat/completions -> 200 text/event-stream (rebased at $.data)",
  "description": "one chat completion stream chunk (an SSE data line), decoded by StreamChatCompletion; OpenAI-compatible preset served by the openai adapter",
  "paths": {
    "chunk:$": {"kinds":["object","string"],"enum":["[DONE]"]},
    "chunk:$.choices": {"kinds":["array"]},
    "chunk:$.choices[]": {"kinds":["object"]},
    "chunk:$.choices[].delta": {"kinds":["object"]},
    "chunk:$.choices[].delta.content": {"kinds":["string"],"nullable":true},
    "chunk:$.choices[].delta.reasoning": {"kinds":["string"],"nullable":true},
    "chunk:$.choices[].delta.reasoning_content": {"kinds":["string"],"nullable":true},
    "chunk:$.choices[].delta.role": {"kinds":["string"],"enum":["assistant","function","system","tool","user"]},
    "chunk:$.choices[].delta.token_id": {"kinds":["integer"]},
    "chunk:$.choices[].delta.tool_calls": {"kinds":["array"]},
    "chunk:$.choices[].delta.tool_calls[]": {"kinds":["object"]},
    "chunk:$.choices[].delta.tool_calls[].function": {"kinds":["object"]},
    "chunk:$.choices[].delta.tool_calls[].function.arguments": {"kinds":["string"]},
    "chunk:$.choices[].delta.tool_calls[].function.name": {"kinds":["string"]},
    "chunk:$.choices[].delta.tool_calls[].id": {"kinds":["string"]},
    "chunk:$.choices[].delta.tool_calls[].index": {"kinds":["number"]},
    "chunk:$.choices[].delta.tool_calls[].type": {"kinds":["string"],"enum":["function"]},
    "chunk:$.choices[].finish_reason": {"kinds":["string"],"enum":["eos","function_call","length","stop","tool_calls"],"nullable":true},
    "chunk:$.choices[].index": {"kinds":["integer"]},
    "chunk:$.choices[].logprobs": {"kinds":["number"],"nullable":true},
    "chunk:$.choices[].seed": {"kinds":["integer"],"nullable":true},
    "chunk:$.choices[].top_logprobs": {"kinds":["map","object"]},
    "chunk:$.choices[].top_logprobs.*": {"kinds":["number"]},
    "chunk:$.created": {"kinds":["integer"]},
    "chunk:$.id": {"kinds":["string"]},
    "chunk:$.model": {"kinds":["string"]},
    "chunk:$.object": {"enum":["chat.completion.chunk"]},
    "chunk:$.system_fingerprint": {"kinds":["string"]},
    "chunk:$.usage": {"kinds":["any","object"],"nullable":true,"opaque":true},
    "chunk:$.usage.completion_tokens": {"kinds":["integer"]},
    "chunk:$.usage.prompt_tokens": {"kinds":["integer"]},
    "chunk:$.usage.total_tokens": {"kinds":["integer"]},
    "chunk:$.warnings": {"kinds":["array"]},
    "chunk:$.warnings[]": {"kinds":["object"]},
    "chunk:$.warnings[].message": {"kinds":["string"]}
  }
}
