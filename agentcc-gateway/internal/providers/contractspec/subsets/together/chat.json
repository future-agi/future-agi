{
  "schema": 1,
  "provider": "together",
  "root": "chat",
  "format": "openapi",
  "select": "POST /v1/chat/completions -> 200 application/json",
  "description": "chat completion response, decoded by the adapter's ChatCompletion; OpenAI-compatible preset served by the openai adapter",
  "paths": {
    "$": {"kinds":["object"]},
    "$.choices": {"kinds":["array"]},
    "$.choices[]": {"kinds":["object"]},
    "$.choices[].finish_reason": {"kinds":["string"],"enum":["eos","function_call","length","stop","tool_calls"]},
    "$.choices[].index": {"kinds":["integer"]},
    "$.choices[].logprobs": {"kinds":["any","object"],"nullable":true,"opaque":true},
    "$.choices[].logprobs.token_ids": {"kinds":["array"]},
    "$.choices[].logprobs.token_ids[]": {"kinds":["number"]},
    "$.choices[].logprobs.token_logprobs": {"kinds":["array"]},
    "$.choices[].logprobs.token_logprobs[]": {"kinds":["number"]},
    "$.choices[].logprobs.tokens": {"kinds":["array"]},
    "$.choices[].logprobs.tokens[]": {"kinds":["string"]},
    "$.choices[].logprobs.top_logprobs": {"kinds":["map","object"]},
    "$.choices[].logprobs.top_logprobs.*": {"kinds":["number"]},
    "$.choices[].message": {"kinds":["object"]},
    "$.choices[].message.content": {"kinds":["string"],"nullable":true},
    "$.choices[].message.reasoning": {"kinds":["string"],"nullable":true},
    "$.choices[].message.reasoning_content": {"kinds":["string"],"nullable":true},
    "$.choices[].message.role": {"kinds":["string"],"enum":["assistant"]},
    "$.choices[].message.tool_calls": {"kinds":["array"]},
    "$.choices[].message.tool_calls[]": {"kinds":["object"]},
    "$.choices[].message.tool_calls[].function": {"kinds":["object"]},
    "$.choices[].message.tool_calls[].function.arguments": {"kinds":["string"]},
    "$.choices[].message.tool_calls[].function.name": {"kinds":["string"]},
    "$.choices[].message.tool_calls[].id": {"kinds":["string"]},
    "$.choices[].message.tool_calls[].index": {"kinds":["number"]},
    "$.choices[].message.tool_calls[].type": {"kinds":["string"],"enum":["function"]},
    "$.choices[].seed": {"kinds":["integer"]},
    "$.choices[].text": {"kinds":["string"]},
    "$.choices[].top_logprobs": {"kinds":["map","object"]},
    "$.choices[].top_logprobs.*": {"kinds":["number"]},
    "$.created": {"kinds":["integer"]},
    "$.id": {"kinds":["string"]},
    "$.model": {"kinds":["string"]},
    "$.object": {"enum":["chat.completion"]},
    "$.prompt": {"kinds":["array"]},
    "$.prompt[]": {"kinds":["object"]},
    "$.prompt[].logprobs": {"kinds":["object"]},
    "$.prompt[].logprobs.token_ids": {"kinds":["array"]},
    "$.prompt[].logprobs.token_ids[]": {"kinds":["number"]},
    "$.prompt[].logprobs.token_logprobs": {"kinds":["array"]},
    "$.prompt[].logprobs.token_logprobs[]": {"kinds":["number"]},
    "$.prompt[].logprobs.tokens": {"kinds":["array"]},
    "$.prompt[].logprobs.tokens[]": {"kinds":["string"]},
    "$.prompt[].logprobs.top_logprobs": {"kinds":["map","object"]},
    "$.prompt[].logprobs.top_logprobs.*": {"kinds":["number"]},
    "$.prompt[].text": {"kinds":["string"]},
    "$.usage": {"kinds":["object"],"nullable":true},
    "$.usage.completion_tokens": {"kinds":["integer"]},
    "$.usage.prompt_tokens": {"kinds":["integer"]},
    "$.usage.total_tokens": {"kinds":["integer"]},
    "$.warnings": {"kinds":["array"]},
    "$.warnings[]": {"kinds":["object"]},
    "$.warnings[].message": {"kinds":["string"]}
  }
}
