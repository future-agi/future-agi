{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futureagi.com/schemas/connector-manifest/v1.json",
  "title": "connector-manifest/v1",
  "description": "One connector catalog record: an app (apps/<id>/app.yaml), one way to reach it (apps/<id>/providers/<id>.yaml), a partner platform (platforms/<id>.yaml), or a rest provider's generated tools (tools.generated.json). The data is open source: it never holds a client id, a secret or a price. Keys outside this schema and null values are refused at every level, except inside a tool's inputSchema and outputSchema. Rules that span fields or records (URL variables, sources, ids, EE and OSS emission, tool scopes) are enforced by agentcc-gateway/internal/connectorcatalog/manifest; catalog/connectors/README.md lists them.",
  "oneOf": [
    { "$ref": "#/$defs/app" },
    { "$ref": "#/$defs/provider" },
    { "$ref": "#/$defs/platform" },
    { "$ref": "#/$defs/toolsGenerated" }
  ],
  "$defs": {
    "appId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$",
      "description": "EE's APP_ID rule. Apps and platforms share one id space."
    },
    "providerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "A calendar date, YYYY-MM-DD."
    },
    "httpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[a-z0-9.-]+(:[0-9]{1,5})?([/?][A-Za-z0-9._~:/?@!$&'()*+,;=%-]*)?$",
      "description": "HTTPS, a lowercase host, no userinfo and no fragment (EE's safeEndpoint)."
    },
    "urlTemplate": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://([a-z0-9.-]|[{][A-Za-z_][A-Za-z0-9_]{0,31}[}])+(:[0-9]{1,5})?([/?]([A-Za-z0-9._~:/?@!$&'()*+,;=%-]|[{][A-Za-z_][A-Za-z0-9_]{0,31}[}])*)?$",
      "description": "An httpsUrl that may hold {name} variables, including in the host. Each variable is declared exactly once: in the matching urlVariables, or as a url_variable credential part. {connectorsHost} is reserved for rest providers, which must use it."
    },
    "hostname": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?([.][a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "githubOrg": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$",
      "description": "Matched case-insensitively."
    },
    "toolName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "description": "Stricter than EE's posture rule ({0,127}). len(app.id) + 2 + len(name) must also be at most 64, so <server>__<tool> fits."
    },
    "scope": { "type": "string", "pattern": "^[!-~]{1,256}$" },
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "envPrefix": {
      "type": "string",
      "pattern": "^OMEGA_INTEGRATION_[A-Z0-9_]{2,40}$",
      "description": "EE's ENV_PREFIX rule."
    },
    "varName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$" },
    "headerName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]{1,64}$",
      "description": "An HTTP token. The validator also refuses transport headers (Host, Content-Length, Mcp-Session-Id, ...), case-insensitively."
    },
    "queryName": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,64}$" },
    "authorizeParamName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,64}$",
      "not": {
        "enum": [
          "client_id",
          "client_secret",
          "redirect_uri",
          "response_type",
          "state",
          "scope",
          "code_challenge",
          "code_challenge_method",
          "nonce",
          "resource"
        ]
      },
      "description": "The connect flow owns the refused names."
    },
    "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "toolsHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ratePeriod": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,5}(ms|s|m|h|d)$"
    },
    "leadTime": {
      "type": "string",
      "pattern": "^P([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?$",
      "description": "An ISO 8601 duration in whole years, months, weeks or days, such as P6W."
    },
    "era": {
      "type": "string",
      "pattern": "^(auto|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "dottedPath": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}([.][A-Za-z_][A-Za-z0-9_]{0,63}){0,7}$"
    },
    "factPath": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}([.][A-Za-z][A-Za-z0-9-]{0,63}){0,7}$",
      "description": "The dotted path of the field a source supports, such as transport.url or auth.oauth2.scopes."
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$",
      "description": "An exact version; ranges are refused."
    },
    "packageIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9@][A-Za-z0-9@._/:-]{0,199}$"
    },
    "commandName": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,64}$" },
    "operationPath": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._~:/@!$&'()*+,;=%{}-]{0,255}$"
    },
    "credentialPrefix": {
      "type": "string",
      "pattern": "^[!-~]{1,31} ?$",
      "description": "Text placed before a header value, such as \"Bearer \"."
    },
    "anchoredRegex": {
      "type": "string",
      "pattern": "^\\^.{1,198}\\$$",
      "description": "A regular expression anchored with ^ and $, in the subset ECMA-262, RE2 and Python share."
    },
    "registryName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]{1,100}/[A-Za-z0-9._-]{1,99}$",
      "description": "An official MCP Registry server name."
    },
    "skillName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "programId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,47}$",
      "description": "A vendor review program, such as google_restricted_scopes."
    },

    "eeCategory": {
      "enum": [
        "productivity",
        "developer",
        "communication",
        "data",
        "research"
      ],
      "description": "EE IntegrationCategory."
    },
    "group": {
      "enum": ["google", "microsoft", "other"],
      "description": "EE IntegrationGroup."
    },
    "archetype": {
      "enum": [
        "workspace-docs",
        "knowledge-base",
        "calendar",
        "mailbox",
        "code-host",
        "ci-pipeline",
        "issue-tracker",
        "crm",
        "support-desk",
        "data-warehouse",
        "spreadsheet",
        "cloud-drive",
        "error-tracking",
        "product-analytics",
        "team-messaging"
      ],
      "description": "An OSS integration.<archetype> connector."
    },
    "lifecycleStatus": { "enum": ["active", "deprecated", "sunset"] },
    "providerKind": {
      "enum": ["vendor_mcp", "rest", "partner", "vendor_local"]
    },
    "publisher": { "enum": ["vendor", "futureagi", "partner", "community"] },
    "vendorStatusLabel": { "enum": ["ga", "preview", "beta", "unknown"] },
    "transportKind": { "enum": ["http", "stdio"] },
    "transportVariant": { "enum": ["streamable", "sse"] },
    "accountMode": {
      "enum": ["agent", "user"],
      "description": "EE ConnectionAccountMode."
    },
    "authKind": {
      "enum": [
        "oauth2",
        "mcp_oauth",
        "api_key",
        "basic",
        "service_account",
        "partner",
        "none",
        "local_setup"
      ]
    },
    "tokenBody": { "enum": ["form", "json"] },
    "clientAuth": { "enum": ["body", "basic"] },
    "registration": { "enum": ["preregistered", "cimd", "dcr"] },
    "credentialIn": { "enum": ["header", "query", "url_variable"] },
    "partnerBinding": { "enum": ["header", "url", "mint", "oauth"] },
    "toolsSource": { "enum": ["upstream_mcp", "operations", "partner"] },
    "posture": {
      "enum": ["auto", "ask", "deny"],
      "description": "EE ToolPosture."
    },
    "httpMethod": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
    "pricingModel": {
      "enum": ["free", "vendor_plan", "vendor_metered", "partner_metered"]
    },
    "tier": { "enum": ["listed", "verified", "optimized"] },
    "conformanceLevel": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
    "specFormat": {
      "enum": ["openapi-3", "swagger-2", "postman-2.1", "google-discovery"]
    },
    "packageRegistry": { "enum": ["npm", "pypi", "oci", "mcpb"] },
    "registryNamespace": { "enum": ["domain", "github"] },
    "variableScope": { "enum": ["org", "user"] },
    "rateScope": { "enum": ["user", "org", "app"] },
    "connectMode": { "enum": ["oauth", "headers"] },
    "platformAccount": { "enum": ["byo", "managed"] },
    "modality": {
      "enum": ["text", "image", "audio", "video", "file", "event"],
      "description": "OSS Modality."
    },
    "omegaSource": {
      "enum": [
        "omega",
        "personal-gateway-reference",
        "local-operator-reference",
        "model-agent-reference",
        "workflow-automation-reference",
        "realtime-room-framework",
        "production-app-reference",
        "skillpack-reference",
        "personal-memory-reference",
        "integration-reference",
        "runtime-adapter-reference",
        "methodology-reference",
        "verification-reference",
        "external-integration-reference"
      ],
      "description": "OSS OmegaConnectorSource."
    },
    "include": { "enum": ["include", "exclude"] },
    "revocationMethod": { "enum": ["POST", "DELETE"] },
    "revocationTokenField": { "enum": ["token", "access_token"] },
    "verifyMethod": { "enum": ["GET", "POST"] },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "url", "fetchedAt"],
      "properties": {
        "fact": { "$ref": "#/$defs/factPath" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "fetchedAt": { "$ref": "#/$defs/date" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "sunsetAt": { "$ref": "#/$defs/date" },
        "replacedBy": { "$ref": "#/$defs/appId" }
      },
      "if": { "properties": { "status": { "const": "sunset" } } },
      "then": { "required": ["sunsetAt"], "properties": { "sunsetAt": true } }
    },
    "urlVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "pattern", "scope"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 200 },
        "pattern": { "$ref": "#/$defs/anchoredRegex" },
        "default": { "type": "string", "minLength": 1, "maxLength": 253 },
        "scope": { "$ref": "#/$defs/variableScope" }
      }
    },

    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "version",
        "name",
        "description",
        "vendor",
        "eeCategory",
        "group",
        "categories",
        "docsUrl",
        "defaultProvider",
        "lifecycle",
        "sources"
      ],
      "properties": {
        "schema": { "const": "connector-manifest/v1#app" },
        "id": { "$ref": "#/$defs/appId" },
        "version": { "$ref": "#/$defs/semver" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "minLength": 1, "maxLength": 100 },
        "vendor": { "$ref": "#/$defs/vendor" },
        "eeCategory": { "$ref": "#/$defs/eeCategory" },
        "group": { "$ref": "#/$defs/group" },
        "categories": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" },
          "maxItems": 16,
          "uniqueItems": true
        },
        "docsUrl": { "$ref": "#/$defs/httpsUrl" },
        "icon": { "$ref": "#/$defs/icon" },
        "archetype": { "$ref": "#/$defs/archetype" },
        "defaultProvider": { "$ref": "#/$defs/providerId" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" },
          "maxItems": 64
        },
        "x-omega": { "$ref": "#/$defs/appXOmega" },
        "x-gateway": { "$ref": "#/$defs/appXGateway" }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domains"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "domains": {
          "type": "array",
          "items": { "$ref": "#/$defs/hostname" },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "githubOrgs": {
          "type": "array",
          "items": { "$ref": "#/$defs/githubOrg" },
          "maxItems": 16,
          "uniqueItems": true
        }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light"],
      "properties": {
        "light": { "$ref": "#/$defs/httpsUrl" },
        "dark": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "appXOmega": {
      "type": "object",
      "additionalProperties": false,
      "description": "Omega-only keys. eeId, envPrefix, ee and oss keep EE's existing app ids and env variables (omega-coordination.md, the 05:40 agreement).",
      "properties": {
        "eeId": { "$ref": "#/$defs/appId" },
        "envPrefix": { "$ref": "#/$defs/envPrefix" },
        "ee": { "$ref": "#/$defs/include" },
        "oss": { "$ref": "#/$defs/include" },
        "modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/modality" },
          "maxItems": 6,
          "uniqueItems": true
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/skillName" },
          "maxItems": 32,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/omegaSource" },
          "maxItems": 14,
          "uniqueItems": true
        }
      }
    },
    "appXGateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },

    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "app",
        "id",
        "version",
        "kind",
        "publisher",
        "vendorStatus",
        "transport",
        "hosted",
        "trusted",
        "accountModes",
        "auth",
        "tools",
        "pricing",
        "quality",
        "lifecycle",
        "sources"
      ],
      "properties": {
        "schema": { "const": "connector-manifest/v1#provider" },
        "app": { "$ref": "#/$defs/appId" },
        "id": { "$ref": "#/$defs/providerId" },
        "version": { "$ref": "#/$defs/semver" },
        "kind": { "$ref": "#/$defs/providerKind" },
        "publisher": { "$ref": "#/$defs/publisher" },
        "vendorStatus": { "$ref": "#/$defs/vendorStatus" },
        "transport": { "$ref": "#/$defs/transport" },
        "hosted": { "type": "boolean" },
        "trusted": {
          "type": "boolean",
          "description": "True only after a maintainer reviews the annotations (tier verified or optimized)."
        },
        "accountModes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accountMode" },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "auth": { "$ref": "#/$defs/auth" },
        "tools": { "$ref": "#/$defs/tools" },
        "rateLimits": {
          "type": "array",
          "items": { "$ref": "#/$defs/rateLimit" },
          "maxItems": 16
        },
        "retry": { "$ref": "#/$defs/retry" },
        "pricing": { "$ref": "#/$defs/pricing" },
        "upstream": { "$ref": "#/$defs/upstream" },
        "quality": { "$ref": "#/$defs/quality" },
        "lifecycle": { "$ref": "#/$defs/providerLifecycle" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" },
          "maxItems": 64
        },
        "x-omega": { "$ref": "#/$defs/providerXOmega" },
        "x-gateway": { "$ref": "#/$defs/providerXGateway" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "vendor_mcp" } } },
          "then": {
            "properties": {
              "transport": {
                "type": "object",
                "properties": { "kind": { "const": "http" } }
              },
              "publisher": { "enum": ["vendor", "community"] },
              "auth": {
                "type": "object",
                "properties": { "kind": { "not": { "const": "partner" } } }
              },
              "tools": {
                "type": "object",
                "properties": { "source": { "const": "upstream_mcp" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "rest" } } },
          "then": {
            "required": ["upstream"],
            "properties": {
              "transport": {
                "type": "object",
                "properties": { "kind": { "const": "http" } }
              },
              "publisher": { "const": "futureagi" },
              "auth": {
                "type": "object",
                "properties": { "kind": { "not": { "const": "partner" } } }
              },
              "tools": {
                "type": "object",
                "properties": { "source": { "const": "operations" } }
              },
              "upstream": {
                "type": "object",
                "required": ["spec"],
                "properties": { "spec": true }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "partner" } } },
          "then": {
            "properties": {
              "transport": {
                "type": "object",
                "properties": { "kind": { "const": "http" } }
              },
              "publisher": { "const": "partner" },
              "auth": {
                "type": "object",
                "properties": { "kind": { "const": "partner" } }
              },
              "tools": {
                "type": "object",
                "properties": { "source": { "const": "partner" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "vendor_local" } } },
          "then": {
            "properties": {
              "transport": {
                "type": "object",
                "properties": { "kind": { "const": "stdio" } }
              },
              "publisher": { "enum": ["vendor", "community"] },
              "auth": {
                "type": "object",
                "properties": { "kind": { "enum": ["local_setup", "none"] } }
              },
              "tools": {
                "type": "object",
                "properties": { "source": { "const": "upstream_mcp" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "type": "object",
                "properties": { "kind": { "const": "http" } }
              }
            }
          },
          "then": { "properties": { "hosted": { "const": true } } },
          "else": { "properties": { "hosted": { "const": false } } }
        },
        {
          "if": { "properties": { "trusted": { "const": true } } },
          "then": {
            "properties": {
              "quality": {
                "type": "object",
                "required": ["review"],
                "properties": {
                  "review": true,
                  "tier": { "enum": ["verified", "optimized"] }
                }
              }
            }
          }
        }
      ]
    },
    "providerLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "sunsetAt": { "$ref": "#/$defs/date" },
        "replacedBy": { "$ref": "#/$defs/providerId" }
      },
      "if": { "properties": { "status": { "const": "sunset" } } },
      "then": { "required": ["sunsetAt"], "properties": { "sunsetAt": true } }
    },
    "vendorStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "$ref": "#/$defs/vendorStatusLabel" },
        "source": { "$ref": "#/$defs/httpsUrl" }
      },
      "if": {
        "properties": { "label": { "enum": ["ga", "preview", "beta"] } }
      },
      "then": { "required": ["source"], "properties": { "source": true } }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/transportKind" },
        "url": { "$ref": "#/$defs/urlTemplate" },
        "urlVariables": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/varName" },
          "additionalProperties": { "$ref": "#/$defs/urlVariable" },
          "maxProperties": 8
        },
        "variant": { "$ref": "#/$defs/transportVariant" },
        "era": { "$ref": "#/$defs/era" },
        "command": { "$ref": "#/$defs/commandName" },
        "args": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "maxItems": 32
        },
        "env": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/envName" },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxProperties": 16,
          "description": "stdio: variable name -> what it holds. Never a value."
        },
        "package": { "$ref": "#/$defs/package" }
      },
      "if": { "properties": { "kind": { "const": "http" } } },
      "then": {
        "required": ["url"],
        "properties": {
          "url": true,
          "command": false,
          "args": false,
          "env": false,
          "package": false
        }
      },
      "else": {
        "required": ["command"],
        "properties": {
          "command": true,
          "url": false,
          "urlVariables": false,
          "variant": false
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryType", "identifier", "version"],
      "properties": {
        "registryType": { "$ref": "#/$defs/packageRegistry" },
        "identifier": { "$ref": "#/$defs/packageIdentifier" },
        "version": { "$ref": "#/$defs/packageVersion" },
        "fileSha256": { "$ref": "#/$defs/sha256Hex" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/authKind" },
        "oauth2": { "$ref": "#/$defs/oauth2" },
        "credentialParts": {
          "type": "array",
          "items": { "$ref": "#/$defs/credentialPart" },
          "minItems": 1,
          "maxItems": 8
        },
        "clientApproval": { "$ref": "#/$defs/clientApproval" },
        "partner": { "$ref": "#/$defs/partnerAuth" },
        "verify": { "$ref": "#/$defs/verify" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "oauth2" } } },
          "then": { "required": ["oauth2"], "properties": { "oauth2": true } },
          "else": { "properties": { "oauth2": false } }
        },
        {
          "if": { "properties": { "kind": { "const": "api_key" } } },
          "then": {
            "required": ["credentialParts"],
            "properties": { "credentialParts": true }
          },
          "else": { "properties": { "credentialParts": false } }
        },
        {
          "if": { "properties": { "kind": { "const": "partner" } } },
          "then": {
            "required": ["partner"],
            "properties": { "partner": true }
          },
          "else": { "properties": { "partner": false } }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["oauth2", "mcp_oauth"] } }
          },
          "else": { "properties": { "clientApproval": false } }
        }
      ]
    },
    "oauth2": {
      "type": "object",
      "additionalProperties": false,
      "description": "EE IntegrationOAuthSpec field for field, plus the extras. Scopes are an array; EE receives them joined with spaces.",
      "required": [
        "authorizeUrl",
        "tokenUrl",
        "scopes",
        "pkce",
        "tokenBody",
        "clientAuth"
      ],
      "properties": {
        "authorizeUrl": { "$ref": "#/$defs/urlTemplate" },
        "tokenUrl": { "$ref": "#/$defs/urlTemplate" },
        "scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/scope" },
          "maxItems": 64,
          "uniqueItems": true
        },
        "pkce": { "type": "boolean" },
        "tokenBody": { "$ref": "#/$defs/tokenBody" },
        "clientAuth": { "$ref": "#/$defs/clientAuth" },
        "extraAuthorizeParams": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/authorizeParamName" },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxProperties": 16
        },
        "resourceIndicator": {
          "type": "boolean",
          "description": "Send the RFC 8707 resource parameter."
        },
        "urlVariables": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/varName" },
          "additionalProperties": { "$ref": "#/$defs/urlVariable" },
          "maxProperties": 8
        },
        "refresh": { "$ref": "#/$defs/refresh" },
        "revocation": { "$ref": "#/$defs/revocation" },
        "registration": {
          "type": "array",
          "items": { "$ref": "#/$defs/registration" },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "clientGroup": { "$ref": "#/$defs/appId" },
        "review": { "$ref": "#/$defs/oauthReview" },
        "tokenResponse": { "$ref": "#/$defs/tokenResponse" }
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "rotates"],
      "properties": {
        "supported": { "type": "boolean" },
        "rotates": { "type": "boolean" }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "method", "tokenBody", "tokenField", "clientAuth"],
      "properties": {
        "url": { "$ref": "#/$defs/urlTemplate" },
        "method": { "$ref": "#/$defs/revocationMethod" },
        "tokenBody": { "$ref": "#/$defs/tokenBody" },
        "tokenField": { "$ref": "#/$defs/revocationTokenField" },
        "clientAuth": { "$ref": "#/$defs/clientAuth" },
        "headers": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/headerName" },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxProperties": 8
        },
        "alreadyRevokedStatuses": {
          "type": "array",
          "items": { "type": "integer", "minimum": 200, "maximum": 599 },
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "oauthReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "leadTime", "source"],
      "properties": {
        "program": { "$ref": "#/$defs/programId" },
        "leadTime": { "$ref": "#/$defs/leadTime" },
        "source": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "tokenResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the token endpoint puts the tokens when not at the top level, such as Slack's authed_user.access_token. EE cannot read this field yet, so an EE-eligible provider may not set it.",
      "required": ["accessTokenPath"],
      "properties": {
        "accessTokenPath": { "$ref": "#/$defs/dottedPath" },
        "refreshTokenPath": { "$ref": "#/$defs/dottedPath" },
        "expiresInPath": { "$ref": "#/$defs/dottedPath" }
      }
    },
    "credentialPart": {
      "type": "object",
      "additionalProperties": false,
      "description": "One part of a credential and where it goes. A secret part is supplied by the customer and never has a value here. A non-secret part is a constant (value) or a customer setting.",
      "required": ["in", "name", "secret"],
      "properties": {
        "in": { "$ref": "#/$defs/credentialIn" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "secret": { "type": "boolean" },
        "value": { "type": "string", "minLength": 1, "maxLength": 200 },
        "prefix": { "$ref": "#/$defs/credentialPrefix" },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "help": { "type": "string", "minLength": 1, "maxLength": 300 },
        "helpUrl": { "$ref": "#/$defs/httpsUrl" }
      },
      "allOf": [
        {
          "if": { "properties": { "secret": { "const": true } } },
          "then": { "properties": { "value": false } }
        },
        {
          "if": { "properties": { "in": { "const": "header" } } },
          "then": {
            "properties": { "name": { "$ref": "#/$defs/headerName" } }
          },
          "else": { "properties": { "prefix": false } }
        },
        {
          "if": { "properties": { "in": { "const": "query" } } },
          "then": { "properties": { "name": { "$ref": "#/$defs/queryName" } } }
        },
        {
          "if": { "properties": { "in": { "const": "url_variable" } } },
          "then": { "properties": { "name": { "$ref": "#/$defs/varName" } } }
        }
      ]
    },
    "clientApproval": {
      "type": "object",
      "additionalProperties": false,
      "description": "The vendor admits only clients it has approved. Until approvedAt is set the provider stays at tier listed and the console shows Needs vendor approval.",
      "required": ["required", "program", "url", "source"],
      "properties": {
        "required": { "type": "boolean" },
        "program": { "type": "string", "minLength": 1, "maxLength": 100 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "source": { "$ref": "#/$defs/httpsUrl" },
        "approvedAt": { "$ref": "#/$defs/date" }
      }
    },
    "partnerAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "toolkit", "version", "binding", "toolMode"],
      "properties": {
        "platform": { "$ref": "#/$defs/appId" },
        "toolkit": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "binding": { "$ref": "#/$defs/partnerBinding" },
        "toolMode": { "const": "fixed" }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "$ref": "#/$defs/toolName" },
        "http": { "$ref": "#/$defs/verifyHttp" }
      },
      "oneOf": [
        { "required": ["tool"], "properties": { "tool": true } },
        { "required": ["http"], "properties": { "http": true } }
      ]
    },
    "verifyHttp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url"],
      "properties": {
        "method": { "$ref": "#/$defs/verifyMethod" },
        "url": { "$ref": "#/$defs/urlTemplate" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "defaultPosture"],
      "properties": {
        "source": { "$ref": "#/$defs/toolsSource" },
        "defaultPosture": { "$ref": "#/$defs/posture" },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool" },
          "maxItems": 128
        },
        "generated": {
          "const": "tools.generated.json",
          "description": "rest only: the generator's output beside this file, tied to upstream.spec by sha256."
        }
      },
      "if": { "properties": { "source": { "const": "operations" } } },
      "else": { "properties": { "generated": false } }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "toolsHash", "era", "takenAt"],
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "toolsHash": { "$ref": "#/$defs/toolsHash" },
        "era": { "$ref": "#/$defs/era" },
        "takenAt": { "$ref": "#/$defs/date" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "annotations"],
      "properties": {
        "name": { "$ref": "#/$defs/toolName" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "annotations": { "$ref": "#/$defs/annotations" },
        "posture": { "$ref": "#/$defs/posture" },
        "scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/scope" },
          "maxItems": 32,
          "uniqueItems": true
        },
        "operation": { "$ref": "#/$defs/operation" },
        "inputSchema": {
          "type": "object",
          "description": "A JSON Schema 2020-12 document whose root has type object."
        },
        "outputSchema": {
          "type": "object",
          "description": "A JSON Schema 2020-12 document."
        },
        "response": { "$ref": "#/$defs/response" },
        "generic": {
          "type": "boolean",
          "description": "The tool's real operation is one of its arguments (Stripe's stripe_api_write, Work IQ's do_action), so per-tool policy sees only the verb."
        },
        "genericArguments": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "description": "The inputSchema properties that carry the real operation."
        }
      },
      "if": {
        "required": ["genericArguments"],
        "properties": { "genericArguments": true }
      },
      "then": {
        "required": ["generic"],
        "properties": { "generic": { "const": true } }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "description": "All four MCP hints, explicit.",
      "required": [
        "readOnlyHint",
        "destructiveHint",
        "idempotentHint",
        "openWorldHint"
      ],
      "properties": {
        "readOnlyHint": { "type": "boolean" },
        "destructiveHint": { "type": "boolean" },
        "idempotentHint": { "type": "boolean" },
        "openWorldHint": { "type": "boolean" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "$ref": "#/$defs/httpMethod" },
        "path": { "$ref": "#/$defs/operationPath" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unwrap": { "$ref": "#/$defs/dottedPath" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/dottedPath" },
          "maxItems": 64,
          "uniqueItems": true
        },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "requests", "per", "source"],
      "properties": {
        "scope": { "$ref": "#/$defs/rateScope" },
        "requests": { "type": "integer", "minimum": 1, "maximum": 100000000 },
        "per": { "$ref": "#/$defs/ratePeriod" },
        "source": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "honorRetryAfter"],
      "properties": {
        "on": {
          "type": "array",
          "items": { "type": "integer", "minimum": 400, "maximum": 599 },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "honorRetryAfter": { "type": "boolean" }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "description": "The pricing model only, never a number. Prices live in the gateway-only overlay (connector-price-overlay/v1), outside this repository.",
      "required": ["model"],
      "properties": {
        "model": { "$ref": "#/$defs/pricingModel" },
        "notes": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "$ref": "#/$defs/registryRef" },
        "spec": { "$ref": "#/$defs/spec" }
      }
    },
    "registryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "namespace"],
      "properties": {
        "name": { "$ref": "#/$defs/registryName" },
        "version": { "$ref": "#/$defs/packageVersion" },
        "namespace": { "$ref": "#/$defs/registryNamespace" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "format", "sha256", "licence"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "format": { "$ref": "#/$defs/specFormat" },
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "licence": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tier": { "$ref": "#/$defs/tier" },
        "conformance": { "$ref": "#/$defs/conformance" },
        "liveSmoke": { "$ref": "#/$defs/liveSmoke" },
        "evals": { "$ref": "#/$defs/evals" },
        "review": { "$ref": "#/$defs/qualityReview" },
        "owner": { "$ref": "#/$defs/slug" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "harness", "fixturesSha256", "runAt"],
      "properties": {
        "level": { "$ref": "#/$defs/conformanceLevel" },
        "harness": { "$ref": "#/$defs/semver" },
        "fixturesSha256": { "$ref": "#/$defs/sha256Hex" },
        "runAt": { "$ref": "#/$defs/date" }
      }
    },
    "liveSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastPass", "account"],
      "properties": {
        "lastPass": { "$ref": "#/$defs/date" },
        "account": { "const": "test" }
      }
    },
    "evals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "passRate", "models", "runAt"],
      "properties": {
        "suite": { "type": "string", "minLength": 1, "maxLength": 100 },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "models": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "runAt": { "$ref": "#/$defs/date" }
      }
    },
    "qualityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "at"],
      "properties": {
        "by": { "type": "string", "minLength": 1, "maxLength": 100 },
        "at": { "$ref": "#/$defs/date" },
        "notes": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "providerXOmega": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ee": { "$ref": "#/$defs/include" },
        "oss": { "$ref": "#/$defs/include" },
        "ossId": {
          "$ref": "#/$defs/appId",
          "description": "This provider's OSS registry id. Set it to keep an existing id (github, github-remote, sentry-remote)."
        },
        "publicClient": { "$ref": "#/$defs/publicClient" }
      }
    },
    "publicClient": {
      "type": "object",
      "additionalProperties": false,
      "description": "Whether a person can sign in to this provider the way OSS Omega's omega mcp login does: with a client id they register with the vendor beforehand (or the vendor publishes), PKCE, a loopback redirect and no client secret. OSS's registry lists an oauth2 or mcp_oauth server only when supported is true; not stated means not proven. supported: true needs auth.kind oauth2 with pkce and a preregistered registration, and every evidence page on the vendor's own domains or GitHub orgs (agentcc-gateway/internal/connectorcatalog/manifest).",
      "required": ["supported", "evidence"],
      "properties": {
        "supported": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/publicClientEvidence" },
          "minItems": 1,
          "maxItems": 4
        },
        "notes": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "publicClientEvidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "A page fetched on fetchedAt, the sha256 of the bytes saved then, and the sentence on it that bears the fact out (a page may change after it was saved; the quote is what to look for).",
      "required": ["url", "fetchedAt", "sha256", "quote"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "fetchedAt": { "$ref": "#/$defs/date" },
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "quote": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "providerXGateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "forwardHeaders": {
          "type": "array",
          "items": { "$ref": "#/$defs/headerName" },
          "maxItems": 16,
          "uniqueItems": true,
          "description": "Inbound headers the gateway copies upstream. The validator also refuses credential headers and every header the gateway never forwards (x-agentcc-*, x-omega-*; the gateway's config.ForwardHeaderRefused)."
        }
      }
    },

    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "version",
        "name",
        "description",
        "connect",
        "account",
        "toolMode",
        "metaTools",
        "selfHostable",
        "termsUrl",
        "termsCheckedAt",
        "sources"
      ],
      "properties": {
        "schema": { "const": "connector-manifest/v1#platform" },
        "id": { "$ref": "#/$defs/appId" },
        "version": { "$ref": "#/$defs/semver" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "minLength": 1, "maxLength": 100 },
        "connect": { "$ref": "#/$defs/platformConnect" },
        "account": { "$ref": "#/$defs/platformAccount" },
        "toolMode": {
          "const": "fixed",
          "description": "Discovery meta-tools must be off."
        },
        "metaTools": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolName" },
          "maxItems": 16,
          "uniqueItems": true
        },
        "selfHostable": { "type": "boolean" },
        "termsUrl": { "$ref": "#/$defs/httpsUrl" },
        "termsCheckedAt": { "$ref": "#/$defs/date" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" },
          "maxItems": 64
        }
      }
    },
    "platformConnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "urlPattern"],
      "properties": {
        "modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/connectMode" },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "urlPattern": { "$ref": "#/$defs/urlTemplate" }
      }
    },

    "toolsGenerated": {
      "type": "object",
      "additionalProperties": false,
      "description": "tools.generated.json: the REST generator's output for one rest provider. spec must equal the provider's upstream.spec url and sha256.",
      "required": ["schema", "spec", "tools"],
      "properties": {
        "schema": { "const": "connector-manifest/v1#tools-generated" },
        "spec": { "$ref": "#/$defs/generatedSpec" },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool" },
          "minItems": 1,
          "maxItems": 128
        }
      }
    },
    "generatedSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256Hex" }
      }
    }
  }
}
