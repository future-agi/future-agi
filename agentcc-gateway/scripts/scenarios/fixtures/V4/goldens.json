  },
  {
    "name": "tavily search",
    "request": {
      "method": "POST",
      "path": "/tavily/search",
      "body": { "query": "golden", "search_depth": "basic" }
    },
    "expect": {
      "status": 200,
      "json": {
        "query": { "equals": "golden" },
        "results.0.url": "string",
        "results.0.score": "number",
        "response_time": "number"
      }
    }
  },
  {
    "name": "brave web search",
    "request": {
      "method": "GET",
      "path": "/brave/res/v1/web/search?q=golden",
      "headers": { "X-Subscription-Token": "not-a-real-token" }
    },
    "expect": {
      "status": 200,
      "json": {
        "type": { "equals": "search" },
        "query.original": { "equals": "golden" },
        "web.results.0.url": "string",
        "web.results.0.description": "string"
      }
    }
  },
  {
    "name": "searxng search",
    "request": {
      "method": "GET",
      "path": "/searxng/search?q=golden&format=json"
    },
    "expect": {
      "status": 200,
      "json": {
        "query": { "equals": "golden" },
        "number_of_results": "number",
        "results.0.url": "string",
        "results.0.engine": "string"
      }
    }
  },
  {
    "name": "firecrawl scrape",
    "request": {
      "method": "POST",
      "path": "/firecrawl/v2/scrape",
      "body": { "url": "https://example.com", "formats": ["markdown"] }
    },
    "expect": {
      "status": 200,
      "json": {
        "success": { "equals": true },
        "data.markdown": "string",
        "data.metadata.statusCode": { "equals": 200 }
      }
    }
  },
  {
    "name": "jina reader",
    "request": {
      "method": "GET",
      "path": "/jina/https://example.com/page",
      "headers": { "Accept": "application/json" }
    },
    "expect": {
      "status": 200,
      "json": {
        "code": { "equals": 200 },
        "data.url": { "equals": "https://example.com/page" },
        "data.content": "string",
        "data.usage.tokens": "number"
      }
    }
  },
  {
    "name": "mistral ocr",
    "request": {
      "method": "POST",
      "path": "/mistral-ocr/v1/ocr",
      "body": {
        "model": "mistral-ocr-latest",
        "document": {
          "type": "document_url",
          "document_url": "https://example.com/a.pdf"
        }
      }
    },
    "expect": {
      "status": 200,
      "json": {
        "pages.0.markdown": "string",
        "pages.0.index": { "equals": 0 },
        "usage_info.pages_processed": { "equals": 1 }
      }
    }
  },
  {
    "name": "azure document intelligence analyze",
    "request": {
      "method": "POST",
      "path": "/azure-di/documentintelligence/documentModels/prebuilt-read:analyze?api-version=2024-11-30",
      "body": { "urlSource": "https://example.com/a.pdf" }
    },
    "expect": { "status": 202, "headers": ["Operation-Location"] }
  },
  {
    "name": "textract detect",
    "request": {
      "method": "POST",
      "path": "/textract/",
      "headers": {
        "X-Amz-Target": "Textract.DetectDocumentText",
        "Content-Type": "application/x-amz-json-1.1"
      },
      "body": { "Document": { "Bytes": "AA==" } }
    },
    "expect": {
      "status": 200,
      "json": {
        "DocumentMetadata.Pages": { "equals": 1 },
        "Blocks.1.BlockType": { "equals": "LINE" },
        "Blocks.1.Text": "string"
      }
    }
  },
  {
    "name": "deepgram listen",
    "request": {
      "method": "POST",
      "path": "/deepgram/v1/listen?model=nova-3",
      "headers": { "Content-Type": "audio/wav" },
      "body": "RIFF"
    },
    "expect": {
      "status": 200,
      "json": {
        "metadata.request_id": "string",
        "metadata.duration": "number",
        "results.channels.0.alternatives.0.transcript": "string"
      }
    }
  },
  {
    "name": "assemblyai upload",
    "request": {
      "method": "POST",
      "path": "/assemblyai/v2/upload",
      "headers": { "Content-Type": "application/octet-stream" },
      "body": "RIFF"
    },
    "expect": { "status": 200, "json": { "upload_url": "string" } }
  },
  {
