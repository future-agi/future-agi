  {
    "name": "pipedream mcp tools/list",
    "request": {
      "method": "POST",
      "path": "/pipedream/mcp",
      "headers": {
        "x-pd-project-id": "proj",
        "x-pd-environment": "development",
        "x-pd-external-user-id": "user-1",
        "x-pd-app-slug": "slack"
      },
      "body": { "jsonrpc": "2.0", "id": 1, "method": "tools/list" }
    },
    "expect": {
      "status": 200,
      "json": {
        "jsonrpc": { "equals": "2.0" },
        "result.tools.0.name": { "equals": "slack-send-message" },
        "result.tools.0.inputSchema.type": { "equals": "object" }
      }
    }
  },
