[
  {
    "name": "exa search",
    "request": {
      "method": "POST",
      "path": "/exa/search",
      "headers": { "Content-Type": "application/json" },
      "body": { "query": "golden", "type": "auto" }
    },
    "expect": {
      "status": 200,
      "json": {
        "requestId": "string",
        "results.0.url": "string",
        "results.0.title": "string",
        "costDollars.total": "number"
      }
    }
  },
  {
    "name": "parallel search",
    "request": {
      "method": "POST",
      "path": "/parallel/v1beta/search",
      "body": { "objective": "golden", "search_queries": ["golden"] }
    },
    "expect": {
      "status": 200,
      "json": {
        "search_id": "string",
        "results.0.url": "string",
        "results.0.excerpts": "array",
        "usage.0.name": "string"
      }
    }
  },
  {
    "name": "perplexity search",
    "request": {
      "method": "POST",
      "path": "/perplexity/search",
      "body": { "query": "golden" }
