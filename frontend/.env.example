# =============================================================================
# FutureAGI Core Frontend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# Backend API URL
VITE_HOST_API=http://localhost:8000

# Frontend assets URL
VITE_ASSETS_API=http://localhost:3031

# Environment: dev | production
VITE_ENVIRONMENT=dev

# Bounded read defaults. These can also be supplied to the frontend container
# at runtime; invalid or out-of-range values safely fall back to these defaults.
VITE_INTERACTIVE_REQUEST_TIMEOUT_MS=30000
VITE_ADD_QUEUE_CONTINUATION_MAX_PAGES=100
VITE_ADD_QUEUE_CONTINUATION_WALL_MS=600000
VITE_ANALYTICS_REQUEST_TIMEOUT_MS=30000
VITE_AGGREGATION_REQUEST_TIMEOUT_MS=30000
VITE_AGGREGATION_POLL_TIMEOUT_MS=120000
VITE_FILTER_VALUE_REQUEST_TIMEOUT_MS=30000
VITE_AGGREGATION_POLL_INITIAL_DELAY_MS=1000
VITE_AGGREGATION_POLL_MAX_DELAY_MS=8000
VITE_AGGREGATION_POLL_BACKOFF_FACTOR=2
VITE_AGGREGATION_POLL_MAX_ATTEMPTS=12
VITE_AGGREGATION_POLL_MAX_CONSECUTIVE_FAILURES=3
VITE_CURSOR_MAX_EMPTY_CONTINUATIONS=12
VITE_OBSERVE_GRID_MAX_CONCURRENT_REQUESTS=1
VITE_OBSERVE_GRID_MAX_BLOCKS_IN_CACHE=5
VITE_OBSERVE_CURSOR_MAX_CHECKPOINTS=4096
VITE_OBSERVE_PAGE_TRANSITION_MAX_WAIT_MS=60000
VITE_OBSERVE_LIST_CELL_PREVIEW_MAX_CHARS=16384
VITE_CHUNK_IMPORT_TIMEOUT_MS=10000
VITE_CHUNK_IMPORT_MAX_RETRIES=3
VITE_CHUNK_IMPORT_RETRY_BASE_DELAY_MS=1000
VITE_INTERACTIVE_MAX_PAGE_SIZE=100
VITE_OBSERVE_LIST_DEFAULT_PAGE_SIZE=25
VITE_PROPERTY_CATALOG_PAGE_SIZE=50
VITE_INTERACTIVE_TABLE_PAGE_SIZE=10
VITE_PROPERTY_CATALOG_SEARCH_PAGE_SIZE=20
VITE_PROPERTY_CATALOG_COMPACT_PAGE_SIZE=25
VITE_PROPERTY_CATALOG_LEGACY_PAGE_SIZE=200
VITE_PROPERTY_CATALOG_SEARCH_DEBOUNCE_MS=300
VITE_PROPERTY_CATALOG_SEARCH_MAX_UTF8_BYTES=512
VITE_PROPERTY_PICKER_RENDER_BATCH_SIZE=500
VITE_PROPERTY_PICKER_PREFETCH_MARGIN_PX=48
VITE_ATTRIBUTE_INVENTORY_SEARCH_DEBOUNCE_MS=350
VITE_FILTER_VALUE_SEARCH_DEBOUNCE_MS=500
VITE_FILTER_AUTO_APPLY_DEBOUNCE_MS=350
VITE_PROPERTY_CATALOG_STALE_TIME_MS=60000
VITE_PROPERTY_CATALOG_CACHE_TIME_MS=300000
VITE_PROPERTY_CATALOG_LEGACY_STALE_TIME_MS=300000
VITE_PROPERTY_CATALOG_LEGACY_CACHE_TIME_MS=900000
VITE_FILTER_VALUE_PAGE_SIZE=50
VITE_FILTER_VALUE_MIN_VISIBLE_RESULTS=1
VITE_FILTER_VALUE_STALE_TIME_MS=300000
VITE_FILTER_VALUE_CACHE_TIME_MS=900000
VITE_AUTOMATION_RULE_LIST_PAGE_SIZE=25
VITE_OBSERVE_PROJECT_PAGE_SIZE=100
VITE_EVAL_METRIC_MAX_WINDOW_DAYS=365
VITE_SIMULATION_PREVIEW_PAGE_SIZE=50
VITE_SIMULATION_PREVIEW_MAX_PAGE_SIZE=50
VITE_GROUND_TRUTH_DATASET_PAGE_SIZE=100
VITE_DATASET_ROW_ADJACENCY_MAX_ROWS=50

# Mixpanel analytics token
VITE_MIXPANEL_TOKEN=your-mixpanel-token
# Session replay is disabled by default. Set a percentage from 0 to 100 to opt in.
VITE_MIXPANEL_SESSION_REPLAY_PERCENT=0
# Comma-separated route prefixes where replay must remain disabled.
VITE_SESSION_REPLAY_BLOCKED_PATH_PREFIXES=/dashboard/observe,/dashboard/users,/dashboard/dashboards,/dashboard/tasks,/dashboard/annotations,/dashboard/error-feed

# Help/support link. Unset in OSS falls back to the community Discord.
VITE_HELP_LINK=https://meetings.hubspot.com/salil-kolhe/help-futureagi-app

# Generate link (usually same as frontend URL)
VITE_GENERATE_LINK=http://localhost:3031

# Google reCAPTCHA site key
VITE_GOOGLE_SITE_KEY=your-recaptcha-site-key

# AG Grid Enterprise license key (optional)
# VITE_AG_GRID_LICENSE_KEY=your-ag-grid-license-key

# Stripe public key
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Pendo analytics key (optional)
# VITE_PENDO_API_KEY=your-pendo-key

# Google Ads conversion tracking
# Both flag AND ID must be set for tracking to fire. Leave ENABLED=false in dev
# or staging so test signups don't pollute production Ads reporting.
# SIGNUP_LABEL reuses the landing-page "Sign-up click" conversion label so
# both clicks and completions count toward the same Ads conversion action.
# The app-side completion fire prefixes transaction_id with "signup_completed_"
# to keep the two distinguishable in Ads logs / audits.
VITE_GOOGLE_ADS_ENABLED=false
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXXX
VITE_GOOGLE_ADS_SIGNUP_LABEL=conversion-label-from-google-ads
VITE_GA_ID=G-XXXXXXXXXX

VITE_REDDIT_ADS_ENABLED=false
VITE_REDDIT_PIXEL_ID=a2_XXXXXXXXXXXX

VITE_TWITTER_ADS_ENABLED=false
VITE_TWITTER_PIXEL_ID=XXXXX

VITE_AD_CONVERSION_VALUE=75.0
VITE_AD_CONVERSION_CURRENCY=USD

# React Query devtools floating widget. Enabled unless set to exactly "false".
# Only ever rendered in dev builds — the devtools package no-ops in production.
VITE_REACT_QUERY_DEVTOOLS_ENABLED=true

# Disable ESLint errors in dev overlay
ESLINT_NO_DEV_ERRORS=true
