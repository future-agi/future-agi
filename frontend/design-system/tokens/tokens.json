  "shadow": {
    "raised": {
      "light": "0 1px 2px rgba(0, 0, 0, 0.05)",
      "dark": "0 1px 2px rgba(0, 0, 0, 0.40)",
      "use": "Sticky headers and dragged items only."
    },
    "overlay": {
      "light": "0 0 0 1px {color.border.default}, 0 4px 8px -2px rgba(0, 0, 0, 0.05), 0 12px 24px -6px rgba(0, 0, 0, 0.08)",
      "dark": "0 0 0 1px rgba(255, 255, 255, 0.08), 0 8px 24px -4px rgba(0, 0, 0, 0.60)",
      "use": "Menus, popovers, selects, tooltips with content."
    },
    "modal": {
      "light": "0 0 0 1px {color.border.default}, 0 24px 48px -12px rgba(0, 0, 0, 0.18)",
      "dark": "0 0 0 1px rgba(255, 255, 255, 0.08), 0 24px 64px -8px rgba(0, 0, 0, 0.70)",
      "use": "Dialogs."
    },
    "drawer": {
      "light": "-12px 0 24px -12px rgba(0, 0, 0, 0.12)",
      "dark": "-8px 0 32px rgba(0, 0, 0, 0.50)",
      "use": "Right drawers, with a 1px left border."
    },
    "focus": {
      "light": "0 0 0 2px {color.border.focus}",
      "dark": "0 0 0 2px {color.border.focus}",
      "use": "Fallback only. Focus is a 2px outline in border.focus with a 2px offset (inside, -2px, for rows and menu items); use this ring where an outline can't be drawn."
    },
    "focusInput": {
      "light": "0 0 0 3px rgba(120, 87, 252, 0.20)",
      "dark": "0 0 0 3px rgba(255, 255, 255, 0.20)",
      "use": "Inputs: with border.focus as the border."
    }
  },
  "font": {
    "family": {
      "sans": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, \"JetBrains Mono\", monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "role": {
      "display": {
        "size": 32,
        "line": 40,
        "weight": 600,
        "tracking": "-0.02em",
        "use": "Rare: onboarding and empty-product heroes."
      },
      "title-lg": {
        "size": 24,
        "line": 32,
        "weight": 600,
        "tracking": "-0.01em",
        "use": "Rare: large headings on onboarding and empty-product pages."
      },
      "title-md": {
        "size": 20,
        "line": 28,
        "weight": 600,
        "tracking": "-0.01em",
        "use": "Rare: hero numbers and wide-dialog titles. Not page titles."
      },
      "title-sm": {
        "size": 15,
        "line": 22,
        "weight": 600,
        "tracking": "0",
        "use": "Page title, object header, dialog and drawer title."
      },
      "title-xs": {
        "size": 12,
        "line": 18,
        "weight": 500,
        "tracking": "0",
        "use": "Section title, panel title, group heading."
      },
      "body-md": {
        "size": 12,
        "line": 18,
        "weight": 400,
        "tracking": "0",
        "use": "Paragraphs, input values, long text."
      },
      "body-sm": {
        "size": 12,
        "line": 18,
        "weight": 400,
        "tracking": "0",
        "use": "UI default: table cells, nav, menus, lists."
      },
      "label-md": {
        "size": 12,
        "line": 18,
        "weight": 500,
        "tracking": "0",
        "use": "Buttons, row names, field labels, tabs."
      },
      "label-sm": {
        "size": 11,
        "line": 16,
        "weight": 500,
        "tracking": "0",
        "use": "Badges, tags, small buttons."
      },
      "caption": {
        "size": 11,
        "line": 16,
        "weight": 400,
        "tracking": "0",
        "use": "Descriptions under names, helper text, column headers."
      },
      "overline": {
        "size": 11,
        "line": 16,
        "weight": 500,
        "tracking": "0.04em",
        "case": "uppercase",
        "use": "Section labels only. Never sentences."
      },
      "code-sm": {
        "size": 11,
        "line": 16,
        "weight": 400,
        "tracking": "0",
        "family": "mono",
        "use": "Inline code, IDs, hashes, JSON."
      },
      "code-md": {
        "size": 12,
        "line": 18,
        "weight": 400,
        "tracking": "0",
        "family": "mono",
        "use": "Code blocks."
      },
      "metric-lg": {
        "size": 24,
        "line": 32,
        "weight": 600,
        "tracking": "-0.01em",
        "numeric": "tabular",
        "use": "Headline numbers in metric strips."
      },
      "metric-md": {
        "size": 15,
        "line": 22,
        "weight": 600,
        "tracking": "0",
        "numeric": "tabular",
        "use": "Numbers in summary rows."
      }
    },
    "productAlias": {
      "$description": "The product's own text variants (sx typography: \"s1\" … \"l3\"), each an alias of a role above. They carry size and line height only, so a screen keeps its weights. A theme must define them: without them every such text falls back to MUI's 14–16px default.",
      "s1": "body-sm",
      "s1_2": "body-md",
      "s2": "caption",
      "s2_1": "body-sm",
      "s3": "caption",
      "m1": "title-sm",
      "m2": "title-sm",
      "m3": "body-md",
      "l1": "title-lg",
      "l2": "title-lg",
      "l3": "title-md",
      "subheader": "overline"
    }
  },
  "space": {
    "0": 0,
    "2": 2,
    "4": 4,
    "6": 6,
    "8": 8,
    "12": 12,
    "16": 16,
    "20": 20,
    "24": 24,
    "32": 32,
    "40": 40,
    "48": 48,
    "64": 64
  },
  "radius": {
    "none": 0,
    "xs": 2,
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 12,
    "full": 9999,
    "$use": {
      "xs": "Checkbox, kbd, progress",
      "sm": "Badge, tag, tooltip, inline code",
      "md": "Button, input, menu item, segmented control (default)",
      "lg": "Panel, card, menu, popover, toast",
      "xl": "Dialog",
      "full": "Avatar, switch, status dot"
    }
  },
  "borderWidth": {
    "default": 1,
    "strong": 2,
    "$use": {
      "default": "Every border",
      "strong": "Selected indicator (tab underline) and focus only"
    }
  },
  "size": {
    "control": {
      "xs": 24,
      "sm": 28,
      "md": 32,
      "lg": 36
    },
    "controlPaddingX": {
      "xs": 8,
      "sm": 10,
      "md": 12,
      "lg": 14
    },
    "icon": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 20
    },
    "row": {
      "compact": 28,
      "default": 36,
      "twoLine": 48
    },
    "tableHeader": {
      "compact": 28,
      "default": 32
    },
    "badge": {
      "sm": 18,
      "md": 20
    },
    "avatar": {
      "sm": 20,
      "md": 24,
      "lg": 32
    },
    "drawer": {
      "sm": 480,
      "md": 640,
      "lg": 960
    },
    "dialog": {
      "sm": 400,
      "md": 560,
      "lg": 720,
      "xl": 960
    },
    "sidebar": {
      "expanded": 200,
      "collapsed": 52
    }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 100,
      "base": 150,
      "moderate": 200,
      "slow": 300
    },
    "easing": {
      "enter": "cubic-bezier(0.3, 0.8, 0.6, 1)",
      "exit": "cubic-bezier(0.7, 0.1, 0.75, 0.9)",
      "move": "cubic-bezier(0.6, 0, 0.2, 1)",
      "linear": "linear"
    }
  },
  "z": {
    "base": 0,
    "sticky": 10,
    "appBar": 1100,
    "drawer": 1200,
    "modal": 1300,
    "toast": 1400,
    "tooltip": 1500
  }
}
