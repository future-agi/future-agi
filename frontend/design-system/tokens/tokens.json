  "color": {
    "bg": {
      "canvas": {
        "light": "{gray.50}",
        "dark": "{gray.960}",
        "use": "App frame and sidebar. Panels sit on it."
      },
      "surface": {
        "light": "{gray.0}",
        "dark": "{gray.960}",
        "use": "Panels, cards, tables, page content. In dark it equals the canvas: one flat near-black, structure from hairlines."
      },
      "subtle": {
        "light": "{gray.50}",
        "dark": "{gray.940}",
        "use": "Table header, code, wells inside a surface."
      },
      "muted": {
        "light": "{gray.100}",
        "dark": "{gray.880}",
        "use": "Neutral badge fill, avatar, segmented track, skeleton."
      },
      "overlay": {
        "light": "{gray.0}",
        "dark": "{gray.925}",
        "use": "Menus, popovers, dialogs, drawers (lighter than surface in dark)."
      },
      "inverse": {
        "light": "{gray.900}",
        "dark": "{gray.50}",
        "use": "Tooltip, toast."
      },
      "hover": {
        "light": "rgba(24, 24, 27, 0.04)",
        "dark": "rgba(255, 255, 255, 0.05)",
        "use": "Row, menu item, ghost button hover. Alpha so it works on any surface."
      },
      "selected": {
        "light": "rgba(24, 24, 27, 0.06)",
        "dark": "rgba(255, 255, 255, 0.08)",
        "use": "Selected row, current nav item."
      },
      "pressed": {
        "light": "rgba(24, 24, 27, 0.08)",
        "dark": "rgba(255, 255, 255, 0.12)",
        "use": "Active press."
      },
      "backdrop": {
        "light": "rgba(9, 9, 11, 0.40)",
        "dark": "rgba(0, 0, 0, 0.60)",
        "use": "Behind dialogs and drawers."
      }
    },
    "border": {
      "subtle": {
        "light": "{gray.150}",
        "dark": "{gray.850}",
        "use": "Dividers inside a panel, such as key-value rows. Table rows use border.default."
      },
      "default": {
        "light": "{gray.200}",
        "dark": "{gray.825}",
        "use": "Panels, cards, inputs at rest, dividers. The one hairline."
      },
      "strong": {
        "light": "{gray.300}",
        "dark": "{gray.750}",
        "use": "Input hover, tree connectors, chart grid."
      },
      "focus": {
        "light": "{purple.500}",
        "dark": "{gray.0}",
        "use": "Focus ring and focused input border. Purple in light, white in dark."
      },
      "selected": {
        "light": "{purple.500}",
        "dark": "{gray.0}",
        "use": "Selected indicator: the tab and filter-tab underline. Purple in light, white in dark."
      }
    },
    "fg": {
      "default": {
        "light": "{gray.900}",
        "dark": "{gray.150}",
        "use": "Primary text: names, values, headings."
      },
      "secondary": {
        "light": "{gray.600}",
        "dark": "{gray.400}",
        "use": "Supporting text, cell values, descriptions in body."
      },
      "tertiary": {
        "light": "{gray.500}",
        "dark": "{gray.450}",
        "use": "Meta, timestamps, column headers, helper text. AA on surface."
      },
      "disabled": {
        "light": "{gray.400}",
        "dark": "{gray.600}",
        "use": "Disabled and placeholder only. Never for content."
      },
      "inverse": {
        "light": "{gray.50}",
        "dark": "{gray.900}",
        "use": "Text on bg.inverse."
