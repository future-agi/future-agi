    "control": {
      "checked": {
        "light": "{purple.500}",
        "dark": "{gray.150}",
        "use": "Fill of a checked checkbox, selected radio and on switch. Purple in light, white in dark, like the main button."
      },
      "onChecked": {
        "light": "#FFFFFF",
        "dark": "{gray.950}",
        "use": "Tick, dash and radio centre on control.checked; switch thumb when on."
