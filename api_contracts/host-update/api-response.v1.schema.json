{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "result"
  ],
  "properties": {
    "status": {
      "type": "boolean",
      "const": true
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_schema_version",
        "availability",
        "reason_code",
        "freshness",
        "age_seconds",
        "discovery_freshness",
        "versions_freshness",
        "progress_freshness",
        "snapshot"
      ],
      "properties": {
        "api_schema_version": {
          "type": "integer",
          "const": 1
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "unsupported"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "not_configured",
                "not_reported",
                "unreadable",
                "malformed",
                "unsupported_schema",
                "untrusted_file",
                "clock_skew",
                "installation_mismatch"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "age_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "discovery_freshness": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "versions_freshness": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "progress_freshness": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicStatusV1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:futureagi:host-update-status-response:1",
  "$defs": {
    "PublicStatusV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sequence",
        "generated_at",
        "installation",
        "versions",
        "policy",
        "automation",
        "discovery",
        "download",
        "operation",
        "last_run",
        "safety"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generated_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "format": "date-time"
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slot_id",
            "topology",
            "production"
          ],
          "properties": {
            "slot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[0-9a-f]{32}$"
            },
            "topology": {
              "type": "string",
              "enum": [
                "standalone",
                "distributed"
              ]
            },
            "production": {
              "type": "boolean"
            }
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_at",
            "runtime_state",
            "selected_release",
            "running_release",
            "components"
          ],
          "properties": {
            "observed_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "runtime_state": {
              "type": "string",
              "enum": [
                "consistent",
                "mixed",
                "unknown"
              ]
            },
            "selected_release": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^v(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})(-(beta|rc)\\.(0|[1-9][0-9]{0,17}))?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "running_release": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^v(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})(-(beta|rc)\\.(0|[1-9][0-9]{0,17}))?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "component",
                  "selected_version",
                  "observed_versions",
                  "observation"
                ],
                "properties": {
                  "component": {
                    "type": "string",
                    "enum": [
                      "standalone",
                      "backend",
                      "frontend",
                      "fi_collector",
                      "agentcc_gateway",
                      "serving",
                      "serving_gpu",
                      "code_executor",
                      "simulation_runner"
                    ]
                  },
                  "selected_version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^v(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})(-(beta|rc)\\.(0|[1-9][0-9]{0,17}))?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "observed_versions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^v(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})(-(beta|rc)\\.(0|[1-9][0-9]{0,17}))?$"
                    },
                    "minItems": 0,
                    "maxItems": 8,
                    "uniqueItems": true
                  },
                  "observation": {
                    "type": "string",
                    "enum": [
                      "known",
                      "unknown",
                      "not_deployed"
                    ]
                  }
                }
              },
              "minItems": 0,
              "maxItems": 9
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "version_policy",
            "check_interval_seconds"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "enum": [
                "stable",
                "beta"
              ]
            },
            "version_policy": {
              "type": "string",
              "enum": [
                "patch",
                "minor",
                "major"
              ]
            },
            "check_interval_seconds": {
              "type": "integer",
              "minimum": 300,
              "maximum": 86400
            }
          }
        },
        "automation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "enabled",
            "state",
            "paused_until",
            "pause_indefinite",
            "maintenance_window",
            "last_tick_at",
            "next_check_at",
            "next_action_at"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "manual",
                "notify",
                "download",
                "apply"
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "state": {
              "type": "string",
              "enum": [
                "not_implemented",
                "disabled",
                "manual",
                "enabled",
                "paused",
                "blocked"
              ]
            },
            "paused_until": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pause_indefinite": {
              "type": "boolean"
            },
            "maintenance_window": {
              "anyOf": [
                {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "timezone"
                      ],
                      "properties": {
                        "kind": {
                          "const": "always",
                          "type": "string"
                        },
                        "timezone": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "timezone",
                        "days_of_week",
                        "start",
                        "end"
                      ],
                      "properties": {
                        "kind": {
                          "const": "interval",
                          "type": "string"
                        },
                        "timezone": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "days_of_week": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 7
                          },
                          "minItems": 1,
                          "maxItems": 7,
                          "uniqueItems": true
                        },
                        "start": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 5,
                          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "end": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 5,
                          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_tick_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "next_check_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "next_action_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "last_attempt_at",
            "checked_at",
            "candidate_version",
            "verification",
            "reason_codes"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not_checked",
                "current",
                "available",
                "blocked",
                "failed"
              ]
            },
            "last_attempt_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "checked_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "candidate_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^v(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})(-(beta|rc)\\.(0|[1-9][0-9]{0,17}))?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "verification": {
              "type": "string",
              "enum": [
                "not_checked",
                "verified",
                "rejected"
              ]
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "manifest_unavailable",
                  "signature_rejected",
                  "channel_mismatch",
                  "version_policy_blocked",
                  "release_incomplete",
                  "discovery_incomplete",
                  "immutable_release_changed",
                  "network_unavailable",
                  "rate_limited",
                  "cache_invalid",
                  "ownership_unconfirmed",
                  "deployment_files_mismatch",
                  "required_env_missing",
                  "unsupported_contract",
                  "uncertified_release",
                  "configuration_changed",
                  "backup_required",
                  "backup_failed",
                  "backup_proof_invalid",
                  "backup_expired",
                  "stale_stage",
                  "env_conflict",
                  "initialization_required",
                  "manual_stage_present",
                  "recovery_required",
                  "readiness_failed",
                  "operation_interrupted",
                  "operation_timeout",
                  "rollback_ineligible",
                  "rollback_failed",
                  "failed_target_latched",
                  "running_versions_unknown",
                  "mixed_running_versions",
                  "outside_window",
                  "insufficient_window",
                  "clock_skew",
                  "timezone_unavailable",
                  "host_verifier_required",
                  "image_digest_mismatch",
                  "disk_space_insufficient",
                  "status_reporting_unavailable",
                  "scheduler_unregistered",
                  "unsupported_installation",
                  "control_invalid",
                  "process_failed"
                ]
              },
              "minItems": 0,
              "maxItems": 12,
              "uniqueItems": true
            }
          }
        },
        "download": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "target_version",
            "completed_at",
            "verified_components",
            "reason_codes"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not_downloaded",
                "downloading",
                "downloaded",
                "failed",
                "unknown"
              ]
            },
            "target_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^v(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})(-(beta|rc)\\.(0|[1-9][0-9]{0,17}))?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "completed_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "verified_components": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "standalone",
                  "backend",
                  "frontend",
                  "fi_collector",
                  "agentcc_gateway",
                  "serving",
                  "serving_gpu",
                  "code_executor",
                  "simulation_runner"
                ]
              },
              "minItems": 0,
              "maxItems": 9,
              "uniqueItems": true
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "manifest_unavailable",
                  "signature_rejected",
                  "channel_mismatch",
                  "version_policy_blocked",
                  "release_incomplete",
                  "discovery_incomplete",
                  "immutable_release_changed",
                  "network_unavailable",
                  "rate_limited",
                  "cache_invalid",
                  "ownership_unconfirmed",
                  "deployment_files_mismatch",
                  "required_env_missing",
                  "unsupported_contract",
                  "uncertified_release",
                  "configuration_changed",
                  "backup_required",
                  "backup_failed",
                  "backup_proof_invalid",
                  "backup_expired",
                  "stale_stage",
                  "env_conflict",
                  "initialization_required",
                  "manual_stage_present",
                  "recovery_required",
                  "readiness_failed",
                  "operation_interrupted",
                  "operation_timeout",
                  "rollback_ineligible",
                  "rollback_failed",
                  "failed_target_latched",
                  "running_versions_unknown",
                  "mixed_running_versions",
                  "outside_window",
                  "insufficient_window",
                  "clock_skew",
                  "timezone_unavailable",
                  "host_verifier_required",
                  "image_digest_mismatch",
                  "disk_space_insufficient",
                  "status_reporting_unavailable",
                  "scheduler_unregistered",
                  "unsupported_installation",
                  "control_invalid",
                  "process_failed"
                ]
              },
              "minItems": 0,
              "maxItems": 12,
              "uniqueItems": true
            }
          }
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "kind",
            "stage",
            "started_at",
            "finished_at",
            "reported_at",
            "reason_codes"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "idle",
                "checking",
                "downloading",
                "backing_up",
                "staged",
                "awaiting_initialization",
                "applying",
                "verifying",
                "succeeded",
                "failed",
                "interrupted",
                "rolling_back",
                "rolled_back",
                "blocked",
                "unknown"
              ]
            },
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "check",
                    "download",
                    "apply",
                    "rollback"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "stage": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "planning",
                    "backup",
                    "image_fetch",
                    "image_verification",
                    "env_selection",
                    "production_initialization",
                    "rollout",
                    "readiness",
                    "recovery"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "started_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "finished_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reported_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "manifest_unavailable",
                  "signature_rejected",
                  "channel_mismatch",
                  "version_policy_blocked",
                  "release_incomplete",
                  "discovery_incomplete",
                  "immutable_release_changed",
                  "network_unavailable",
                  "rate_limited",
                  "cache_invalid",
                  "ownership_unconfirmed",
                  "deployment_files_mismatch",
                  "required_env_missing",
                  "unsupported_contract",
                  "uncertified_release",
                  "configuration_changed",
                  "backup_required",
                  "backup_failed",
                  "backup_proof_invalid",
                  "backup_expired",
                  "stale_stage",
                  "env_conflict",
                  "initialization_required",
                  "manual_stage_present",
                  "recovery_required",
                  "readiness_failed",
                  "operation_interrupted",
                  "operation_timeout",
                  "rollback_ineligible",
                  "rollback_failed",
                  "failed_target_latched",
                  "running_versions_unknown",
                  "mixed_running_versions",
                  "outside_window",
                  "insufficient_window",
                  "clock_skew",
                  "timezone_unavailable",
                  "host_verifier_required",
                  "image_digest_mismatch",
                  "disk_space_insufficient",
                  "status_reporting_unavailable",
                  "scheduler_unregistered",
                  "unsupported_installation",
                  "control_invalid",
                  "process_failed"
                ]
              },
              "minItems": 0,
              "maxItems": 12,
              "uniqueItems": true
            }
          }
        },
        "last_run": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "automatic",
                "outcome",
                "from_version",
                "target_version",
                "finished_at",
                "fallback_outcome"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "apply",
                    "rollback"
                  ]
                },
                "automatic": {
                  "type": "boolean"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "succeeded",
                    "staged",
                    "rolled_back",
                    "failed_before_rollout",
                    "failed_during_rollout",
                    "interrupted_before_rollout",
                    "interrupted_during_rollout",
                    "blocked"
                  ]
                },
