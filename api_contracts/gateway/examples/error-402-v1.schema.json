{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futureagi.com/contracts/gateway/examples/error-402-v1.schema.json",
  "title": "error-402-v1",
  "description": "Payment and limit refusals (plan section 6.10): the 402 rows, the 429 managed_spend_velocity and the 503 rows. A limit refusal names its limit_source, scope and resets_at (null when the limit lifts only on a top-up, a grant or a new run). The 503 rows carry no limit_source; managed_billing_unavailable names a reason. A managed_spend_velocity refusal with reason request_exceeds_minute_cap, request_exceeds_hour_cap or new_org_daily_cap carries only that fixed reason, no amounts, scope, reset or Retry-After. The new-org daily refusal explains the daily spending limit for Future AGI credits and directs the caller to contact support to raise it. Retry-After for other window refusals is a header, not a body field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "message", "param", "metadata"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "code": {
          "type": "string",
          "enum": [
            "managed_credits_exhausted",
            "managed_credits_insufficient",
            "managed_spend_paused",
            "agent_budget_exhausted",
            "tool_budget_exhausted",
            "agent_call_cap_exceeded",
            "call_cap_unenforceable",
            "run_budget_unenforceable",
            "key_limit_exceeded",
            "managed_spend_velocity",
            "managed_billing_unavailable",
            "agent_run_stopped",
            "managed_upstream_key_missing"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "param": { "type": "null" },
        "metadata": { "$ref": "#/$defs/Metadata" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "code": { "const": "tool_budget_exhausted" } }
          },
          "then": {
            "properties": {
              "metadata": {
                "required": ["kind", "remaining"],
                "properties": {
                  "limit_source": { "const": "agentcc_tool_budget" },
                  "scope": { "pattern": "^run:.+$" },
                  "resets_at": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "code": {
                    "enum": [
                      "managed_billing_unavailable",
                      "managed_upstream_key_missing"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "metadata": {
                    "required": ["reason"],
                    "properties": {
                      "reason": {
                        "enum": [
                          "request_exceeds_minute_cap",
                          "request_exceeds_hour_cap",
                          "new_org_daily_cap"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "metadata": { "not": { "required": ["limit_source"] } }
            }
          },
          "else": {
            "properties": {
              "metadata": {
                "required": [
                  "limit_source",
                  "remedy_hint",
                  "scope",
                  "resets_at"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "managed_billing_unavailable" } }
          },
          "then": { "properties": { "metadata": { "required": ["reason"] } } }
        },
        {
          "if": {
            "properties": {
              "metadata": {
                "required": ["reason"],
                "properties": {
                  "reason": {
                    "enum": [
                      "request_exceeds_minute_cap",
                      "request_exceeds_hour_cap",
                      "new_org_daily_cap"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "code": { "const": "managed_spend_velocity" },
              "metadata": { "maxProperties": 1 }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit_source": {
          "type": "string",
          "enum": [
            "agentcc_credits",
            "agentcc_in_flight",
            "agentcc_budget",
            "agentcc_agent_budget",
            "agentcc_tool_budget",
            "agentcc_call_cap",
            "agentcc_key_limit",
            "agentcc_spend_guard",
            "agentcc_run_stop"
          ]
        },
        "remedy_hint": { "type": "string" },
        "kind": { "type": "string", "enum": ["calls", "usd"] },
        "remaining": { "type": "number", "minimum": 0 },
        "required_usd": { "type": "number", "minimum": 0 },
        "available_usd": { "type": "number" },
        "scope": {
          "type": "string",
          "pattern": "^(org|key:[^:]+(:parallel)?|team:.+|user:.+|run:.+)$"
        },
        "resets_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "redis_unavailable",
            "account_state_missing",
            "request_exceeds_minute_cap",
            "request_exceeds_hour_cap",
            "new_org_daily_cap"
          ]
        }
      }
    }
  }
}
