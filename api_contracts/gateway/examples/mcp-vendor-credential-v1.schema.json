{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futureagi.com/contracts/gateway/examples/mcp-vendor-credential-v1.schema.json",
  "title": "mcp-vendor-credential-v1",
  "description": "Gateway-only POST /agentcc/mcp/vendors/internal/credential/ using X-Agentcc-MCP-Internal, distinct from every admin token. Disabled by default. Answers are no-store. Microsoft's hold (hold) is a Refusal with error microsoft_coming_soon sent as HTTP 409, whose message the gateway uses as the text of the call's refusal. Gateway caching and execution wait for W4 integration; Django keeps platform credentials and encrypted sessions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "pipedream", "composio", "refusal"],
  "properties": {
    "request": { "$ref": "#/$defs/Request" },
    "pipedream": { "$ref": "#/$defs/Pipedream" },
    "composio": { "$ref": "#/$defs/Composio" },
    "refusal": { "$ref": "#/$defs/Refusal" },
    "hold": { "$ref": "#/$defs/Refusal" }
  },
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["org_id", "server_id", "vendor", "end_user"],
      "properties": {
        "org_id": { "type": "string", "format": "uuid" },
        "server_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "vendor": { "enum": ["pipedream", "composio"] },
        "end_user": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "id"],
          "properties": {
            "source": { "enum": ["member", "asserted"] },
            "id": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "refresh": {
          "type": "boolean",
          "description": "Reserved for W4 cache revalidation; never permits an inactive connection."
        }
      }
    },
    "Success": {
      "oneOf": [{ "$ref": "#/$defs/Pipedream" }, { "$ref": "#/$defs/Composio" }]
    },
    "Pipedream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "access_token",
        "expires_at",
        "project_id",
        "environment",
        "app_slug",
        "external_user_id",
        "credential_version"
      ],
      "properties": {
        "vendor": { "const": "pipedream" },
        "access_token": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "project_id": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["development", "production"] },
        "app_slug": { "type": "string", "minLength": 1 },
        "external_user_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "credential_version": { "type": "integer", "minimum": 1 }
      }
    },
    "Composio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "api_key", "endpoint", "credential_version"],
      "properties": {
        "vendor": { "const": "composio" },
        "api_key": { "type": "string", "minLength": 1 },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "Minted URL only, restricted to the configured server and API base origin. Never construct from a session id."
        },
        "expires_at": { "type": "string", "format": "date-time" },
        "credential_version": { "type": "integer", "minimum": 1 }
      }
    },
    "Refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "enum": [
            "no_credential",
            "not_connected",
            "needs_reauth",
            "revoked",
            "expired",
            "identity_refused",
            "microsoft_coming_soon"
          ]
        },
        "connect_hint": { "type": "string" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Plain text for the caller, never a secret. Django sends it on Microsoft's hold (error microsoft_coming_soon, HTTP 409); the gateway makes it the text of the call's refusal, with control and format characters dropped, each run of whitespace made one space and at most 300 characters, and keeps its own text when there is none. The gateway reads it on no other refusal."
        }
      }
    }
  }
}
