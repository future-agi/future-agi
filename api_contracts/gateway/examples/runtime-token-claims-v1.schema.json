{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futureagi.com/contracts/gateway/examples/runtime-token-claims-v1.schema.json",
  "title": "runtime-token-claims-v1",
  "description": "A Future AGI managed-runtime token (plan section 6.12): its JWT header ($defs/Header) and claims ($defs/Claims). exp - iat must not exceed runtime_tokens.max_ttl (15 min); the gateway checks that, not this schema. org_id, deployment_id and agent_id are authoritative. root_run_id is the root of the run scope: a call with no run header runs as the root, and a header run-id may name a descendant. budget_scope defaults to root_run_id; headers can only lower budget_usd. Scope gateway:mcp admits /mcp and /mcp/v/*. sponsor_user_id, grant_id and act are optional; G33 verifies them and exposes them in rc.Runtime, and P3 reads them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "claims"],
  "properties": {
    "header": { "$ref": "#/$defs/Header" },
    "claims": { "$ref": "#/$defs/Claims" }
  },
  "$defs": {
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "run_id"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "deployment_id": { "type": "string" }
      }
    },
    "Header": {
      "type": "object",
      "required": ["alg", "kid"],
      "properties": {
        "alg": { "type": "string", "enum": ["RS256", "ES256"] },
        "kid": { "type": "string", "minLength": 1 },
        "typ": { "type": "string" }
      }
    },
    "Claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typ",
        "iss",
        "aud",
        "iat",
        "nbf",
        "exp",
        "jti",
        "org_id",
        "deployment_id",
        "agent_id",
        "root_run_id",
        "scopes"
      ],
      "properties": {
        "typ": { "const": "futureagi-runtime-token" },
        "iss": { "type": "string", "minLength": 1 },
        "aud": { "type": "string", "minLength": 1 },
        "iat": { "type": "integer", "minimum": 0 },
        "nbf": { "type": "integer", "minimum": 0 },
        "exp": { "type": "integer", "minimum": 0 },
        "jti": { "type": "string", "minLength": 1 },
        "org_id": { "type": "string", "minLength": 1 },
        "deployment_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 },
        "workspace_id": { "type": "string" },
        "agent_version": { "type": "string" },
        "env": { "type": "string" },
        "framework": { "type": "string" },
        "root_run_id": { "type": "string", "minLength": 1 },
        "parent_run_id": { "type": "string" },
        "session_id": { "type": "string" },
        "budget_scope": { "type": "string" },
        "budget_usd": { "type": "number", "minimum": 0 },
        "billing_mode": {
          "type": "string",
          "enum": ["byok", "managed", "any"]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "gateway:chat",
              "gateway:responses",
              "gateway:messages",
              "gateway:embeddings",
              "gateway:models",
              "gateway:mcp"
            ]
          }
        },
        "sponsor_user_id": {
          "type": "string",
          "minLength": 1,
          "description": "The human the token acts for (P3)."
        },
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "description": "The standing grant the token runs under (P3)."
        },
        "act": {
          "type": "array",
          "description": "The actor chain, oldest first: each agent and run between the sponsor and this token (P3, identity-chain-v1).",
          "items": { "$ref": "#/$defs/Actor" }
        },
        "key_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_models": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowed_providers": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
