  "request": {
    "model": "typesafe/jev-1.13.0",
    "state": { "ticket": "private-state-CANARY", "count": 987654321 },
    "questions": {
      "resolved": {
        "type": "noul",
        "instructions": "private-instructions-CANARY",
        "criteria": { "true": "private-criteria-CANARY", "false": "Unresolved" }
      }
    }
  },
