# Omega gateway: local loopback stack template (no credentials).
#
# Copy to a file outside the repository and point the gateway at it, e.g.
#   env $(grep -v '^#' local.env | xargs) node services/omega-gateway/src/server.mjs
# Every address must be loopback; local mode refuses anything else and binds
# 127.0.0.1. The Vite dev server (http://localhost:3031) should proxy
# /omega/api/* to this gateway WITHOUT rewriting the path.
OMEGA_GATEWAY_MODE=local
PORT=8088
OMEGA_GATEWAY_BASE_PATH=/omega/api
# Omega EE daemon (lane ee-sandboxes / deploy build), loopback only.
OMEGA_REMOTE_BASE_URL=http://127.0.0.1:4318
# FutureAGI Django backend session exchange (bin/dev), loopback only.
OMEGA_SESSION_EXCHANGE_URL=http://127.0.0.1:8000/accounts/omega/session-exchange/
OMEGA_ALLOWED_ORIGINS=http://localhost:3031
# Optional: public JWKS (never a private key) matching
# OMEGA_SQUAD_DELEGATION_KEY_ID, so the gateway verifies signatures itself.
# OMEGA_ASSERTION_JWKS_FILE=/absolute/path/outside/repo/host-assertions.jwks.json
# OMEGA_ASSERTION_ISSUER=https://localhost/omega
# Rate limits: without a Redis URL this process keeps its own buckets (local mode only).
# OMEGA_GATEWAY_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379
# Spans to a local Future AGI Observe project (key pair in a 0600 JSON file outside the repo).
# OMEGA_GATEWAY_OTLP_TRACES_URL=http://127.0.0.1:4318/v1/traces
# OMEGA_GATEWAY_OTLP_CREDENTIALS_FILE=/absolute/path/outside/repo/otlp.json
# The Console-origin listener (needs OMEGA_ASSERTION_JWKS_FILE).
# OMEGA_CONSOLE_ORIGIN=http://127.0.0.1:3032
# OMEGA_CONSOLE_PORT=8089
# OMEGA_CONSOLE_STATIC_DIR=/absolute/path/to/console/dist
