      "product": ["console", "sandboxes"]
    },
    { "prefix": "/workspace/deployments", "product": "deployments" },
    {
      "prefix": "/workspace/credentials",
      "product": ["console", "deployments"]
    },
    { "prefix": "/workspace/audit", "product": "console" },
    { "prefix": "/workspace/kill-switch", "product": "console" },
