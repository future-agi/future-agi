    { "prefix": "/workspace/learning", "product": "console" },
    { "prefix": "/workspace/conversations", "product": "console" },
    { "prefix": "/workspace/workforce", "product": "console" },
    { "prefix": "/workspace/agent-teams", "product": "console" },
    { "prefix": "/workspace/skills", "product": "console" },
    { "prefix": "/workspace/approvals", "product": "console" },
    { "prefix": "/workspace/environments", "product": "console" },
    { "prefix": "/workspace/schedules", "product": "console" },
