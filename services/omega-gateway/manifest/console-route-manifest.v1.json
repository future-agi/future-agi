{
  "schemaVersion": "console-route-manifest/v1",
  "about": "routes: every browser route the Future AGI host may reach through its gateway with a host assertion. One copy lives in Future AGI services/omega-gateway/manifest/, a byte-identical copy in Omega EE packages/server/src/managed-auth/. Each wall admits exactly these method and path pairs and refuses everything else (default deny). eeOnly: host-delegated routes Omega EE serves to direct host clients (the Squad gateway, the interop harness) that no Future AGI screen reaches. The Future AGI gateway admits none of them, and each family is retired when its /workspace projection lands (CP C2-C5 memory, E3 and E6 connectors). Closed in both lists: member and invite writes and every billing write (CP P4, D5), and the pause, resume, stop and kill verbs (D20). Conversation DELETE stays open to members (CP B9). A param named in scopeParams must equal that field of the caller's host scope. hidden: features the Console does not show (the embedded Console's shownFeatures registry reads this list, so it is one switch for screens and API). Every route whose path is one of a feature's paths or under it stays listed in routes with its classes, but the gateway (W2) and EE (W3) answer it 404 not_found for every role, as EE answers an app that is not offered, and never forward or serve it. Deleting a feature's entry turns its screens and its routes back on together.",
  "params": {
    "id": "[^/]+",
    "artifact": "[^/]+",
    "revision": "[1-9][0-9]*",
    "deployment": "dep-[0-9a-f]{16}",
    "sandbox": "(?!settings(?:/|$))[^/]+",
    "computerId": "cmp_[a-f0-9]{24}",
    "schedule": "(?!events(?:/|$))[^/]+",
    "filePath": "[^/]+(?:/[^/]+)*",
    "terminal": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
    "org": "[^/]+",
    "connector": "(?!(?:host-logins|build)(?:/|$))[^/]+",
    "rest": "[^/]+(?:/[^/]+)*"
  },
  "scopeParams": { "org": "orgId" },
  "classes": {
    "role": ["member", "admin", "owner"],
    "body": ["none", "json", "bundle"],
    "timeout": ["read", "write", "model", "stream"],
    "rate": ["read", "write", "model-start", "channel", "trigger-ingress"]
  },
  "hidden": {
    "agent-teams": {"until":"a Console screen makes a named group of agents and gives it work (no lane owns it)","paths":["/workspace/agent-teams"]},
    "environments": {"until":"Console Settings make and change environments (E-SETTINGS I3) and a sandbox can start from one (the Sandboxes tab's Environment source)","paths":["/workspace/environments"]},
    "signed-triggers": {"until":"signed event journeys pass on the composed Console stack and the feature is enabled","paths":["/workspace/triggers"]},
    "skills": {"until":"Not offered in this release.","paths":["/workspace/skills"]},
    "schedules": {"until":"Not offered in this release.","paths":["/workspace/schedules"]},
    "learning-lessons": {"until":"Learning controls are not offered in this release.","paths":["/workspace/learning"]},
    "integrations": {"until":"Integrations are not offered in this release.","paths":["/workspace/integrations"]}
  },
