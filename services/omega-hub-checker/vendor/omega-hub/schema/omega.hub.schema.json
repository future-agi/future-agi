{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futureagi.com/schemas/omega-hub-v1.json",
  "title": "Omega Hub entry (omega-hub/v1)",
  "description": "One entry of the Omega Hub: hub/<id>/omega.hub.json. The validator in @omega/hub (omega hub check) is the judge; this schema gives editors the same shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "tagline",
    "kind",
    "cover",
    "author",
    "tags",
    "difficulty",
    "license",
    "added",
    "models",
    "run",
    "test",
    "demo"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "omega-hub/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$"
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 60,
      "pattern": "^[^`<>\\[\\]\\r\\n]*$"
    },
    "tagline": {
      "type": "string",
      "minLength": 20,
      "maxLength": 120,
      "pattern": "^[^`<>\\[\\]\\r\\n]*$"
    },
    "kind": {
      "enum": [
        "app",
        "agent",
        "team",
        "skill",
        "plugin",
        "mcp",
        "workflow"
      ]
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emoji",
        "from",
        "to"
      ],
      "properties": {
        "emoji": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "from": {
          "enum": [
            "red",
            "yellow",
            "green",
            "blue",
            "indigo",
            "purple",
            "pink",
            "gray"
          ]
        },
        "to": {
          "enum": [
            "red",
            "yellow",
            "green",
            "blue",
            "indigo",
            "purple",
            "pink",
            "gray"
          ]
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github",
        "kind"
      ],
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "kind": {
          "enum": [
            "maintainer",
            "community"
          ]
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,23}$"
      }
    },
    "difficulty": {
      "enum": [
        "starter",
        "intermediate",
        "advanced"
      ]
    },
    "license": {
      "enum": [
        "MIT",
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "ISC",
        "MPL-2.0",
        "CC0-1.0",
        "Unlicense"
      ]
    },
    "added": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "remix_of": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9-]{2,39}|https://github\\.com/\\S+)$"
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyless"
      ],
      "properties": {
        "keyless": {
          "enum": [
            "scripted",
            "recorded",
            "echo",
            "none"
          ]
        },
        "live": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "keys"
            ],
            "properties": {
              "model": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._@/:-]{0,99}$"
              },
              "keys": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
                }
              },
              "checked": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        "maxCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "if": {
        "properties": {
          "live": {
            "minItems": 1
          }
        },
        "required": [
          "live"
        ]
      },
      "then": {
        "required": [
          "maxCalls"
        ]
      }
    },
    "keys": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "why",
          "get",
          "for",
          "secret"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "why": {
            "type": "string",
            "minLength": 10,
            "maxLength": 100
          },
          "get": {
            "type": "string",
            "pattern": "^https://"
          },
          "for": {
            "enum": [
              "live",
              "service"
            ]
          },
          "secret": {
            "type": "boolean"
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^>=\\d+(?:\\.\\d+){0,2}$"
        },
        "bins": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,39}$"
          }
        },
        "playwright": {
          "type": "boolean"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyless"
      ],
      "properties": {
        "keyless": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "prefixItems": [
            {
              "const": "node"
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "live": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "prefixItems": [
            {
              "const": "node"
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "test": {
      "type": "string",
      "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\\\]+\\.test\\.(?:ts|mjs)$"
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cast"
      ],
      "properties": {
        "cast": {
          "type": "string",
          "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\\\]+\\.cast$"
        },
        "redact": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "caption": {
          "type": "string",
          "minLength": 20,
          "maxLength": 140
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "plugin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "skillpack": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "command"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,39}$"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "files": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
      }
    },
    "featured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week",
        "why"
      ],
      "properties": {
        "week": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "why": {
          "type": "string",
          "minLength": 20,
          "maxLength": 140
        }
      }
    },
    "hidden": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "skill"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "install"
        ],
        "properties": {
          "install": {
            "required": [
              "skillpack"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plugin"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "install"
        ],
        "properties": {
          "install": {
            "required": [
              "plugin"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mcp"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "install"
        ],
        "properties": {
          "install": {
            "required": [
              "mcp"
            ]
          }
        }
      }
    }
  ]
}
