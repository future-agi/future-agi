# Not part of the packaged chart. LICENSE, README.md, values.schema.json,
# examples/ (the README uses it) and files/ ship; helm-ci.yml runs every check
# against the packaged .tgz, so a pattern here that drops one of them fails CI.
.DS_Store
.git/
.gitignore
*.swp
*.bak
*.tmp
*.orig
*~
.idea/
.vscode/
# Release outputs that may sit next to the chart during a local package.
*.tgz
*.prov
*.sigstore.json
# Maintenance scripts and CI value sets.
hack/
ci/
