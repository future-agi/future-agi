      "variables": ["INTEGRATION_ENCRYPTION_KEY"],
      "path": "bin/lib/secrets.sh",
      "language": "shell",
      "symbol": "gen_fernet_key",
      "entrypoint": "write_secrets",
      "availability": "every_install",
      "reason": "The installer fills an absent Fernet key without replacing an existing key."
    },
    {
      "variables": ["AGENTCC_WEBHOOK_SECRET", "REDIS_PASSWORD"],
      "path": "bin/lib/secrets.sh",
      "language": "shell",
      "symbol": "gen_secret",
      "entrypoint": "write_secrets",
      "availability": "every_install",
      "reason": "The installer fills absent webhook and Standalone Redis credentials; existing values are retained."
    }
  ]
}
