{
  "schema_version": 1,
  "generators": [
    {
      "variables": ["SECRET_KEY", "PG_PASSWORD", "MINIO_ROOT_PASSWORD", "AGENTCC_INTERNAL_API_KEY", "AGENTCC_ADMIN_TOKEN", "CH_PASSWORD"],
      "path": "bin/lib/secrets.sh",
      "language": "shell",
      "symbol": "gen_secret",
      "entrypoint": "write_secrets",
      "availability": "fresh_install",
      "reason": "The installer generates these only for a fresh installation; retained credentials must not be rotated on update."
