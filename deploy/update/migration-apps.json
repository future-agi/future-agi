{
  "schema_version": 1,
  "image_backend_root": "/app/backend",
  "library_root": "sysconfig.purelib",
  "supported_settings": "tfc.settings.settings",
  "oss_environment": {
    "ENV_TYPE": "local",
    "EE_LICENSE_KEY": "",
    "NO_STARTUP_DB_MUTATIONS": "true",
    "FI_SKIP_CH25_MIGRATION": "1"
  },
  "unsupported_conditionals": [
    "ee.falcon_ai: ee_feature_enabled; EE mode is not the base OSS automatic layout",
    "ee.cloud.control_plane: has_ee AND is_cloud_env; Cloud is unsupported"
  ],
  "apps": [
