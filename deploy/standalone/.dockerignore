# The build context is this directory (docker build deploy/standalone), never the
# repo root. ClickHouse settings are bind-mounted by docker-compose.yml.
clickhouse/
# Bytecode the tests leave next to bin/bootstrap.py.
**/__pycache__

# Private updater state contains complete retained env files (including secrets).
# Keep this recursive exclusion LAST: later negations must not re-include it.
**/.futureagi-updates/
