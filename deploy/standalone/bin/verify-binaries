#!/usr/bin/env python
"""Check that every binary bundled in futureagi/standalone is this
architecture's and starts: a single-arch source image would otherwise put an
x86 binary in the arm64 image. Also imports the Python packages the image
adds to the backend's. Run inside the image by standalone-ci.yml and, before
any tag moves, by release-images.yml."""

import os
import platform
import shutil
import subprocess
import sys

machine = {"x86_64": 0x3E, "aarch64": 0xB7}[platform.machine()]
failed = []
for argv in (
    ["fi-collector", "--help"],
    ["agentcc-gateway", "--help"],
    ["temporal", "--version"],
    ["minio", "--version"],
    ["redis-server", "--version"],
    ["nginx", "-v"],
    ["supervisord", "--version"],
):
    path = shutil.which(argv[0])
    if path is None:
        failed.append(f"{argv[0]}: not on PATH")
        continue
    with open(os.path.realpath(path), "rb") as binary:
        head = binary.read(20)
    if head[:4] == b"\x7fELF" and int.from_bytes(head[18:20], "little") != machine:
        failed.append(f"{argv[0]}: built for another architecture")
        continue
    try:
        subprocess.run(
            argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10
        )
    except subprocess.TimeoutExpired:
        pass  # it started and kept running
    except OSError as exc:
        failed.append(f"{argv[0]}: {exc}")
        continue
    print(f"ok  {path}")
import channels_redis  # noqa: E402, F401
import falcon  # noqa: E402, F401
import gunicorn  # noqa: E402, F401

sys.exit("\n".join(failed) or None)
