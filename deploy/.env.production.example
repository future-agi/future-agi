# Production environment for self-hosted Future AGI.
# For a NEW configuration only, copy to deploy/.env.production and fill in.
# For retained installations, preserve the existing file and installed credentials.
# Boot ONLY after separately approved schema/mirror initialization (see README.md):
#
#   docker compose --env-file deploy/.env.production \
#     -f docker-compose.distributed.yml -f deploy/docker-compose.production.yml up -d --no-build --wait --wait-timeout 1200
#
# The production overlay refuses to boot if any REQUIRED value is empty.

# ---- REQUIRED — generate with: openssl rand -hex 32 ----
SECRET_KEY=
AGENTCC_INTERNAL_API_KEY=
AGENTCC_ADMIN_TOKEN=

# ---- REQUIRED — DB / storage credentials ----
PG_PASSWORD=
MINIO_ROOT_PASSWORD=
# Already provisioned catalog identities: reuse the exact installed passwords.
# Never generate replacements for retained indexes; setup does not rotate them.
# Setup safely quotes supplied values, including trailing backslashes and quotes.
# Validate manually edited dotenv values with daemon-free `compose config --quiet`.
PROPERTY_CATALOG_API_PASSWORD=
PROPERTY_CATALOG_CONSUMER_PASSWORD=

# ---- REQUIRED — pin a specific release per image ----
# Each service has an independent version. Don't run `:latest` in prod.
FUTURE_AGI_VERSION=
FRONTEND_VERSION=
# No default/local release: supply the reviewed collector/consumer/backfill image.
# A verified tag@sha256:<digest> suffix can pin the registry content explicitly.
FI_COLLECTOR_VERSION=
AGENTCC_GATEWAY_VERSION=
SERVING_VERSION=
CODE_EXECUTOR_VERSION=
# Dedicated SDK image, not the backend image. Required even before enabling its profile.
SIMULATION_RUNNER_VERSION=

# ---- REQUIRED — public URLs ----
# FRONTEND_URL drives digest-email and OAuth links.
# VITE_HOST_API is the URL the browser uses to reach backend.
FRONTEND_URL=https://app.your-domain.com
VITE_HOST_API=https://api.your-domain.com
# Invite and password-reset links and other app emails; the same URL as
# FRONTEND_URL. Unset, they point at localhost:3000.
APP_URL=https://app.your-domain.com
# Where SDKs send traces (their FI_BASE_URL): your proxy in front of the
# collector's OTLP/HTTP port. Unset, the app shows http://localhost:4318.
# FI_COLLECTOR_PUBLIC_URL=https://otlp.your-domain.com

# ---- Optional — full list in ../.env.example ----
# Fernet key for stored integration credentials. Connecting an integration
# fails without it; keep it once set (a new key cannot decrypt old data).
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
INTEGRATION_ENCRYPTION_KEY=
# Where workers post live updates for the browser. The default reaches the
# backend service inside the Compose network; BASE_URL/FRONTEND_URL stay the
# public URLs. Set it only when the backend runs under another name or port.
# WEBSOCKET_ENDPOINT=http://backend/call-websocket/
# Deployment telemetry (docs/telemetry.md). true opts out; one minimal
# registration (instance id, version, deployment type, timestamp) remains.
FUTURE_AGI_TELEMETRY_DISABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
