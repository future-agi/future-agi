<!-- The password of ClickHouse's default user in both Compose setups:
     CH_PASSWORD from .env, which the compose files hand to the container as
     CLICKHOUSE_PASSWORD. Empty keeps the upstream password-less default user,
     as installs made before ./bin/install generated one still run. -->
<clickhouse>
    <users>
        <default>
            <password from_env="CLICKHOUSE_PASSWORD"/>
        </default>
    </users>
</clickhouse>
