# Future AGI — self-hosted configuration.
# Everything in this file is OPTIONAL. An empty .env runs the full stack on
# safe local-only defaults. For production, see ./deploy/README.md.

# Stack mode. Unset = light (roughly 17 steady-state containers after
# one-shot bootstrap jobs finish). `full` additionally enables PeerDB CDC.
# COMPOSE_PROFILES=full

# ClickHouse database for the v1 read path, the CH25 schema/read path, and the
# fi-collector writer. CH25_DATABASE and FI_CH_DATABASE both cascade from this,
# so overriding it here points all three at the same DB.
CH_DATABASE=default

# Each image has an independent version. Empty = use `:latest`. Pin per
# service to lock a specific release.
FUTURE_AGI_VERSION=
# The OSS collector is built from ./fi-collector by default. Override this
# tag only when intentionally testing a separately published collector image.
FI_COLLECTOR_VERSION=local
FRONTEND_VERSION=
AGENTCC_GATEWAY_VERSION=
SERVING_VERSION=
CODE_EXECUTOR_VERSION=

# ---- Unified property catalog (OSS default-on) ----
# Kafka is loopback-bound on the host and uses the internal listener between
# containers. All limits are Compose-overridable without editing YAML.
PROPERTY_CATALOG_KAFKA_PORT=29092
PROPERTY_CATALOG_KAFKA_CPUS=1.0
PROPERTY_CATALOG_KAFKA_MEMORY=1G
PROPERTY_CATALOG_KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
PROPERTY_CATALOG_CANDIDATE_KAFKA_TOPIC=futureagi.oss.property-catalog.candidates.v1
PROPERTY_CATALOG_ORDERED_KAFKA_TOPIC=futureagi.oss.property-catalog.ordered.v1
FI_COLLECTOR_CPUS=1.0
FI_COLLECTOR_MEMORY=1G
PROPERTY_CATALOG_SEQUENCER_CPUS=0.5
PROPERTY_CATALOG_SEQUENCER_MEMORY=768M
PROPERTY_CATALOG_CONSUMER_CPUS=0.5
PROPERTY_CATALOG_CONSUMER_MEMORY=512M
PROPERTY_CATALOG_SUPERVISOR_CPUS=0.5
PROPERTY_CATALOG_SUPERVISOR_MEMORY=768M

# Installer readiness is fail-closed. Success requires Kafka, topic creation,
# both catalog bootstraps, collector, sequencer, consumer, supervisor, and
# backend to stay ready for the stability window.
INSTALL_READY_TIMEOUT_SECONDS=600
INSTALL_STABILITY_SECONDS=15

# ---- BYO LLM provider keys ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Perplexity (powers Sonar API + Agent API; see https://docs.perplexity.ai)
PERPLEXITY_API_KEY=

# ---- Optional integrations ----
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
RECAPTCHA_SECRET_KEY=

# Public URLs.
# VITE_HOST_API   — backend URL the SPA calls (e.g. https://api.example.com).
#                   Empty falls through to the SaaS hostname map and finally
#                   http://localhost:8000 for local docker-compose.
# FRONTEND_URL    — backend's view of the frontend, used in OAuth callbacks
#                   and email links. Empty defers to the existing app config.
# VITE_HELP_LINK  — destination of the sidebar "Help" entry. Empty falls back
#                   to the community Discord.
VITE_HOST_API=
FRONTEND_URL=
VITE_HELP_LINK=

# reCAPTCHA — both must be set to enable.
RECAPTCHA_ENABLED=false

# Future AGI Cloud (optional, leave blank for fully offline).
FUTURE_AGI_CLOUD_API_KEY=

# Comma-separated list of additional Python modules to allow in the evaluation sandbox
# Example: CODE_EVAL_ADDITIONAL_SAFE_MODULES="numpy,pandas,scipy"
CODE_EVAL_ADDITIONAL_SAFE_MODULES=""
