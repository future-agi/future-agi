# =============================================================================
# Future AGI configuration (.env)
#
# Nothing in this file is required for a local install. ./bin/install copies
# it to .env, generates the secrets in section 1 and starts the Standalone
# setup on http://localhost:3000.
#
# Lines without "#" are values the installer fills in or that you are likely
# to fill in. "# KEY=value" lines are off and show the default or an example:
# remove the "#" to set one. Apply a change with `docker compose up -d`.
#
# Every key, its default, which setup reads it and what breaks when it is
# wrong: docs/configuration.md
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Generated by ./bin/install
# -----------------------------------------------------------------------------
# A fresh install fills every empty value below with a random secret and never
# changes it afterwards. Running `docker compose` without the installer? Set
# each one first (openssl rand -hex 32): left empty, the stack falls back to
# defaults published in this repository.

# Signs logins, tokens and links. Changing it signs everyone out.
SECRET_KEY=
# Postgres password, stored in the database volume on first start. Changing it
# later locks the app out of its data.
PG_PASSWORD=
# Object storage (MinIO) password. The installer replaces the placeholder.
MINIO_ROOT_PASSWORD=CHANGEME-set-by-bin-install
# Shared secret between the app and the LLM gateway.
AGENTCC_INTERNAL_API_KEY=
# Token for the LLM gateway's admin API.
AGENTCC_ADMIN_TOKEN=
# Fernet key that encrypts stored integration credentials. Changing it loses them.
INTEGRATION_ENCRYPTION_KEY=
# Standalone only: password of the app container's Redis (letters, digits, - _ . ~).
REDIS_PASSWORD=

# `./bin/install --distributed` records the Distributed setup here; unset is
# Standalone. An install keeps its setup: moving data between them is not supported.
# COMPOSE_FILE=docker-compose.distributed.yml


# -----------------------------------------------------------------------------
# 2. Recommended
# -----------------------------------------------------------------------------

# LLM provider keys: server-wide keys for built-in evals and other platform LLM
# features. Workspaces can also add their own keys in the UI. One provider is
# enough to start. The bundled gateway config routes OpenAI (AGENTCC_CONFIG_PATH).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini (Google AI Studio).
GOOGLE_API_KEY=
# AWS Bedrock.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Public URLs: set them as soon as anyone opens the UI from anything other than
# http://localhost:3000 (a server IP, a domain, a reverse proxy).
# URL browsers use to reach the API (port 8000).
# VITE_HOST_API=https://api.example.com
# The API's own public URL: SSO callbacks and the MCP and SDK URLs the UI shows.
# BASE_URL=https://api.example.com
# The UI's URL, used in emails, digests and OAuth redirects.
# FRONTEND_URL=https://app.example.com
# The UI's address for invite and password-reset links and app emails: a full
# URL, or a host (the scheme is then guessed). Default: localhost:3000.
# APP_URL=https://app.example.com
# URL browsers download stored files from. Port 9005 listens on 127.0.0.1 only,
# so this needs a reverse proxy (INSTALLATION.md, "Opening the UI from another machine").
# MINIO_URL=https://files.example.com
# URL SDKs on other machines send traces to (their FI_BASE_URL). Port 4318
# listens on 127.0.0.1 only, so this too needs a reverse proxy.
# FI_COLLECTOR_PUBLIC_URL=https://otlp.example.com

# Email through Mailgun. Without it, invites return a link to share yourself and
# an administrator resets passwords on the host:
# `docker compose exec app python manage.py reset_password --email <address>`.
# MAILGUN_API_KEY=
# MAILGUN_SENDER_DOMAIN=mg.example.com
# Sender of every app email. Default: noreply@ on MAILGUN_SENDER_DOMAIN.
# DEFAULT_FROM_EMAIL=noreply@mg.example.com
# Reply-To of app emails. Default: none, so replies go to the sender.
# DEFAULT_REPLY_TO_EMAIL=support@example.com


# -----------------------------------------------------------------------------
# 3. Optional integrations. Each one stays off until you set it.
# -----------------------------------------------------------------------------

# Extra services, comma-separated. `sandbox`: code evals in the nsjail container
# (needs privileged containers). `ml`: embedding model server (a few GB of RAM).
# Distributed: `all` adds per-queue workers, the Temporal UI and the PeerDB UI.
# COMPOSE_PROFILES=sandbox

# Distributed: code evals run only on code-executor. true runs them inside the
# worker when code-executor cannot be reached (platforms without privileged
# containers). Trusted users only: INSTALLATION.md > "Code evals fail with
# Code executor unavailable". Standalone ignores it.
# CODE_EXECUTOR_LOCAL_FALLBACK=false

# Vertex AI: host path of a GCP service-account JSON, mounted read-only.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Enterprise Edition license.
# EE_LICENSE_KEY=

# Agent simulations in hosted sandboxes: daytona or e2b, plus that provider's key.
# Standalone's app image lacks their SDKs (docs/images.md, "Backend variants").
# HOSTED_SANDBOX_PROVIDER=daytona
# DAYTONA_API_KEY=
# E2B_API_KEY=

# Deployment telemetry is ON: a registration (instance id, version, deployment
# type, owner/admin emails and domains) and usage counts every 6 hours, never
# traces, prompts or other content. The app logs what it sends at startup
# (deployment_telemetry_disclosure). Set to true, or install with
# ./bin/install --no-telemetry, to opt out; one minimal ping (instance id,
# version, deployment type, timestamp) remains. Details: docs/telemetry.md.
# FUTURE_AGI_TELEMETRY_DISABLED=true

# Used by Future AGI's hosted service; leave empty when self-hosting. Empty
# means nothing is sent: HubSpot lead sync at signup and login, Slack signup
# notices, Mixpanel and PostHog product analytics, Sentry error reports.
# HUBSPOT_API_TOKEN=
# SLACK_WEBHOOK_CHANNEL=
# MIX_PANEL_TOKEN=
# POSTHOG_API_KEY=
# SENTRY_DSN=

# Hand password-reset links to the browser instead of emailing them. Only where
# everyone who can reach the instance is trusted: anyone could take over any account.
# OSS_RETURN_PASSWORD_RESET_LINK=true


# -----------------------------------------------------------------------------
# 4. Advanced tuning. The values shown are the defaults.
# -----------------------------------------------------------------------------

# Image tag of the Future AGI images: empty = latest, a release (v1.42.0) pins
# it, `local` = built from this checkout by ./bin/install --from-source.
FUTURE_AGI_VERSION=
# Distributed tags its other images separately (empty = latest; the collector
# is built from ./fi-collector unless you set a published tag).
# FRONTEND_VERSION=
# AGENTCC_GATEWAY_VERSION=
# FI_COLLECTOR_VERSION=local
# SERVING_VERSION=
# CODE_EXECUTOR_VERSION=

# Host ports. ./bin/install offers a free port and writes it here on a conflict.
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# AGENTCC_GATEWAY_PORT=8090
# FI_COLLECTOR_OTLP_PORT=4317
# FI_COLLECTOR_OTLP_HTTP_PORT=4318
# MINIO_API_PORT=9005

# Standalone sizing: task slots of the embedded worker (each can hold a Postgres
# connection), API threads and the Redis memory cap.
# FI_APP_TEMPORAL_MAX_CONCURRENT_ACTIVITIES=8
# FI_APP_TEMPORAL_MAX_CONCURRENT_WORKFLOW_TASKS=8
# GRANIAN_THREADS=2
# REDIS_MAXMEMORY=128mb

# LLM gateway provider config, relative to the repo root. Copy the example to
# enable Anthropic, Gemini, Bedrock, Vertex and others.
# AGENTCC_CONFIG_PATH=agentcc-gateway/config.example.yaml

# Database names and users: set them before the first start, never after.
# PG_USER=futureagi
# PG_DB=futureagi
# CH_DATABASE=default
# MINIO_ROOT_USER=futureagi

# How long ./bin/install waits for the stack to become ready, in seconds.
# INSTALL_READY_TIMEOUT_SECONDS=600
# INSTALL_STABILITY_SECONDS=15
# INSTALL_READY_MAX_SECONDS=2400

# Everything else (Distributed worker sizing, Kafka catalog, collector TLS,
# telemetry cadence, hosted runner, dev overlays): docs/configuration.md.


# -----------------------------------------------------------------------------
# 5. Internal: set by the compose files. Values here are ignored.
# -----------------------------------------------------------------------------
# Service addresses and derived URLs (PG_HOST, CH_HOST, REDIS_URL, TEMPORAL_HOST,
# S3_ENDPOINT_URL, S3_ACCESS_KEY, S3_SECRET_KEY, FI_PG_WRITE and the other FI_*
# collector settings, ...) come from the compose files. Change what they are
# derived from instead (PG_PASSWORD, MINIO_ROOT_PASSWORD, REDIS_PASSWORD).
