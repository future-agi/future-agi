# ============================================================================
# Future AGI — OSS model-serving image
# Self-contained public base. No private registry required.
# ============================================================================

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_HTTP_TIMEOUT=300

WORKDIR /app/embedding

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        python3-dev \
        libffi-dev \
        libpq-dev \
        curl \
        git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install uv

# Torch wheel channel. Unset (the default) resolves torch from PyPI, which on
# x86_64 pulls in 13 nvidia-* wheels plus triton — roughly 5 GB of CUDA runtime
# the compose stack cannot reach, since no service in it requests a GPU.
# Point this at the CPU channel to build the CPU-only variant:
#   docker build --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu \
#                -f Dockerfile.oss .
# Left unset the resolve is exactly what this image has always done, so the
# GPU-capable build is unaffected.
ARG TORCH_INDEX_URL=""

COPY pyproject.toml ./

# With a channel pinned the install runs in two steps: torch comes from that
# channel first, and the build it actually resolved to (e.g. 2.6.0+cpu) is fed
# back as a constraint so the project install cannot swap it for the PyPI wheel
# and re-add CUDA. Reading that constraint off the installed wheel instead of
# hardcoding "+cpu" keeps the arg usable for any channel (cu124, rocm6.2, ...).
#
# The first install passes no --extra-index-url on purpose: unlike pip, uv ranks
# extra indexes ABOVE --index-url, so adding PyPI as a fallback there hands torch
# straight back to the CUDA wheel. The channel mirrors every dep torch needs, so
# it wants no fallback. The second install is the reverse case — PyPI stays
# primary and unsafe-best-match is what lets the constrained torch come from the
# extra index while every other pin still resolves from PyPI.
RUN set -eu; \
    if [ -z "$TORCH_INDEX_URL" ]; then \
        uv pip install --system .; \
    else \
        torch_req="$(sed -n 's/^[[:space:]]*"\(torch==[^"]*\)".*/\1/p' pyproject.toml)"; \
        [ -n "$torch_req" ] || { echo "no pinned torch requirement in pyproject.toml" >&2; exit 1; }; \
        uv pip install --system --index-url "$TORCH_INDEX_URL" "$torch_req"; \
        uv pip freeze --system | grep '^torch==' > /tmp/torch-constraints.txt; \
        cat /tmp/torch-constraints.txt; \
        uv pip install --system \
            --constraint /tmp/torch-constraints.txt \
            --extra-index-url "$TORCH_INDEX_URL" \
            --index-strategy unsafe-best-match \
            .; \
    fi

COPY . .
RUN chmod +x entrypoint.sh

EXPOSE 8000 8080

ENTRYPOINT ["./entrypoint.sh"]
