ARG BASE_IMAGE=th7247-current-select:0817h-f71eaa3e
FROM ${BASE_IMAGE}

# DEV-only one-shot operator overlay.  Runtime source and target credentials are
# supplied by the reviewed compose deployment; this image contains no secrets.
COPY tracer/services/clickhouse/v2/property_catalog/projection.py /app/backend/tracer/services/clickhouse/v2/property_catalog/projection.py
COPY tracer/services/clickhouse/v2/property_catalog/dev_rollout.py /app/backend/tracer/services/clickhouse/v2/property_catalog/dev_rollout.py
COPY tracer/services/clickhouse/v2/property_catalog/dev_runtime.py /app/backend/tracer/services/clickhouse/v2/property_catalog/dev_runtime.py
COPY tracer/services/clickhouse/v2/property_catalog/durable_lifecycle.py /app/backend/tracer/services/clickhouse/v2/property_catalog/durable_lifecycle.py
COPY tracer/services/clickhouse/v2/property_catalog/reconciler.py /app/backend/tracer/services/clickhouse/v2/property_catalog/reconciler.py
COPY tracer/services/clickhouse/v2/property_catalog/postgres_executor.py /app/backend/tracer/services/clickhouse/v2/property_catalog/postgres_executor.py
COPY tracer/services/clickhouse/v2/property_catalog/source_adapters.py /app/backend/tracer/services/clickhouse/v2/property_catalog/source_adapters.py
COPY tracer/services/clickhouse/v2/property_catalog/span_source.py /app/backend/tracer/services/clickhouse/v2/property_catalog/span_source.py
COPY tracer/services/clickhouse/v2/property_catalog/state_store.py /app/backend/tracer/services/clickhouse/v2/property_catalog/state_store.py
COPY tracer/management/commands/ch25_property_catalog_dev_rollout.py /app/backend/tracer/management/commands/ch25_property_catalog_dev_rollout.py
