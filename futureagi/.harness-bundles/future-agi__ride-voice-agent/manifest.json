{
  "schema_version": "futureagi.environment-bundle.v2",
  "name": "ride-voice-agent",
  "runtime": {
    "kind": "process",
    "control_service": "agent",
    "evidence_seam": "http_tool"
  },
  "processes": [
    {
      "name": "postgres",
      "kind": "managed",
      "engine": "postgres",
      "version": "16",
      "user": "svc-data",
      "depends_on": []
    },
    {
      "name": "tools-api",
      "kind": "source",
      "working_directory": "tools-api",
      "build_commands": [
        [
          "python3",
          "-m",
          "venv",
          ".venv"
        ],
        [
          ".venv/bin/pip",
          "install",
          "-r",
          "requirements.txt"
        ]
      ],
      "run_command": [
        "sh",
        "-c",
        "exec .venv/bin/uvicorn main:app --host 0.0.0.0 --port \"$PORT\""
      ],
      "environment": {
        "DATABASE_URL": "{{DATABASE_URL}}",
        "PORT": "{{PORT_tools-api}}"
      },
      "secret_purposes": [],
      "user": "svc-tools",
      "depends_on": [
        "postgres"
      ]
    },
    {
      "name": "agent",
      "kind": "source",
      "working_directory": ".",
      "build_commands": [
        [
          "python3",
          "-m",
          "venv",
          ".venv"
        ],
        [
          ".venv/bin/pip",
          "install",
          "."
        ],
        [
          ".venv/bin/python",
          "-m",
          "livekit.agents",
          "download-files"
        ]
      ],
      "run_command": [
        ".venv/bin/python",
        "agent/agent.py",
        "start"
      ],
      "environment": {
        "TOOLS_API_URL": "{{TOOLS_API_URL}}",
        "LIVEKIT_AGENT_NAME": "agent-w{{WORLD_INDEX}}",
        "HARNESS_MODE": "1",
        "MAX_FARE_WITHOUT_OTP": "100",
        "DEMO_CALLER_ANI": "+14155550101",
        "TOOLS_TIMEOUT_SECONDS": "5",
        "AGENT_STT_MODEL": "flux-general-en",
        "AGENT_STT_MODEL_PHONE": "nova-2-phonecall",
        "AGENT_LLM_MODEL": "gemini-2.5-flash-lite",
        "AGENT_LLM_TEMPERATURE": "0.2",
        "AGENT_TTS_MODEL": "aura-2-andromeda-en"
      },
      "secret_purposes": [
        "target_provider"
      ],
      "user": "svc-agent",
      "depends_on": [
        "postgres",
        "tools-api"
      ]
    }
  ],
  "capabilities": {
    "database": {
      "protocol": "postgres",
      "service": "postgres",
      "configuration_name": "DATABASE_URL"
    },
    "tools_api": {
      "protocol": "http",
      "service": "tools-api",
      "configuration_name": "TOOLS_API_URL"
    }
  },
  "readiness": [
    {
      "capability": "tools_api",
      "path": "/health",
      "timeout_seconds": 30,
      "interval_seconds": 0.5
    }
  ],
  "provenance": {
    "source_kind": "repository",
    "repository": "future-agi/ride-voice-agent",
    "commit": "8693748561d8840d0aa17295691e29d10d1b1a15",
