{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OmegaHubBucketConfigRead",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetLifecycleConfiguration"
      ],
      "Resource": ["arn:aws:s3:::omega-hub"]
    },
    {
      "Sid": "OmegaHubObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObjectRetention",
        "s3:PutObjectRetention"
      ],
      "Resource": ["arn:aws:s3:::omega-hub/*"]
    }
  ]
}
