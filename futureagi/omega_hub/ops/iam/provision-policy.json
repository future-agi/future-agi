{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OmegaHubBucketProvision",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketVersioning",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": ["arn:aws:s3:::omega-hub"]
    }
  ]
}
