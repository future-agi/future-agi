{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:futureagi:omega-deploy-run-event:v1:notice",
  "title": "Omega deployment run notice, v1",
  "type": "object",
  "required": ["protocol", "notice_id", "event", "run", "usage"],
  "properties": {
    "protocol": {"const": "omega-deploy-run-event/v1"},
    "notice_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "event": {"enum": ["run.completed", "run.failed"]},
    "run": {"$ref": "#/$defs/run"},
    "usage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/usage"}]}
  },
  "not": {"anyOf": [
    {"required": ["deployment"]}, {"required": ["organization_id"]}, {"required": ["workspace_id"]},
    {"required": ["project_id"]}, {"required": ["relay"]}
  ]},
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullableId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "run": {
      "type": "object",
      "required": ["id", "thread_id", "assistant_id", "workflow_id", "revision", "environment", "status", "attempt",
                   "trigger", "created_at", "started_at", "ended_at", "supersteps", "error", "trace_id", "webhook",
                   "webhook_context"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "thread_id": {"$ref": "#/$defs/nullableId"},
        "assistant_id": {"$ref": "#/$defs/nullableId"},
        "workflow_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,200}$"},
        "revision": {"type": "integer", "minimum": 1},
        "environment": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        "status": {"enum": ["succeeded", "failed", "cancelled", "interrupted"]},
        "attempt": {"type": "integer", "minimum": 1},
        "trigger": {
          "type": "object",
          "required": ["kind", "cron_id"],
          "properties": {
            "kind": {"type": "string", "pattern": "^[a-z_]{1,32}$"},
            "cron_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
          },
          "additionalProperties": true
        },
        "created_at": {"$ref": "#/$defs/ts"},
        "started_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ts"}]},
        "ended_at": {"$ref": "#/$defs/ts"},
        "supersteps": {"type": "integer", "minimum": 0},
        "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]},
        "trace_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^(?!0{32})[0-9a-f]{32}$"}]},
        "webhook": {"oneOf": [
          {"type": "null"},
          {"type": "string", "pattern": "^whep_[0-9A-HJKMNP-TV-Z]{26}$"},
          {"type": "string", "maxLength": 2048, "pattern": "^https://[^\\s@#]+$"}
        ]},
        "webhook_context": {"oneOf": [
          {"type": "null"},
          {"type": "object", "maxProperties": 16,
           "propertyNames": {"pattern": "^[A-Za-z0-9_.-]{1,64}$"},
           "additionalProperties": {"oneOf": [
             {"type": "string", "maxLength": 256}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}
           ]}}
        ]}
      },
      "not": {"anyOf": [
        {"required": ["deployment_id"]}, {"required": ["organization_id"]}, {"required": ["workspace_id"]},
        {"required": ["project_id"]}
      ]},
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["type", "code"],
      "properties": {
        "type": {"type": "string", "pattern": "^[A-Za-z0-9_.]{1,128}$"},
        "code": {"type": "string", "pattern": "^[a-z_]{1,32}$"},
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "host": {"type": "string", "maxLength": 253,
                 "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens", "model_calls"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  }
}
