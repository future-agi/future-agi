{
  "schema": "futureagi.actor_rules.v1",
  "evaluator_only": {
    "scenario_fields": [
      "solution",
      "alternatives",
      "sub_goals",
      "tests",
      "setup_code",
      "ready_code",
      "coverage"
    ],
    "files": [
      "sub_goals.json",
      "certification.json",
      "runtime-validation.json"
    ]
  },
  "brief_inputs": [
    [
      "actor",
      "name"
    ],
    [
      "actor",
      "role"
    ],
    [
      "actor",
      "persona"
    ],
    [
      "actor",
      "goal"
    ],
    [
      "actor",
      "constraints"
    ],
    [
      "actor",
      "behaviour"
    ],
    [
      "actor",
      "prompt"
    ],
    [
      "actor",
      "surface"
    ],
    [
      "actor",
      "knowledge"
    ],
    [
      "scenario",
      "instruction"
    ],
    [
      "scenario",
      "knowledge"
    ],
    [
      "caller",
      "situation"
    ]
  ],
  "private_to_actor": [
    "goal",
    "prompt",
    "instruction",
    "actions"
  ],
  "situation_before": "Your details:",
  "reserved_ids": [
    "agent"
  ],
  "references": {
    "parent": [],
    "on_behalf_of": [],
    "activation.fallback": [
      "silent",
      "decline"
    ]
  },
  "acyclic": [
    "parent"
  ],
  "world_actions": {
    "from": "tool_entrypoints",
    "route": "endpoint",
    "tool": "tool",
    "separator": "."
  },
  "channels": {
    "audio_mix": "a voice near the person that speaks up whenever it has something to say, which the agent may hear",
    "audio_handoff": "someone who takes the phone from the person for a few turns, then hands it back",
    "ivr": "a phone menu on the person's own line that answers a call the agent places, before the person, and puts the call through to them"
  },
  "formats": {
    "actors.json": "futureagi.actors.v1"
  },
  "records": {
    "actors.json": {
      "$defs": {
        "Activation": {
          "additionalProperties": false,
          "description": "When an actor comes in by default, how long it waits, and what happens when it does not answer.",
          "properties": {
            "trigger": {
              "$ref": "#/$defs/Trigger"
            },
            "timeout_seconds": {
              "default": 0.0,
              "minimum": 0,
              "title": "Timeout Seconds",
              "type": "number"
            },
            "fallback": {
              "default": "silent",
              "title": "Fallback",
              "type": "string"
            }
          },
          "title": "Activation",
          "type": "object"
        },
        "Behaviour": {
          "additionalProperties": false,
          "properties": {
            "style": {
              "default": "",
              "title": "Style",
              "type": "string"
            },
            "response_timing": {
              "$ref": "#/$defs/ResponseTiming"
            }
          },
          "title": "Behaviour",
          "type": "object"
        },
        "Constraints": {
          "additionalProperties": false,
          "description": "What an actor may agree to, must keep to itself, hands over on, and is done at.",
          "properties": {
            "may_agree": {
              "items": {
                "type": "string"
              },
              "title": "May Agree",
              "type": "array"
            },
            "private": {
              "items": {
                "type": "string"
              },
              "title": "Private",
              "type": "array"
            },
            "escalate_when": {
              "items": {
                "type": "string"
              },
              "title": "Escalate When",
              "type": "array"
            },
            "stop_when": {
              "items": {
                "type": "string"
              },
              "title": "Stop When",
              "type": "array"
            }
          },
          "title": "Constraints",
          "type": "object"
        },
        "ResponseTiming": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "default": "immediate",
              "enum": [
                "immediate",
                "delayed"
              ],
              "title": "Kind",
              "type": "string"
            },
            "seconds": {
              "default": 0.0,
              "minimum": 0,
              "title": "Seconds",
              "type": "number"
            }
          },
          "title": "ResponseTiming",
          "type": "object"
        },
        "Trigger": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "default": "always",
              "enum": [
                "always",
                "after_seconds",
                "on_tool",
                "contacted",
                "probability"
              ],
              "title": "Kind",
              "type": "string"
            },
            "seconds": {
              "default": 0.0,
              "minimum": 0,
              "title": "Seconds",
              "type": "number"
            },
            "tool": {
              "default": "",
              "title": "Tool",
              "type": "string"
            },
            "on_call": {
              "default": 1,
              "minimum": 1,
              "title": "On Call",
              "type": "integer"
            },
            "p": {
              "default": 1.0,
              "maximum": 1,
              "minimum": 0,
              "title": "P",
              "type": "number"
            }
          },
          "title": "Trigger",
          "type": "object"
        }
      },
      "properties": {
        "id": {
          "description": "1 to 64 lowercase letters, digits or underscores",
          "pattern": "^[a-z0-9_]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "default": "person",
          "title": "Kind",
          "type": "string"
        },
        "side": {
          "default": "world",
          "enum": [
            "caller",
            "world"
          ],
          "title": "Side",
          "type": "string"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "persona": {
          "additionalProperties": true,
          "title": "Persona",
          "type": "object"
        },
        "goal": {
          "default": "",
          "title": "Goal",
          "type": "string"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "behaviour": {
          "$ref": "#/$defs/Behaviour"
        },
        "knowledge": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Knowledge",
          "type": "array"
        },
        "prompt": {
          "default": "",
          "title": "Prompt",
          "type": "string"
        },
        "surface": {
          "default": "world.records",
          "title": "Surface",
          "type": "string"
        },
        "play": {
          "default": "scheduled",
          "title": "Play",
          "type": "string"
        },
        "permitted_actions": {
          "items": {
            "type": "string"
          },
          "title": "Permitted Actions",
          "type": "array"
        },
        "identities": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Identities",
          "type": "object"
        },
        "on_behalf_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Behalf Of"
        },
        "activation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Activation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "loudness_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loudness Ratio"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        },
        "card": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Card"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Actor",
      "type": "object"
    },
    "sub_actors.json": {
      "description": "One entry of the environment's list.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        },
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "persona": {
          "additionalProperties": true,
          "title": "Persona",
          "type": "object"
        },
        "loudness_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loudness Ratio"
        }
      },
      "required": [
        "id",
        "name",
        "channel"
      ],
      "title": "SubActor",
      "type": "object"
    }
  }
}
