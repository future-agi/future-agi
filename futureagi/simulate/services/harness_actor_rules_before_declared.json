{
  "schema": "futureagi.actor_rules.v1",
  "evaluator_only": {
    "scenario_fields": [
      "solution",
      "alternatives",
      "sub_goals",
      "tests",
      "setup_code",
      "ready_code",
      "coverage",
      "faults"
    ],
    "files": ["sub_goals.json", "certification.json", "runtime-validation.json"]
  },
  "brief_inputs": [
    ["actor", "name"],
    ["actor", "role"],
    ["actor", "persona"],
    ["actor", "goal"],
    ["actor", "constraints"],
    ["actor", "behaviour"],
    ["actor", "prompt"],
    ["actor", "surface"],
    ["actor", "knowledge"],
    ["scenario", "instruction"],
    ["scenario", "knowledge"],
    ["caller", "situation"]
  ],
  "private_to_actor": ["goal", "prompt", "instruction", "actions"],
  "not_knowledge": {
    "files": [
      "contract.json",
      "manifest.json",
      "actors.json",
      "actor_rules.json",
      "credentials.json",
      "world.py",
      "world.sqlite",
      "simulator_prompt.md",
      "source-data-invariants.json",
      "scenarios.json"
    ],
    "prefixes": [
      "generic-harness/",
      "handlers/",
      "seed/",
      "scenarios/",
      "checks/",
      "."
    ]
  },
  "situation_before": "Your details:",
  "reserved_ids": ["agent"],
  "references": {
    "parent": [],
    "on_behalf_of": [],
    "activation.fallback": ["silent", "decline"]
  },
  "acyclic": ["parent"],
  "world_actions": {
    "from": "tool_entrypoints",
    "route": "endpoint",
    "tool": "tool",
    "separator": ".",
    "method": "method",
    "methods": ["POST"],
    "placeholder": "{"
  },
  "loudness": {
    "channels": ["audio_mix"],
    "automatic": [0.333, 0.667]
  },
  "distinct_from_caller": ["name"],
  "channels": {
    "audio_mix": "a voice near the person that speaks up whenever it has something to say, which the agent may hear",
    "audio_handoff": "someone who takes the phone from the person for a few turns to say something of their own, then hands it back; the person's request stays the person's, so they never carry it on, confirm it or finish it",
    "ivr": "a phone menu on the person's own line that answers a call the agent places, before the person, and puts the call through to them",
    "chat_message": "someone else in the person's conversation with the agent who writes messages of their own, labelled with their name, which the agent reads"
  },
  "channel_modalities": {
    "audio_mix": ["voice"],
    "audio_handoff": ["voice"],
    "ivr": ["voice"],
    "chat_message": ["chat"]
  },
  "equal_when_set": {
    "persona.name": "name"
  },
  "formats": {
    "actors.json": "futureagi.actors.v1"
  },
  "records": {
    "actors.json": {
      "$defs": {
        "Activation": {
          "additionalProperties": false,
          "description": "When an actor comes in by default, how long it waits, and what happens when it does not answer.",
          "properties": {
            "trigger": {
              "$ref": "#/$defs/Trigger"
            },
            "timeout_seconds": {
              "default": 0.0,
              "minimum": 0,
              "title": "Timeout Seconds",
              "type": "number"
            },
            "fallback": {
              "default": "silent",
              "title": "Fallback",
              "type": "string"
            }
          },
          "title": "Activation",
          "type": "object"
        },
        "Behaviour": {
          "additionalProperties": false,
          "properties": {
            "style": {
              "default": "",
              "title": "Style",
              "type": "string"
            },
            "response_timing": {
              "$ref": "#/$defs/ResponseTiming"
            }
          },
          "title": "Behaviour",
          "type": "object"
        },
        "Constraints": {
          "additionalProperties": false,
          "description": "What an actor may agree to, must keep to itself, hands over on, and is done at.",
          "properties": {
            "may_agree": {
              "items": {
                "type": "string"
              },
              "title": "May Agree",
              "type": "array"
            },
            "private": {
              "items": {
                "type": "string"
              },
              "title": "Private",
              "type": "array"
            },
            "escalate_when": {
              "items": {
                "type": "string"
              },
              "title": "Escalate When",
              "type": "array"
            },
            "stop_when": {
              "items": {
                "type": "string"
              },
              "title": "Stop When",
              "type": "array"
            }
          },
          "title": "Constraints",
          "type": "object"
        },
        "ResponseTiming": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "default": "immediate",
              "enum": ["immediate", "delayed"],
              "title": "Kind",
              "type": "string"
            },
            "seconds": {
              "default": 0.0,
              "minimum": 0,
              "title": "Seconds",
              "type": "number"
            }
          },
          "title": "ResponseTiming",
          "type": "object"
        },
        "Trigger": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "default": "always",
              "enum": [
                "always",
                "after_seconds",
                "on_tool",
                "contacted",
                "probability",
                "mid_journey",
                "on_keyword"
              ],
              "title": "Kind",
              "type": "string"
            },
            "seconds": {
              "default": 0.0,
              "minimum": 0,
              "title": "Seconds",
              "type": "number"
            },
            "tool": {
              "default": "",
              "title": "Tool",
              "type": "string"
            },
            "on_call": {
              "default": 1,
              "minimum": 1,
              "title": "On Call",
              "type": "integer"
            },
            "p": {
              "default": 1.0,
              "maximum": 1,
              "minimum": 0,
              "title": "P",
              "type": "number"
            },
            "turn": {
              "default": 0,
              "minimum": 0,
              "title": "Turn",
              "type": "integer"
            },
            "words": {
              "items": {
                "type": "string"
              },
              "title": "Words",
              "type": "array"
            }
          },
          "title": "Trigger",
          "type": "object"
        }
      },
      "properties": {
        "id": {
          "description": "1 to 64 lowercase letters, digits or underscores",
          "pattern": "^[a-z0-9_]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "default": "person",
          "title": "Kind",
          "type": "string"
        },
        "side": {
          "default": "world",
          "enum": ["caller", "world"],
          "title": "Side",
          "type": "string",
          "description": "Whose side the actor is on, for reading the cast; it changes no rule"
        },
        "role": {
          "default": "",
          "maxLength": 160,
          "title": "Role",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "persona": {
          "description": "The simulated caller, in the same shape used by existing voice scenarios.\n\nA persona controls how the caller pursues a scenario's task. The task itself remains on\n``Scenario.instruction`` so the harness can vary either one without conflating them.",
          "properties": {
            "name": {
              "default": "",
              "title": "Name",
              "type": "string"
            },
            "gender": {
              "default": "",
              "title": "Gender",
              "type": "string"
            },
            "age_group": {
              "default": "",
              "title": "Age Group",
              "type": "string"
            },
            "occupation": {
              "default": "",
              "title": "Occupation",
              "type": "string"
            },
            "location": {
              "default": "",
              "title": "Location",
              "type": "string"
            },
            "personality": {
              "default": "",
              "title": "Personality",
              "type": "string"
            },
            "communication_style": {
              "default": "",
              "title": "Communication Style",
              "type": "string"
            },
            "initial_message": {
              "default": "",
              "title": "Initial Message",
              "type": "string"
            },
            "languages": {
              "items": {
                "type": "string"
              },
              "title": "Languages",
              "type": "array"
            },
            "accent": {
              "default": "",
              "title": "Accent",
              "type": "string"
            },
            "multilingual": {
              "default": false,
              "title": "Multilingual",
              "type": "boolean"
            },
            "metadata": {
              "additionalProperties": true,
              "title": "Metadata",
              "type": "object"
            },
            "scripted_caller": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Scripted Caller"
            }
          },
          "title": "Persona",
          "type": "object",
          "additionalProperties": true
        },
        "goal": {
          "default": "",
          "title": "Goal",
          "type": "string"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "behaviour": {
          "$ref": "#/$defs/Behaviour"
        },
        "knowledge": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Knowledge",
          "type": "array"
        },
        "prompt": {
          "default": "",
          "title": "Prompt",
          "type": "string"
        },
        "surface": {
          "default": "world.records",
          "title": "Surface",
          "type": "string",
          "description": "Where the actor acts in the world; never how it speaks (that is `channel`)"
        },
        "permitted_actions": {
          "items": {
            "type": "string"
          },
          "title": "Permitted Actions",
          "type": "array"
        },
        "identities": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Identities",
          "type": "object"
        },
        "on_behalf_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Behalf Of"
        },
        "activation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Activation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "play": {
          "default": "mocked",
          "enum": ["mocked", "live", "both"],
          "title": "Play",
          "type": "string",
          "description": "mocked: only the actions each scenario gives it; live: decides its own actions from what it sees when reached; both"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["audio_handoff", "audio_mix", "chat_message", "ivr"]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the actor speaks in the conversation, if it does; empty: it never speaks there"
        },
        "loudness_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loudness Ratio"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": ["id", "name"],
      "title": "Actor",
      "type": "object",
      "if": {
        "properties": {
          "channel": {
            "type": "string"
          }
        },
        "required": ["channel"]
      },
      "then": {
        "properties": {
          "role": {
            "minLength": 1
          }
        },
        "required": ["role"]
      }
    }
  }
}
