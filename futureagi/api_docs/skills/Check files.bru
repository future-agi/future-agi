meta {
  name: Check files
  type: http
  seq: 4
}

post {
  url: {{backend_url}}/model-hub/skills/checks/
  body: json
  auth: none
}

headers {
  X-Api-Key: {{api_key}}
  X-Secret-Key: {{secret_key}}
  X-Workspace-Id: {{workspace_id}}
}

body:json {
  {"files":[{"path":"SKILL.md","content":"---\nname: help-desk\ndescription: Use when a support request needs a clear and verifiable next step.\n---\n\nRead the request and explain the next safe step.\n"}],"name":"help-desk"}
}
