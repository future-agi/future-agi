body:json {
  {"files":[{"path":"SKILL.md","content":"---\nname: help-desk\ndescription: Use when a support request needs a clear and verifiable next step.\n---\n\nRead the request and explain the next safe step.\n"}],"base_version":{{base_version}},"labels":[],"acknowledge_warnings":false}
}
