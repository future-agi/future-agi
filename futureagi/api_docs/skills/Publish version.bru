meta {
  name: Publish version
  type: http
  seq: 12
}

post {
  url: {{backend_url}}/model-hub/skills/{{skill_id}}/versions/
  body: json
  auth: none
}

headers {
  X-Api-Key: {{api_key}}
  X-Secret-Key: {{secret_key}}
