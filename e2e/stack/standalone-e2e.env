# Isolated Standalone E2E stack: project futureagi-e2e-standalone, same host
# ports as the Distributed futureagi-e2e stack (e2e/stack/e2e.env), so the
# harness defaults in e2e/lib/env.ts need no overrides. Run only one of the two
# stacks at a time.
#
# Images: build them from this checkout as `./bin/install --from-source` does
# (slim backend, frontend, fi-collector, agentcc-gateway, then
# deploy/standalone/Dockerfile) and tag them with FUTURE_AGI_VERSION below.
FUTURE_AGI_VERSION=e2esa

FRONTEND_PORT=3100
BACKEND_PORT=8100
FI_COLLECTOR_OTLP_PORT=24317
FI_COLLECTOR_OTLP_HTTP_PORT=24318
AGENTCC_GATEWAY_PORT=28090
MINIO_API_PORT=29005
PG_PORT=25432
CH_HTTP_PORT=28123
CH_PORT=29000
# As in e2e/stack/e2e.env, and after a fresh ./bin/install.
CH_PASSWORD=e2e-clickhouse-password

# The SPA calls the API on the harness port.
VITE_HOST_API=http://localhost:8100

# Never report to Future AGI from a test stack.
FUTURE_AGI_TELEMETRY_DISABLED=true

# LLM traffic: the in-container gateway reads this file, which routes every
# model to mock-llm. The key is a dummy that some UI surfaces require to be
# non-empty; it is never sent anywhere real.
AGENTCC_CONFIG_PATH=e2e/stack/gateway.e2e.yaml
OPENAI_API_KEY=e2e-mock
# Request logs reach Django over this shared secret (same as e2e/stack/docker-compose.e2e.yml).
AGENTCC_WEBHOOK_SECRET=e2e-agentcc-webhook-secret
# Embedding "model serving" (the ml profile's role) is the mock too, as in the
# Distributed E2E overlay.
MODEL_SERVING_URL=http://mock-llm:8080
