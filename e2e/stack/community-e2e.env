# The Community edition lane: `E2E_STACK=community bin/e2e up|test|licence|down`.
# Its own Compose project (futureagi-e2e-community), so its own database,
# ClickHouse and app volumes, on its own host ports: it runs next to the
# futureagi-e2e stacks and never touches their data. The lane exists for flows
# that need a fresh install's single organization (Community allows 1
# organization, 1 workspace and 3 members), which the shared stacks cannot
# give them. e2e/stack/docker-compose.community-e2e.yml binds every port to
# 127.0.0.1.
#
# Images: the Standalone images `bin/e2e build standalone` builds from this
# checkout (same tag as e2e/stack/standalone-e2e.env).
FUTURE_AGI_VERSION=e2esa

FRONTEND_PORT=3300
BACKEND_PORT=8300
FI_COLLECTOR_OTLP_PORT=34317
FI_COLLECTOR_OTLP_HTTP_PORT=34318
AGENTCC_GATEWAY_PORT=38090
MINIO_API_PORT=39005
PG_PORT=35432
CH_HTTP_PORT=38123
CH_PORT=39000
# As in the other E2E env files.
CH_PASSWORD=e2e-clickhouse-password

# The SPA calls the API on the lane's port.
VITE_HOST_API=http://localhost:8300

# Never report to Future AGI from a test stack.
FUTURE_AGI_TELEMETRY_DISABLED=true

# LLM traffic goes to the deterministic mock, as in standalone-e2e.env.
AGENTCC_CONFIG_PATH=e2e/stack/gateway.e2e.yaml
OPENAI_API_KEY=e2e-mock
AGENTCC_WEBHOOK_SECRET=e2e-agentcc-webhook-secret
MODEL_SERVING_URL=http://mock-llm:8080
