# Isolated E2E stack: futureagi-e2e project, 3100/8100/2xxxx ports.
# Collides with neither the default dev stack nor futureagi-test (1xxxx).
FRONTEND_PORT=3100
BACKEND_PORT=8100
AGENTCC_GATEWAY_PORT=28090
SERVING_PORT=28080
CODE_EXECUTOR_PORT=28060
# Reuse the dedicated-executor harness: never execute evaluator code in a worker.
CODE_EXECUTOR_LOCAL_FALLBACK=false
# Only the owned canary is admitted. private.example is intentionally listed so
# the flow proves an operator admission cannot override the public-IP requirement.
LINK_EVAL_ALLOWED_HOSTS=allowed.example,worker-allowed.example,private.example
PG_PORT=25432
CH_HTTP_PORT=28123
CH_PORT=29000
# ClickHouse's default user has a password, as after a fresh ./bin/install:
# PeerDB's ch_dest peer, the collector and the bootstrap jobs log in with it.
# e2e/lib/env.ts sends the same one (E2E_CH_PASSWORD).
CH_PASSWORD=e2e-clickhouse-password
REDIS_PORT=26379
MINIO_API_PORT=29005
MINIO_CONSOLE_PORT=29006
TEMPORAL_PORT=27233
FI_COLLECTOR_OTLP_PORT=24317
FI_COLLECTOR_OTLP_HTTP_PORT=24318
FI_COLLECTOR_ADMIN_PORT=29464
PROPERTY_CATALOG_KAFKA_PORT=29093
# peerdb-server binds host 9900 by default — collides with a dev peerdb stack
PEERDB_PORT=29900
# not started by bin/e2e up, but `bin/e2e compose up peerdb-ui` shouldn't collide either
PEERDB_UI_PORT=23001

# Prebuilt frontend image reads the API base at runtime (docker-entrypoint.sh
# renders window.__FUTURE_AGI_CONFIG__).
VITE_HOST_API=http://localhost:8100

# Shared backend env also covers migration jobs and every worker/scheduler.
# Opt-out still permits a minimal registration ping; keep it on loopback too.
FUTURE_AGI_TELEMETRY_DISABLED=true
FUTURE_AGI_TELEMETRY_URL=http://127.0.0.1:9

# Some UI surfaces treat an empty provider key as "unconfigured"; the value is
# never sent anywhere real — the gateway config below points at mock-llm.
OPENAI_API_KEY=e2e-mock
# Request logs reach Django over this shared secret (same as e2e/stack/docker-compose.e2e.yml).
AGENTCC_WEBHOOK_SECRET=e2e-agentcc-webhook-secret
# docker-compose.distributed.yml mounts ./${AGENTCC_CONFIG_PATH}, so this is repo-root-relative.
AGENTCC_CONFIG_PATH=e2e/stack/gateway.e2e.yaml

# CDC is a load-bearing read path: eval results, annotation scores, dataset/
# simulation dashboards reach ClickHouse via the native PeerDB mirrors. Core
# CDC services are now part of the default startup graph; no profile is needed.
